<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=1800&q=80" 
           alt="Kashmir Gallery" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-4 py-1.5 rounded-full inline-block mb-3">
        VISUAL SPLENDOR
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-4">
        Glimpses of Paradise
      </h1>
      <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        A photographic journey through Kashmir’s shimmering lakes, snow-kissed peaks, and verdant meadows.
      </p>
    </div>
  </section>

  <!-- Photo Gallery Grid -->
  <section class="py-16 bg-brand-offwhite">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=800&q=80" alt="Dal Lake Shikara" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=800&q=80" alt="Gulmarg Snow" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1566837945700-30057527ade0?auto=format&fit=crop&w=800&q=80" alt="Houseboat Dal Lake" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1614741118887-7a4ee193a5fa?auto=format&fit=crop&w=800&q=80" alt="Pahalgam Betaab Valley" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1589182373726-e4f658ab50f0?auto=format&fit=crop&w=800&q=80" alt="Sonamarg Glaciers" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=800&q=80" alt="Doodhpathri Meadows" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80" alt="Gurez Valley Mountains" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1605649487212-47bdab064df8?auto=format&fit=crop&w=800&q=80" alt="Kashmir Snow Trees" class="w-full h-full object-cover">
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md card-hover h-72">
          <img src="https://images.unsplash.com/photo-1627894483216-2138af692e32?auto=format&fit=crop&w=800&q=80" alt="Old Srinagar City" class="w-full h-full object-cover">
        </div>

      </div>

      <div class="mt-16 text-center">
        <a href="/packages" class="btn-primary px-8 py-3.5 rounded-xl font-semibold text-sm inline-flex items-center space-x-2">
          <span>Explore Tour Packages</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>

