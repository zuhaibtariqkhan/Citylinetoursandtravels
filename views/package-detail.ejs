<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Breadcrumbs -->
  <div class="bg-brand-offwhite border-b border-brand-border py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-brand-muted flex items-center space-x-2">
      <a href="/" class="hover:text-brand-blue">Home</a>
      <span>/</span>
      <a href="/packages" class="hover:text-brand-blue">Tour Packages</a>
      <span>/</span>
      <span class="text-brand-navy font-semibold truncate"><%= pkg.title %></span>
    </div>
  </div>

  <!-- Package Hero & Main Visual -->
  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Package Header Title & Meta -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center space-x-2 mb-2">
            <span class="bg-brand-light text-brand-blue text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
              <%= pkg.category %> Special
            </span>
            <span class="text-xs text-brand-muted flex items-center">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-blue mr-1"></i>
              <%= (pkg.destinationCoverage || []).join(' • ') %>
            </span>
          </div>
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-[45px] font-bold text-brand-navy tracking-tight">
            <%= pkg.title %>
          </h1>
        </div>

        <!-- Pricing Summary Box on Desktop with PDF Download -->
        <div class="bg-brand-offwhite border border-brand-border p-4 rounded-2xl flex flex-wrap items-center gap-4 sm:gap-6">
          <div>
            <span class="text-[11px] text-brand-muted uppercase block">
              <%= pkg.pricingModel === 'winter_wonderland' ? 'Total Package Price (5 Persons)' : 'Starting Price' %>
            </span>
            <div class="font-serif text-2xl font-bold text-brand-blue">
              <%= pkg.startingPriceFormatted %>
            </div>
            <% if (pkg.price) { %>
              <span class="text-[11px] text-brand-muted">/<%= pkg.pricingType || 'person' %></span>
            <% } %>
          </div>
          <div class="border-l border-slate-200 pl-4 sm:pl-6">
            <span class="text-[11px] text-brand-muted uppercase block">Duration</span>
            <div class="font-bold text-sm text-brand-navy flex items-center space-x-1 mt-1">
              <i data-lucide="calendar" class="w-4 h-4 text-brand-blue"></i>
              <span><%= pkg.duration %></span>
            </div>
          </div>
          <div class="border-l border-slate-200 pl-4 sm:pl-6">
            <a href="/packages/<%= pkg.slug %>/print?autoprint=1" target="_blank" 
               class="inline-flex items-center space-x-1.5 bg-white border border-brand-border hover:border-brand-blue hover:text-brand-blue text-brand-navy text-xs font-semibold px-3.5 py-2 rounded-xl transition shadow-sm">
              <i data-lucide="file-down" class="w-4 h-4 text-brand-blue"></i>
              <span>Download PDF Itinerary</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Main Image & Mini Gallery Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 rounded-2xl overflow-hidden mb-12 shadow-md">
        <div class="lg:col-span-2 h-[380px] sm:h-[460px]">
          <img src="<%= pkg.featuredImage %>" alt="<%= pkg.title %>" class="w-full h-full object-cover">
        </div>
        <div class="hidden lg:grid grid-rows-2 gap-4 h-[460px]">
          <% if (pkg.galleryImages && pkg.galleryImages.length > 0) { %>
            <% pkg.galleryImages.slice(0, 2).forEach(img => { %>
              <div class="h-full overflow-hidden">
                <img src="<%= img %>" alt="Kashmir Landscape" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
              </div>
            <% }) %>
          <% } else { %>
            <div class="h-full overflow-hidden">
              <img src="https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=800&q=80" alt="Dal Lake" class="w-full h-full object-cover">
            </div>
            <div class="h-full overflow-hidden">
              <img src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=800&q=80" alt="Gulmarg" class="w-full h-full object-cover">
            </div>
          <% } %>
        </div>
      </div>

      <!-- Main Two-Column Content & Sticky Enquiry Form -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left 2 Cols: Overview, Itinerary, Inclusions, Accommodation -->
        <div class="lg:col-span-2 space-y-12">
          
          <!-- Package Overview -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-navy mb-4">Tour Overview</h2>
            <p class="text-base text-brand-muted leading-relaxed">
              <%= pkg.fullDescription %>
            </p>
          </div>

          <!-- Key Quick Highlights Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 bg-brand-light/60 border border-brand-border p-5 rounded-2xl">
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Duration</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy"><%= pkg.duration %></span>
            </div>
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Stay</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy">
                <%= pkg.pricingModel === 'winter_wonderland' ? 'Deluxe Room' : 'Houseboat & Hotel' %>
              </span>
            </div>
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Vehicle</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy">
                <%= pkg.transportation ? (pkg.transportation.includes('Innova') ? 'Toyota Innova' : 'Private Car') : 'Private Dedicated' %>
              </span>
            </div>
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Meals</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy">Breakfast & Dinner</span>
            </div>
          </div>

          <!-- ========================================================
               INDIVIDUAL PACKAGE BUDGET CALCULATOR (Requirement 9B)
               ======================================================== -->
          <div class="bg-white border-2 border-brand-blue/30 rounded-3xl p-6 sm:p-8 shadow-lg scroll-mt-28" id="packageBudgetCalculator"
               data-pkg-id="<%= pkg.id %>"
               data-pkg-title="<%= pkg.title %>"
               data-pkg-duration="<%= pkg.duration %>"
               data-pkg-price="<%= pkg.price || 0 %>"
               data-pkg-model="<%= pkg.pricingModel || (pkg.price ? 'per_person' : 'on_request') %>"
               data-pkg-child-price="<%= pkg.childPrice || 0 %>">
            
            <div class="border-b border-slate-100 pb-5 mb-6">
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3 py-1 rounded-full">
                DYNAMIC TRIP ESTIMATOR
              </span>
              <h3 class="font-serif text-2xl font-bold text-brand-navy mt-2.5">
                Calculate Your Kashmir Trip Budget
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted mt-1">
                Choose your package and the number of travellers to get an estimated travel budget.
              </p>
            </div>

            <!-- Package Metadata Strip -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-brand-offwhite p-4 rounded-2xl border border-brand-border mb-6 text-xs">
              <div>
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">1. Package Name</span>
                <strong class="text-brand-navy block truncate font-serif text-sm"><%= pkg.title %></strong>
              </div>
              <div>
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">2. Package Duration</span>
                <strong class="text-brand-navy block text-sm"><%= pkg.duration %></strong>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">
                  <%= pkg.pricingModel === 'winter_wonderland' ? '3. Base Package Price' : '3. Price Per Person' %>
                </span>
                <% if (pkg.price && pkg.price > 0) { %>
                  <strong class="text-brand-blue block text-sm">
                    <%= pkg.startingPriceFormatted %> <span class="text-[10px] font-normal text-brand-muted">/<%= pkg.pricingType || 'person' %></span>
                  </strong>
                <% } else { %>
                  <strong class="text-brand-blue block text-xs">Contact us for a personalised quotation.</strong>
                <% } %>
              </div>
            </div>

            <% if (pkg.pricingModel === 'winter_wonderland') { %>
              <!-- WINTER WONDERLAND GROUP CALCULATOR CONTROLS (5-10 Persons) -->
              <div class="space-y-6 mb-6">
                
                <!-- Group Occupancy Selector (+ / -) -->
                <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <span class="text-xs font-bold text-brand-navy block uppercase tracking-wider">4. Group Occupancy (Number of Persons)</span>
                    <span class="text-[11px] text-brand-muted block mt-0.5">Base occupancy: 5 Persons (min 5, max 10) • Dedicated Deluxe Toyota Innova</span>
                  </div>
                  <div class="flex items-center space-x-3 self-start sm:self-auto">
                    <button type="button" id="wwMinusBtn" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                      -
                    </button>
                    <span id="wwPersonsCount" class="font-serif font-bold text-2xl text-brand-navy w-10 text-center">
                      5
                    </span>
                    <button type="button" id="wwPlusBtn" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                      +
                    </button>
                  </div>
                </div>

                <!-- Prominent Highlight Total Box -->
                <div class="bg-gradient-to-r from-brand-navy to-brand-blue text-white p-6 sm:p-7 rounded-2xl shadow-lg">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/15 pb-4 mb-4">
                    <div>
                      <span class="text-xs text-brand-sky font-semibold uppercase tracking-wider block">Selected Group Size</span>
                      <strong class="text-lg text-white font-serif" id="wwGroupSizeDisplay">5 Persons (Base Occupancy)</strong>
                    </div>
                    <div class="sm:text-right">
                      <span class="text-xs text-slate-300 block">Per Person Equivalent</span>
                      <strong class="text-lg font-bold text-brand-sky" id="wwPerPersonDisplay">₹11,800 / person equivalent</strong>
                    </div>
                  </div>

                  <div>
                    <span class="text-[11px] text-amber-300 font-bold uppercase tracking-wider block mb-1">
                      TOTAL PACKAGE PRICE FOR GROUP (NOT PER PERSON)
                    </span>
                    <div class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight" id="wwTotalPriceDisplay">
                      ₹59,000
                    </div>
                    <p class="text-xs text-slate-200 mt-2.5 leading-relaxed" id="wwBreakdownNote">
                      ✓ Complete total package price for all 5 guests. Includes 4 Nights / 5 Days Deluxe Room accommodation in well-rated hotels & comfortable houseboat, daily Breakfast and Dinner, dedicated Deluxe Toyota Innova for all transfers and sightseeing, airport pickup & drop, toll taxes and driver allowances.
                    </p>
                  </div>
                </div>

                <!-- Quick Reference Pricing Tier Grid -->
                <div class="bg-brand-offwhite border border-brand-border rounded-2xl p-4 sm:p-5">
                  <div class="flex items-center justify-between mb-3">
                    <h4 class="font-serif text-xs font-bold text-brand-navy uppercase tracking-wider flex items-center space-x-1.5">
                      <i data-lucide="layers" class="w-3.5 h-3.5 text-brand-blue"></i>
                      <span>Transparent Group Pricing Table</span>
                    </h4>
                    <span class="text-[11px] text-brand-muted">Click any tier to calculate</span>
                  </div>
                  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-center text-xs">
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-brand-navy text-white border-brand-navy shadow-sm" data-pax="5">
                      <span class="block text-[10px] text-slate-200 uppercase font-semibold">5 Persons</span>
                      <strong class="block text-amber-300 font-serif text-sm mt-0.5">₹59,000</strong>
                      <span class="text-[9px] text-slate-300 block">Base Price</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="6">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">6 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹70,800</strong>
                      <span class="text-[9px] text-slate-500 block">+₹11,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="7">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">7 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹85,600</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="8">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">8 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹1,00,400</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="9">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">9 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹1,15,200</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="10">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">10 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹1,30,000</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                  </div>
                </div>

              </div>
            <% } else if (pkg.price && pkg.price > 0) { %>
              <!-- Interactive Counter Controls -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                <!-- 4. Number of Adults -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="text-xs font-bold text-brand-navy block">4. Adults</span>
                    <span class="text-[11px] text-brand-muted">Age 12+ years (<%= pkg.startingPriceFormatted %>/person)</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <button type="button" id="detailAdultsMinus" class="w-9 h-9 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none">
                      -
                    </button>
                    <span id="detailAdultsCount" class="font-serif font-bold text-lg text-brand-navy w-6 text-center">
                      2
                    </span>
                    <button type="button" id="detailAdultsPlus" class="w-9 h-9 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none">
                      +
                    </button>
                  </div>
                </div>

                <!-- 5. Number of Children -->
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex items-center justify-between">
                  <div>
                    <span class="text-xs font-bold text-brand-navy block">5. Children</span>
                    <span class="text-[11px] text-brand-muted">Age 5 to 11 years (<%= pkg.childPrice ? '₹' + pkg.childPrice.toLocaleString('en-IN') : '60% rate' %>)</span>
                  </div>
                  <div class="flex items-center space-x-3">
                    <button type="button" id="detailKidsMinus" class="w-9 h-9 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none">
                      -
                    </button>
                    <span id="detailKidsCount" class="font-serif font-bold text-lg text-brand-navy w-6 text-center">
                      0
                    </span>
                    <button type="button" id="detailKidsPlus" class="w-9 h-9 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none">
                      +
                    </button>
                  </div>
                </div>
              </div>

              <!-- Estimated Total & Per-Person Prominent Highlight Display -->
              <div class="bg-gradient-to-r from-brand-navy to-brand-blue text-white p-6 rounded-2xl shadow-md mb-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/15 pb-4 mb-4">
                  <div>
                    <span class="text-xs text-brand-sky font-semibold uppercase tracking-wider block">6. Total Travellers</span>
                    <strong class="text-lg text-white font-serif" id="detailTotalPaxText">2 Travellers (2 Adults, 0 Children)</strong>
                  </div>
                  <div class="sm:text-right">
                    <span class="text-xs text-slate-300 block">8. Estimated Per-Person Budget</span>
                    <strong class="text-lg font-bold text-brand-sky" id="detailPerPersonText"><%= pkg.startingPriceFormatted %> / person</strong>
                  </div>
                </div>

                <div>
                  <span class="text-xs text-slate-300 block mb-1">7. Estimated Total Package Budget</span>
                  <div class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight" id="detailTotalBudgetText">
                    ₹<%= (pkg.price * 2).toLocaleString('en-IN') %>
                  </div>
                  <p class="text-[11px] text-slate-200 mt-2">
                    ✓ Includes private dedicated transport, hotel/houseboat accommodation, breakfast & dinner, and sightseeing.
                  </p>
                </div>
              </div>
            <% } else { %>
              <!-- Unpriced / On Request Package Note -->
              <div class="bg-brand-light/60 border border-brand-border p-6 rounded-2xl text-center mb-6">
                <i data-lucide="sparkles" class="w-8 h-8 text-brand-blue mx-auto mb-2"></i>
                <h4 class="font-serif text-lg font-bold text-brand-navy mb-1">Tailor-Made Tour Quotation</h4>
                <p class="text-sm text-brand-blue font-semibold">Contact us for a personalised quotation.</p>
                <p class="text-xs text-brand-muted max-w-md mx-auto mt-1">
                  Pricing for this itinerary depends on your exact travel dates, chosen vehicle category, and hotel tier. We will provide a 100% transparent quotation.
                </p>
              </div>
            <% } %>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center gap-3">
              <button type="button" id="detailCalcEnquireBtn" class="w-full sm:w-auto flex-1 btn-primary py-3 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-md">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>Request a Quote</span>
              </button>

              <a id="detailCalcWaBtn" 
                 href="https://wa.me/916006725007?text=<%= encodeURIComponent('Hello City Line Tours And Travels,\nI am inquiring about ' + pkg.title + ' (' + pkg.duration + '). Please share quotation.') %>" 
                 target="_blank" 
                 class="w-full sm:w-auto flex-1 bg-[#25D366] hover:bg-[#20ba59] text-white py-3 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow">
                <i data-lucide="message-circle" class="w-4 h-4"></i>
                <span>Discuss on WhatsApp (6006725007)</span>
              </a>
            </div>

          </div>

          <!-- Day-Wise Detailed Itinerary with Animated Timeline -->
          <div>
            <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-100">
              <h2 class="font-serif text-2xl font-bold text-brand-navy flex items-center space-x-2">
                <i data-lucide="map" class="w-6 h-6 text-brand-blue"></i>
                <span>Day-Wise Tour Itinerary</span>
              </h2>
              <span class="text-xs font-semibold text-brand-blue bg-brand-light px-3 py-1 rounded-full"><%= pkg.itinerary ? pkg.itinerary.length : 0 %> Planned Days</span>
            </div>

            <div class="relative space-y-6" id="itineraryTimeline">
              <!-- Animated Glowing Progress Track Line -->
              <div class="timeline-track">
                <div class="timeline-progress" id="timelineProgress"></div>
              </div>

              <% if (pkg.itinerary && pkg.itinerary.length > 0) { %>
                <% pkg.itinerary.forEach((day, index) => { %>
                  <div class="timeline-node relative pl-10 transition-all duration-300" data-day="<%= day.day %>">
                    <!-- Day Dot Marker with Glow Animation -->
                    <div class="timeline-dot absolute left-0.5 top-1.5 w-6 h-6 rounded-full bg-slate-200 text-brand-navy font-bold text-xs flex items-center justify-center border-2 border-white shadow">
                      <%= day.day %>
                    </div>
                    
                    <div class="timeline-box bg-brand-offwhite border border-brand-border p-5 sm:p-6 rounded-2xl transition-all duration-300">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                        <h3 class="font-serif text-lg font-bold text-brand-navy">
                          Day <%= day.day %>: <%= day.title %>
                        </h3>
                        <% if (day.meals) { %>
                          <span class="text-[11px] font-semibold text-brand-blue bg-brand-light px-2.5 py-0.5 rounded-full inline-block self-start sm:self-auto">
                            <%= day.meals %>
                          </span>
                        <% } %>
                      </div>
                      <p class="text-sm text-brand-muted leading-relaxed mb-3">
                        <%= day.description %>
                      </p>
                      <% if (day.places && day.places.length > 0) { %>
                        <div class="mb-3 flex flex-wrap gap-1.5">
                          <% day.places.forEach(place => { %>
                            <span class="text-[11px] bg-white border border-slate-200 text-brand-navy px-2.5 py-0.5 rounded-md font-medium inline-flex items-center space-x-1 shadow-xs">
                              <i data-lucide="map-pin" class="w-3 h-3 text-brand-blue"></i>
                              <span><%= place %></span>
                            </span>
                          <% }) %>
                        </div>
                      <% } %>
                      <% if (day.stay) { %>
                        <div class="text-xs font-medium text-brand-navy flex items-center space-x-1.5 pt-2.5 border-t border-slate-200/50">
                          <i data-lucide="bed-double" class="w-3.5 h-3.5 text-brand-blue"></i>
                          <span><%= day.stay %></span>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-sm text-brand-muted">Custom day-by-day itinerary will be prepared according to your preferred travel dates.</p>
              <% } %>
            </div>
          </div>

          <!-- Inclusions & Exclusions -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <!-- Inclusions -->
            <div class="bg-emerald-50/50 border border-emerald-200/60 p-6 rounded-2xl">
              <h3 class="font-serif text-lg font-bold text-emerald-950 mb-4 flex items-center space-x-2">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
                <span>Package Inclusions</span>
              </h3>
              <ul class="space-y-2 text-xs sm:text-sm text-emerald-900">
                <% (pkg.inclusions || []).forEach(inc => { %>
                  <li class="flex items-start space-x-2">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
                    <span><%= inc %></span>
                  </li>
                <% }) %>
              </ul>
            </div>

            <!-- Exclusions -->
            <div class="bg-rose-50/50 border border-rose-200/60 p-6 rounded-2xl">
              <h3 class="font-serif text-lg font-bold text-rose-950 mb-4 flex items-center space-x-2">
                <i data-lucide="x-circle" class="w-5 h-5 text-rose-600"></i>
                <span>Package Exclusions</span>
              </h3>
              <ul class="space-y-2 text-xs sm:text-sm text-rose-900">
                <% (pkg.exclusions || []).forEach(exc => { %>
                  <li class="flex items-start space-x-2">
                    <i data-lucide="x" class="w-4 h-4 text-rose-600 shrink-0 mt-0.5"></i>
                    <span><%= exc %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>

          <!-- Stays & Transportation Info -->
          <div class="bg-brand-offwhite border border-brand-border p-6 rounded-2xl space-y-4">
            <h3 class="font-serif text-lg font-bold text-brand-navy">Accommodation & Vehicle Information</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-brand-muted">
              <div>
                <strong class="text-brand-navy block mb-1">Accommodation Plan:</strong>
                <p><%= pkg.accommodation || 'Verified 3-Star / 4-Star deluxe hotels with central heating & 1 night luxury houseboat on Dal Lake.' %></p>
              </div>
              <div>
                <strong class="text-brand-navy block mb-1">Transportation:</strong>
                <p><%= pkg.transportation || 'Dedicated private sanitized vehicle for the entire itinerary (Sedan for 2-3 guests, Innova for 4-6 guests).' %></p>
              </div>
            </div>
          </div>

          <!-- Important Travel Notes & Exclusions -->
          <% if (pkg.importantNotes && pkg.importantNotes.length > 0) { %>
            <div class="bg-amber-50/70 border border-amber-200/90 rounded-2xl p-6 sm:p-7 space-y-4">
              <div class="flex items-center space-x-2.5">
                <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-900 flex items-center justify-center shrink-0">
                  <i data-lucide="alert-circle" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="font-serif text-lg font-bold text-amber-950">Important Notes & Exclusions</h3>
                  <span class="text-xs text-amber-800/80">Please review essential guidelines and local transportation requirements</span>
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-amber-950/90 leading-relaxed">
                <% pkg.importantNotes.forEach(note => { %>
                  <div class="flex items-start space-x-2 bg-white/80 p-3 rounded-xl border border-amber-200/60 shadow-xs">
                    <i data-lucide="info" class="w-3.5 h-3.5 text-amber-700 shrink-0 mt-0.5"></i>
                    <span><%= note %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Responsible Tourism – Keep Kashmir Clean (Requirement 5) -->
          <% if (pkg.responsibleTourism) { %>
            <div class="bg-gradient-to-br from-emerald-50 via-teal-50 to-sky-50 border-2 border-emerald-300/80 rounded-3xl p-6 sm:p-8 shadow-sm space-y-5">
              <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-sm">
                  <i data-lucide="leaf" class="w-5 h-5"></i>
                </div>
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-800 bg-emerald-100 border border-emerald-200 px-2.5 py-0.5 rounded-full inline-block">
                    RESPONSIBLE TRAVEL COMMITMENT
                  </span>
                  <h3 class="font-serif text-xl sm:text-2xl font-bold text-emerald-950 mt-1">
                    <%= pkg.responsibleTourism.title || 'Responsible Tourism – Keep Kashmir Clean' %>
                  </h3>
                </div>
              </div>

              <p class="text-xs sm:text-sm text-emerald-900/85 leading-relaxed">
                Kashmir is our sacred home and India's crown jewel. We warmly invite all our travellers to partner with us in keeping Kashmir clean, pristine, and magnificent for generations to come.
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <% (pkg.responsibleTourism.guidelines || []).forEach(guide => { %>
                  <div class="flex items-start space-x-2.5 bg-white/90 p-3 rounded-xl border border-emerald-100 shadow-xs">
                    <i data-lucide="check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
                    <span class="text-xs text-emerald-950 font-medium leading-relaxed"><%= guide %></span>
                  </div>
                <% }) %>
              </div>

              <div class="bg-emerald-900 text-white p-5 rounded-2xl text-center shadow-md border border-emerald-800">
                <p class="font-serif font-bold text-xs sm:text-sm text-amber-300 tracking-wider uppercase mb-1">
                  LET'S TRAVEL RESPONSIBLY – KEEP KASHMIR CLEAN & BEAUTIFUL!
                </p>
                <p class="text-[11px] sm:text-xs text-emerald-100 leading-relaxed max-w-2xl mx-auto">
                  Thank you for choosing CITY LINE TOURS & TRAVELS. Our commitment is to provide you with a comfortable, safe and memorable travel experience.
                </p>
              </div>
            </div>
          <% } %>

        </div>

        <!-- Right 1 Col: Direct Enquiry & Booking Box -->
        <div>
          <div class="sticky top-28 bg-white border border-brand-border rounded-2xl shadow-xl p-6 sm:p-7 space-y-6">
            
            <div class="border-b border-slate-100 pb-4">
              <span class="text-xs uppercase font-bold text-brand-blue tracking-wider block mb-1">Direct Package Enquiry</span>
              <h3 class="font-serif text-xl font-bold text-brand-navy">Book or Customize This Trip</h3>
              <p class="text-xs text-brand-muted mt-1">Get an official detailed quotation sent straight to your email & WhatsApp.</p>
            </div>

            <!-- Direct Enquiry Form -->
            <form class="ajax-enquiry-form space-y-3.5">
              <input type="hidden" name="source" value="Package Page: <%= pkg.title %>">
              <input type="hidden" name="packageTitle" value="<%= pkg.title %>">
              <input type="hidden" name="packageId" value="<%= pkg.id %>">

              <div>
                <label class="block text-xs font-semibold text-brand-navy mb-1">Full Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" required placeholder="Your Name" class="form-input text-xs sm:text-sm py-2">
              </div>

              <div>
                <label class="block text-xs font-semibold text-brand-navy mb-1">Phone / Mobile <span class="text-red-500">*</span></label>
                <input type="tel" name="phone" required placeholder="Your Phone Number" class="form-input text-xs sm:text-sm py-2">
              </div>

              <div>
                <label class="block text-xs font-semibold text-brand-navy mb-1">Email Address <span class="text-slate-400 font-normal">(For Itinerary PDF)</span></label>
                <input type="email" name="email" placeholder="Your Email Address" class="form-input text-xs sm:text-sm py-2">
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-xs font-semibold text-brand-navy mb-1">Travel Date</label>
                  <input type="date" name="travelDate" class="form-input text-xs sm:text-sm py-2">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-brand-navy mb-1">Guests</label>
                  <select name="travellers" class="form-input text-xs sm:text-sm py-2">
                    <option value="2 Adults">2 Adults</option>
                    <option value="Family (3-4)">Family (3-4)</option>
                    <option value="Group (5+)">Group (5+)</option>
                    <option value="Solo">Solo</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-brand-navy mb-1">Message / Custom Needs</label>
                <textarea name="message" rows="2" placeholder="Any special requests or questions?" class="form-input text-xs sm:text-sm py-2"></textarea>
              </div>

              <button type="submit" class="w-full btn-primary py-3 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-md">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>Send My Enquiry</span>
              </button>
            </form>

            <!-- WhatsApp Pre-Filled CTA Button & PDF Brochure -->
            <div class="pt-2 border-t border-slate-100 space-y-2 text-center">
              <a href="https://wa.me/916006725007?text=Hello%20City%20Line%20Tours,%20I%20am%20interested%20in%20the%20package:%20<%= encodeURIComponent(pkg.title) %>.%20Please%20share%20quotation." 
                 target="_blank" 
                 class="w-full bg-[#25D366] hover:bg-[#20ba59] text-white py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow-sm">
                <i data-lucide="message-circle" class="w-4 h-4"></i>
                <span>Quick WhatsApp Enquiry</span>
              </a>

              <a href="/packages/<%= pkg.slug %>/print?autoprint=1" target="_blank"
                 class="w-full bg-brand-light hover:bg-brand-blue/10 text-brand-blue border border-blue-200 py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition">
                <i data-lucide="printer" class="w-4 h-4"></i>
                <span>Download / Print PDF Itinerary</span>
              </a>

              <p class="text-[11px] text-brand-muted pt-1">
                Direct phone helplines: <a href="tel:6006725007" class="font-bold text-brand-blue">6006725007</a> / <a href="tel:9906676890" class="font-bold text-brand-blue">9906676890</a>
              </p>
            </div>

          </div>
        </div>

      </div>

      <!-- Related Packages -->
      <% if (relatedPackages && relatedPackages.length > 0) { %>
        <div class="mt-20 pt-12 border-t border-brand-border">
          <h3 class="font-serif text-2xl font-bold text-brand-navy mb-8">You Might Also Like</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <% relatedPackages.forEach(rel => { %>
              <div class="bg-white rounded-2xl border border-brand-border overflow-hidden card-hover flex flex-col shadow-sm">
                <div class="relative h-48 img-zoom-container">
                  <img src="<%= rel.featuredImage %>" alt="<%= rel.title %>" class="w-full h-full object-cover">
                  <div class="absolute bottom-2 right-2 bg-brand-navy/90 text-white text-[11px] px-2 py-0.5 rounded">
                    <%= rel.duration %>
                  </div>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <h4 class="font-serif text-base font-bold text-brand-navy mb-1 line-clamp-1">
                      <a href="/packages/<%= rel.slug %>"><%= rel.title %></a>
                    </h4>
                    <p class="text-xs text-brand-muted line-clamp-2 mb-3"><%= rel.shortDescription %></p>
                  </div>
                  <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                    <span class="font-bold text-sm text-brand-blue"><%= rel.startingPriceFormatted %></span>
                    <a href="/packages/<%= rel.slug %>" class="btn-outline px-3 py-1 rounded-md text-xs font-semibold">
                      View Itinerary
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>

  <!-- Package Detail Dynamic Budget Calculator Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('packageBudgetCalculator');
      if (!container) return;

      const price = parseFloat(container.getAttribute('data-pkg-price')) || 0;
      const model = container.getAttribute('data-pkg-model') || 'per_person';
      const title = container.getAttribute('data-pkg-title') || '';
      const duration = container.getAttribute('data-pkg-duration') || '';
      const configuredChildPrice = parseFloat(container.getAttribute('data-pkg-child-price')) || 0;

      const enquireBtn = document.getElementById('detailCalcEnquireBtn');
      const waBtn = document.getElementById('detailCalcWaBtn');

      // 1. Winter Wonderland Group Pricing Structure (5-10 Persons)
      if (model === 'winter_wonderland') {
        const wwPersonsCountEl = document.getElementById('wwPersonsCount');
        const wwMinusBtn = document.getElementById('wwMinusBtn');
        const wwPlusBtn = document.getElementById('wwPlusBtn');
        const wwGroupSizeDisplay = document.getElementById('wwGroupSizeDisplay');
        const wwPerPersonDisplay = document.getElementById('wwPerPersonDisplay');
        const wwTotalPriceDisplay = document.getElementById('wwTotalPriceDisplay');
        const wwBreakdownNote = document.getElementById('wwBreakdownNote');
        const tierCards = document.querySelectorAll('.ww-tier-card');

        let wwPersons = 5;

        function calculateWinterWonderlandPrice(persons) {
          if (persons < 5 || persons > 10) {
            return null;
          }
          if (persons === 5) {
            return 59000;
          }
          if (persons === 6) {
            return 70800;
          }
          return 70800 + (persons - 6) * 14800;
        }

        function updateWWCalc() {
          if (wwPersons < 5) wwPersons = 5;
          if (wwPersons > 10) wwPersons = 10;

          const total = calculateWinterWonderlandPrice(wwPersons);
          if (!total) return;

          const perPerson = Math.round(total / wwPersons);

          if (wwPersonsCountEl) wwPersonsCountEl.textContent = wwPersons;
          if (wwGroupSizeDisplay) {
            wwGroupSizeDisplay.textContent = `${wwPersons} Persons ${wwPersons === 5 ? '(Base Occupancy)' : ''}`;
          }
          if (wwPerPersonDisplay) {
            wwPerPersonDisplay.textContent = `₹${perPerson.toLocaleString('en-IN')} / person equivalent`;
          }
          if (wwTotalPriceDisplay) {
            wwTotalPriceDisplay.textContent = '₹' + total.toLocaleString('en-IN');
          }
          if (wwBreakdownNote) {
            wwBreakdownNote.textContent = `✓ Complete total package price for all ${wwPersons} guests. Includes 4 Nights / 5 Days Deluxe Room accommodation in well-rated hotels & comfortable houseboat, daily Breakfast and Dinner, dedicated Deluxe Toyota Innova for all transfers and sightseeing, airport pickup & drop, toll taxes and driver allowances.`;
          }

          // Button states
          if (wwMinusBtn) {
            const atMin = (wwPersons <= 5);
            wwMinusBtn.style.opacity = atMin ? '0.4' : '1';
            wwMinusBtn.style.cursor = atMin ? 'not-allowed' : 'pointer';
          }
          if (wwPlusBtn) {
            const atMax = (wwPersons >= 10);
            wwPlusBtn.style.opacity = atMax ? '0.4' : '1';
            wwPlusBtn.style.cursor = atMax ? 'not-allowed' : 'pointer';
          }

          // Highlight matching tier card
          tierCards.forEach(card => {
            const cardPax = parseInt(card.getAttribute('data-pax')) || 0;
            const strongEl = card.querySelector('strong');
            const topSpan = card.querySelector('span:first-child');
            const botSpan = card.querySelector('span:last-child');

            if (cardPax === wwPersons) {
              card.classList.add('bg-brand-navy', 'text-white', 'border-brand-navy', 'shadow-sm');
              card.classList.remove('bg-white', 'text-brand-navy', 'border-brand-border');
              if (strongEl) strongEl.className = 'block text-amber-300 font-serif text-sm mt-0.5';
              if (topSpan) topSpan.className = 'block text-[10px] text-slate-200 uppercase font-semibold';
              if (botSpan) botSpan.className = 'text-[9px] text-slate-300 block';
            } else {
              card.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy', 'shadow-sm');
              card.classList.add('bg-white', 'text-brand-navy', 'border-brand-border');
              if (strongEl) strongEl.className = 'block text-brand-navy font-serif text-sm mt-0.5';
              if (topSpan) topSpan.className = 'block text-[10px] text-brand-muted uppercase font-semibold';
              if (botSpan) botSpan.className = 'text-[9px] text-slate-500 block';
            }
          });

          if (waBtn) {
            const msg = `Hello City Line Tours And Travels,\nI calculated an estimated package budget on your website for:\n• Package: ${title}\n• Duration: ${duration}\n• Number of Persons: ${wwPersons} Persons\n• Dedicated Vehicle: Deluxe Toyota Innova\n• Total Package Price: ₹${total.toLocaleString('en-IN')}\n\nPlease share the detailed day-wise itinerary and booking availability!`;
            waBtn.href = `https://wa.me/916006725007?text=${encodeURIComponent(msg)}`;
          }
        }

        wwMinusBtn?.addEventListener('click', () => {
          if (wwPersons > 5) {
            wwPersons--;
            updateWWCalc();
          }
        });

        wwPlusBtn?.addEventListener('click', () => {
          if (wwPersons < 10) {
            wwPersons++;
            updateWWCalc();
          }
        });

        tierCards.forEach(card => {
          card.addEventListener('click', () => {
            const p = parseInt(card.getAttribute('data-pax'));
            if (p >= 5 && p <= 10) {
              wwPersons = p;
              updateWWCalc();
            }
          });
        });

        enquireBtn?.addEventListener('click', () => {
          const modal = document.getElementById('enquiryModal');
          if (!modal) return;

          const modalHeading = document.getElementById('modalTargetTitle');
          const hiddenPkg = document.getElementById('modalPackageTitle');
          const travellersInput = modal.querySelector('select[name="travellers"], input[name="travellers"]');
          const messageInput = modal.querySelector('textarea[name="message"]');

          const total = calculateWinterWonderlandPrice(wwPersons);
          const totalStr = '₹' + total.toLocaleString('en-IN');
          const paxStr = `${wwPersons} Persons (Family Package)`;

          if (modalHeading) modalHeading.textContent = `Enquire: ${title}`;
          if (hiddenPkg) hiddenPkg.value = title;

          if (travellersInput) {
            travellersInput.value = paxStr;
          }

          if (messageInput) {
            messageInput.value = `Hi City Line Tours, I calculated an estimated total budget of ${totalStr} for ${wwPersons} persons for the "${title}" (${duration} with Dedicated Deluxe Toyota Innova). Please share booking availability and quotation.`;
          }

          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        });

        updateWWCalc();
        return;
      }

      // 2. Standard Per-Person / Couple / On-Request Calculator Logic
      const adultsCountEl = document.getElementById('detailAdultsCount');
      const kidsCountEl = document.getElementById('detailKidsCount');
      const adultsMinusBtn = document.getElementById('detailAdultsMinus');
      const adultsPlusBtn = document.getElementById('detailAdultsPlus');
      const kidsMinusBtn = document.getElementById('detailKidsMinus');
      const kidsPlusBtn = document.getElementById('detailKidsPlus');
      const totalPaxTextEl = document.getElementById('detailTotalPaxText');
      const totalBudgetTextEl = document.getElementById('detailTotalBudgetText');
      const perPersonTextEl = document.getElementById('detailPerPersonText');

      let adults = 2;
      let kids = 0;

      function updateDetailCalc() {
        if (price <= 0 || model === 'on_request') {
          if (waBtn) {
            const msg = `Hello City Line Tours And Travels,\nI am inquiring about a personalized quotation for:\n• Package: ${title} (${duration})\n• Number of Travellers: ${adults + kids} (${adults} Adults${kids > 0 ? `, ${kids} Children` : ''})\n\nPlease share the available dates and best quotation!`;
            waBtn.href = `https://wa.me/916006725007?text=${encodeURIComponent(msg)}`;
          }
          return;
        }

        const totalPax = adults + kids;
        let total = 0;
        let perPerson = price;

        if (model === 'per_couple') {
          const couples = Math.ceil(adults / 2);
          total = couples * price;
          perPerson = Math.round(price / 2);
        } else {
          const childRate = configuredChildPrice > 0 ? configuredChildPrice : Math.round(price * 0.6);
          total = (adults * price) + (kids * childRate);
          perPerson = totalPax > 0 ? Math.round(total / totalPax) : price;
        }

        if (totalPaxTextEl) {
          totalPaxTextEl.textContent = `${totalPax} Traveller${totalPax > 1 ? 's' : ''} (${adults} Adult${adults > 1 ? 's' : ''}${kids > 0 ? `, ${kids} Child${kids > 1 ? 'ren' : ''}` : ''})`;
        }

        if (totalBudgetTextEl) {
          totalBudgetTextEl.textContent = '₹' + total.toLocaleString('en-IN');
        }

        if (perPersonTextEl) {
          perPersonTextEl.textContent = `₹${perPerson.toLocaleString('en-IN')} / person`;
        }

        if (waBtn) {
          const msg = `Hello City Line Tours And Travels,\nI calculated an estimated budget for "${title}" (${duration}) on your website:\n• Travellers: ${totalPax} (${adults} Adults${kids > 0 ? `, ${kids} Children` : ''})\n• Estimated Total: ₹${total.toLocaleString('en-IN')} (₹${perPerson.toLocaleString('en-IN')}/person)\n\nPlease share the detailed day-wise itinerary and booking availability!`;
          waBtn.href = `https://wa.me/916006725007?text=${encodeURIComponent(msg)}`;
        }
      }

      adultsMinusBtn?.addEventListener('click', () => {
        if (adults > 1) {
          adults--;
          if (adultsCountEl) adultsCountEl.textContent = adults;
          updateDetailCalc();
        }
      });

      adultsPlusBtn?.addEventListener('click', () => {
        if (adults < 20) {
          adults++;
          if (adultsCountEl) adultsCountEl.textContent = adults;
          updateDetailCalc();
        }
      });

      kidsMinusBtn?.addEventListener('click', () => {
        if (kids > 0) {
          kids--;
          if (kidsCountEl) kidsCountEl.textContent = kids;
          updateDetailCalc();
        }
      });

      kidsPlusBtn?.addEventListener('click', () => {
        if (kids < 10) {
          kids++;
          if (kidsCountEl) kidsCountEl.textContent = kids;
          updateDetailCalc();
        }
      });

      enquireBtn?.addEventListener('click', () => {
        const modal = document.getElementById('enquiryModal');
        if (!modal) return;

        const modalHeading = document.getElementById('modalTargetTitle');
        const hiddenPkg = document.getElementById('modalPackageTitle');
        const travellersInput = modal.querySelector('select[name="travellers"], input[name="travellers"]');
        const messageInput = modal.querySelector('textarea[name="message"]');

        const totalPax = adults + kids;
        let paxStr = `${adults} Adults`;
        if (kids > 0) paxStr += `, ${kids} Kids`;

        if (modalHeading) modalHeading.textContent = `Enquire: ${title}`;
        if (hiddenPkg) hiddenPkg.value = title;

        if (travellersInput) {
          travellersInput.value = paxStr;
        }

        if (messageInput) {
          const totalStr = totalBudgetTextEl ? totalBudgetTextEl.textContent : '';
          messageInput.value = `Hi City Line Tours, I calculated an estimated budget for "${title}" on your website for ${paxStr} (${totalStr}). Please share the day-wise itinerary and quotation.`;
        }

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });

      updateDetailCalc();
    });
  </script>
</body>
</html>

