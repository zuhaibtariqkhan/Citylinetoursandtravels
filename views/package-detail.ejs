<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Breadcrumbs -->
  <div class="bg-brand-offwhite border-b border-brand-border py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-brand-muted flex items-center space-x-2">
      <a href="/" class="hover:text-brand-blue">Home</a>
      <span>/</span>
      <a href="/packages" class="hover:text-brand-blue">Tour Packages</a>
      <span>/</span>
      <span class="text-brand-navy font-semibold truncate"><%= pkg.title %></span>
    </div>
  </div>

  <!-- Package Hero & Main Visual -->
  <section class="py-6 sm:py-10 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Package Header Title & Meta -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 sm:mb-8 text-center lg:text-left">
        <div>
          <div class="flex items-center justify-center lg:justify-start space-x-2 mb-2">
            <span class="bg-brand-light text-brand-blue text-[11px] sm:text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
              <%= pkg.category %> Special
            </span>
            <span class="text-[11px] sm:text-xs text-brand-muted flex items-center">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-blue mr-1 shrink-0"></i>
              <span class="truncate max-w-[200px] sm:max-w-none"><%= (pkg.destinationCoverage || []).join(' • ') %></span>
            </span>
          </div>
          <h1 class="font-serif text-2xl sm:text-4xl lg:text-[45px] font-bold text-brand-navy tracking-tight text-center lg:text-left leading-tight">
            <%= pkg.title %>
          </h1>
        </div>

        <!-- Pricing Summary Box on Desktop with PDF Download -->
        <div class="bg-brand-offwhite border border-brand-border p-3.5 sm:p-4 rounded-xl sm:rounded-2xl flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-6">
          <div>
            <span class="text-[10px] sm:text-[11px] text-brand-muted uppercase block">
              <%= pkg.pricingModel === 'autumn_chinar' ? 'Starting Package Price (2 Persons)' : (pkg.pricingModel === 'amarnath_yatra' ? 'Starting Package Price (2 Yatris)' : (pkg.pricingModel === 'tulip_festival' ? 'Starting Package Price (2 Travellers)' : (pkg.pricingModel === 'winter_wonderland' ? 'Total Package Price (5 Persons)' : (pkg.pricingModel === 'himalayan_escape' ? 'Starting Package Price (12 Travellers)' : (pkg.pricingModel === 'fixed_couple' ? 'Total Fixed Price (Couple)' : 'Starting Price'))))) %>
            </span>
            <div class="font-serif text-xl sm:text-2xl font-bold text-brand-blue">
              <%= pkg.startingPriceFormatted %>
            </div>
            <% if (pkg.price && pkg.pricingModel !== 'fixed_couple' && pkg.pricingModel !== 'winter_wonderland' && pkg.pricingModel !== 'himalayan_escape' && pkg.pricingModel !== 'tulip_festival' && pkg.pricingModel !== 'amarnath_yatra' && pkg.pricingModel !== 'autumn_chinar') { %>
              <span class="text-[10px] sm:text-[11px] text-brand-muted">/<%= pkg.pricingType || 'person' %></span>
            <% } else if (pkg.pricingModel === 'himalayan_escape') { %>
              <span class="text-[10px] sm:text-[11px] text-brand-muted">for 12 Travellers Base</span>
            <% } else if (pkg.pricingModel === 'tulip_festival') { %>
              <span class="text-[10px] sm:text-[11px] text-brand-muted">for 2 Travellers Base (₹13,500/person)</span>
            <% } else if (pkg.pricingModel === 'amarnath_yatra') { %>
              <span class="text-[10px] sm:text-[11px] text-brand-muted">for 2 Yatris Base (₹17,500/Yatri)</span>
            <% } else if (pkg.pricingModel === 'autumn_chinar') { %>
              <span class="text-[10px] sm:text-[11px] text-brand-muted">for 2 Persons Base (₹33,000/person)</span>
            <% } %>
          </div>
          <div class="border-t pt-2.5 sm:border-t-0 sm:pt-0 sm:border-l sm:border-slate-200 sm:pl-4 lg:pl-6 text-center sm:text-left">
            <span class="text-[10px] sm:text-[11px] text-brand-muted uppercase block">Duration</span>
            <div class="font-bold text-xs sm:text-sm text-brand-navy flex items-center justify-center sm:justify-start space-x-1 mt-0.5 sm:mt-1">
              <i data-lucide="calendar" class="w-4 h-4 text-brand-blue"></i>
              <span><%= pkg.duration %></span>
            </div>
          </div>
          <div class="w-full sm:w-auto border-t pt-2.5 sm:border-t-0 sm:pt-0 sm:border-l sm:border-slate-200 sm:pl-4 lg:pl-6">
            <a href="/packages/<%= pkg.slug %>/print?autoprint=1" target="_blank" 
               class="w-full sm:w-auto inline-flex items-center justify-center space-x-1.5 bg-white border border-brand-border hover:border-brand-blue hover:text-brand-blue text-brand-navy text-xs font-semibold px-3.5 py-2.5 rounded-xl transition shadow-sm min-h-[44px]">
              <i data-lucide="file-down" class="w-4 h-4 text-brand-blue"></i>
              <span>Download PDF Itinerary</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Main Image & Mini Gallery Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 rounded-2xl overflow-hidden mb-6 sm:mb-12 shadow-md">
        <div class="lg:col-span-2 h-[250px] sm:h-[460px]">
          <img src="<%= pkg.featuredImage %>" alt="<%= pkg.title %>" class="w-full h-full object-cover">
        </div>
        <div class="hidden lg:grid grid-rows-2 gap-4 h-[460px]">
          <% if (pkg.galleryImages && pkg.galleryImages.length > 0) { %>
            <% const sideImages = pkg.galleryImages.filter(img => img !== pkg.featuredImage).slice(0, 2); %>
            <% (sideImages.length > 0 ? sideImages : pkg.galleryImages.slice(0, 2)).forEach(img => { %>
              <div class="h-full overflow-hidden">
                <img src="<%= img %>" alt="Kashmir Landscape" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
              </div>
            <% }) %>
          <% } else { %>
            <div class="h-full overflow-hidden">
              <img src="/DESTINATIONS/SRINAGAR.jpeg" alt="Dal Lake" class="w-full h-full object-cover">
            </div>
            <div class="h-full overflow-hidden">
              <img src="/DESTINATIONS/GULMARG.jpeg" alt="Gulmarg" class="w-full h-full object-cover">
            </div>
          <% } %>
        </div>
      </div>

      <!-- Main Two-Column Content & Sticky Enquiry Form -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
        
        <!-- Left 2 Cols: Overview, Itinerary, Inclusions, Accommodation -->
        <div class="lg:col-span-2 space-y-6 sm:space-y-12">
          
          <!-- Package Overview -->
          <div>
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-brand-navy mb-3 sm:mb-4 text-center sm:text-left">Tour Overview</h2>
            <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
              <%= pkg.fullDescription %>
            </p>
          </div>

          <!-- Key Quick Highlights Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 bg-brand-light/60 border border-brand-border p-3.5 sm:p-5 rounded-2xl">
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Duration</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy"><%= pkg.duration %></span>
            </div>
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Stay</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy">
                <%= (pkg.pricingModel === 'amarnath_yatra') ? 'Deluxe Hotels / Camps' : ((pkg.pricingModel === 'autumn_chinar') ? 'Deluxe Room & Houseboat' : ((pkg.pricingModel === 'winter_wonderland' || pkg.pricingModel === 'tulip_festival') ? 'Deluxe Room' : (pkg.pricingModel === 'himalayan_escape' ? 'Deluxe Camps & Hotels' : 'Houseboat & Hotel'))) %>
              </span>
            </div>
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Vehicle</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy">
                <%= (pkg.pricingModel === 'amarnath_yatra') ? 'Private Vehicle' : ((pkg.pricingModel === 'autumn_chinar') ? 'Private Dedicated Vehicle' : (pkg.pricingModel === 'tulip_festival' ? 'Deluxe Sedan' : (pkg.pricingModel === 'winter_wonderland' ? 'Toyota Innova' : (pkg.pricingModel === 'himalayan_escape' ? 'Expedition Fleet' : (pkg.transportation ? (pkg.transportation.includes('Innova') ? 'Toyota Innova' : 'Private Car') : 'Private Dedicated'))))) %>
              </span>
            </div>
            <div>
              <span class="text-[11px] text-brand-muted uppercase block">Meals</span>
              <span class="font-semibold text-xs sm:text-sm text-brand-navy">Breakfast & Dinner</span>
            </div>
          </div>

          <!-- ========================================================
               INDIVIDUAL PACKAGE BUDGET CALCULATOR (Requirement 9B)
               ======================================================== -->
          <div class="bg-white border-2 border-brand-blue/30 rounded-3xl p-6 sm:p-8 shadow-lg scroll-mt-28" id="packageBudgetCalculator"
               data-pkg-id="<%= pkg.id %>"
               data-pkg-title="<%= pkg.title %>"
               data-pkg-duration="<%= pkg.duration %>"
               data-pkg-price="<%= pkg.price || 0 %>"
               data-pkg-model="<%= pkg.pricingModel || (pkg.price ? 'per_person' : 'on_request') %>"
               data-pkg-child-price="<%= pkg.childPrice || 0 %>"
               data-pkg-base-pax="<%= pkg.baseOccupancy || 12 %>"
               data-pkg-addl-rate="<%= pkg.additionalPersonRate || 27083.333333333336 %>">
            
            <div class="border-b border-slate-100 pb-5 mb-6">
              <span class="text-[10px] font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3 py-1 rounded-full">
                DYNAMIC TRIP ESTIMATOR
              </span>
              <h3 class="font-serif text-2xl font-bold text-brand-navy mt-2.5">
                Calculate Your Kashmir Trip Budget
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted mt-1">
                Choose your package and the number of travellers to get an estimated travel budget.
              </p>
            </div>

            <!-- Package Metadata Strip -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-brand-offwhite p-4 rounded-2xl border border-brand-border mb-6 text-xs">
              <div>
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">1. Package Name</span>
                <strong class="text-brand-navy block truncate font-serif text-sm"><%= pkg.title %></strong>
              </div>
              <div>
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">2. Package Duration</span>
                <strong class="text-brand-navy block text-sm"><%= pkg.duration %></strong>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">
                  <%= (pkg.pricingModel === 'autumn_chinar' || pkg.pricingModel === 'amarnath_yatra' || pkg.pricingModel === 'winter_wonderland' || pkg.pricingModel === 'tulip_festival') ? '3. Starting Package Price' : (pkg.pricingModel === 'himalayan_escape' ? '3. Starting Package Price' : (pkg.pricingModel === 'fixed_couple' ? '3. Fixed Package Price' : '3. Price Per Person')) %>
                </span>
                <% if (pkg.price && pkg.price > 0) { %>
                  <strong class="text-brand-blue block text-sm">
                    <%= pkg.startingPriceFormatted %> <span class="text-[10px] font-normal text-brand-muted">/<%= pkg.pricingModel === 'autumn_chinar' ? '2 persons base' : (pkg.pricingModel === 'amarnath_yatra' ? '2 yatris base' : (pkg.pricingModel === 'tulip_festival' ? '2 travellers base' : (pkg.pricingModel === 'himalayan_escape' ? '12 travellers base' : (pkg.pricingType || 'person')))) %></span>
                  </strong>
                <% } else { %>
                  <strong class="text-brand-blue block text-xs">Contact us for a personalised quotation.</strong>
                <% } %>
              </div>
            </div>

            <% if (pkg.pricingModel === 'fixed_couple') { %>
              <!-- KASHMIR HONEYMOON SPECIAL - FIXED COUPLE CALCULATOR (2 Persons Fixed) -->
              <div class="space-y-6 mb-6">
                <!-- Occupancy Lock Box -->
                <div class="bg-rose-50/60 p-4 sm:p-5 rounded-2xl border border-rose-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                      <i data-lucide="heart" class="w-5 h-5 fill-rose-500"></i>
                    </div>
                    <div>
                      <span class="text-xs font-bold text-brand-navy block uppercase tracking-wider">Couple Occupancy (Fixed)</span>
                      <span class="text-[11px] text-brand-muted block mt-0.5">Fixed Couple Package • Exactly 2 Persons (Couple)</span>
                    </div>
                  </div>
                  <div class="flex items-center space-x-2 self-start sm:self-auto bg-white px-3.5 py-2 rounded-xl border border-brand-border shadow-xs">
                    <span class="font-serif font-bold text-lg text-brand-navy">2 Persons</span>
                    <span class="text-[10px] uppercase font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200">Couple Only</span>
                  </div>
                </div>

                <!-- Prominent Highlight Total Box -->
                <div class="bg-gradient-to-r from-brand-navy to-brand-blue text-white p-6 sm:p-7 rounded-2xl shadow-lg">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/15 pb-4 mb-4">
                    <div>
                      <span class="text-xs text-brand-sky font-semibold uppercase tracking-wider block">Selected Package Occupancy</span>
                      <strong class="text-lg text-white font-serif">2 Persons (Couple)</strong>
                    </div>
                    <div class="sm:text-right">
                      <span class="text-xs text-slate-300 block">Per Person Equivalent</span>
                      <strong class="text-lg font-bold text-brand-sky">₹20,000 / person equivalent</strong>
                    </div>
                  </div>

                  <div>
                    <span class="text-[11px] text-amber-300 font-bold uppercase tracking-wider block mb-1">
                      TOTAL FIXED PACKAGE PRICE FOR COUPLE (NOT PER PERSON)
                    </span>
                    <div class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight">
                      ₹40,000
                    </div>
                    <p class="text-xs text-slate-200 mt-2.5 leading-relaxed">
                      ✓ Complete all-inclusive fixed package price for 2 Persons (Couple). Includes 5 Nights / 6 Days deluxe accommodation (including romantic houseboat stay), daily breakfast & dinner, dedicated private vehicle with driver for all transfers and sightseeing, romantic Dal Lake Shikara ride, airport transfers, toll taxes and parking.
                    </p>
                  </div>
                </div>

                <!-- 3-Column Couple Inclusions Strip -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div class="bg-brand-offwhite border border-brand-border p-3.5 rounded-xl text-center">
                    <span class="text-[11px] text-brand-muted block uppercase font-medium">Pricing Model</span>
                    <strong class="text-xs text-brand-navy font-bold block mt-1">₹40,000 Fixed (Total)</strong>
                  </div>
                  <div class="bg-brand-offwhite border border-brand-border p-3.5 rounded-xl text-center">
                    <span class="text-[11px] text-brand-muted block uppercase font-medium">Duration</span>
                    <strong class="text-xs text-brand-navy font-bold block mt-1">5 Nights / 6 Days</strong>
                  </div>
                  <div class="bg-brand-offwhite border border-brand-border p-3.5 rounded-xl text-center">
                    <span class="text-[11px] text-brand-muted block uppercase font-medium">Additional Persons</span>
                    <strong class="text-xs text-brand-navy font-bold block mt-1">Not Applicable</strong>
                  </div>
                </div>
              </div>
            <% } else if (pkg.pricingModel === 'winter_wonderland') { %>
              <!-- WINTER WONDERLAND GROUP CALCULATOR CONTROLS (5-10 Persons) -->
              <div class="space-y-6 mb-6">
                
                <!-- Group Occupancy Selector (+ / -) -->
                <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <span class="text-xs font-bold text-brand-navy block uppercase tracking-wider">4. Group Occupancy (Number of Persons)</span>
                    <span class="text-[11px] text-brand-muted block mt-0.5">Base occupancy: 5 Persons (min 5, max 10) • Dedicated Deluxe Toyota Innova</span>
                  </div>
                  <div class="flex items-center space-x-3 self-start sm:self-auto">
                    <button type="button" id="wwMinusBtn" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                      -
                    </button>
                    <span id="wwPersonsCount" class="font-serif font-bold text-2xl text-brand-navy w-10 text-center">
                      5
                    </span>
                    <button type="button" id="wwPlusBtn" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                      +
                    </button>
                  </div>
                </div>

                <!-- Prominent Highlight Total Box -->
                <div class="bg-gradient-to-r from-brand-navy to-brand-blue text-white p-6 sm:p-7 rounded-2xl shadow-lg">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/15 pb-4 mb-4">
                    <div>
                      <span class="text-xs text-brand-sky font-semibold uppercase tracking-wider block">Selected Group Size</span>
                      <strong class="text-lg text-white font-serif" id="wwGroupSizeDisplay">5 Persons (Base Occupancy)</strong>
                    </div>
                    <div class="sm:text-right">
                      <span class="text-xs text-slate-300 block">Per Person Equivalent</span>
                      <strong class="text-lg font-bold text-brand-sky" id="wwPerPersonDisplay">₹11,800 / person equivalent</strong>
                    </div>
                  </div>

                  <div>
                    <span class="text-[11px] text-amber-300 font-bold uppercase tracking-wider block mb-1">
                      TOTAL PACKAGE PRICE FOR GROUP (NOT PER PERSON)
                    </span>
                    <div class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight" id="wwTotalPriceDisplay">
                      ₹59,000
                    </div>
                    <p class="text-xs text-slate-200 mt-2.5 leading-relaxed" id="wwBreakdownNote">
                      ✓ Complete total package price for all 5 guests. Includes 4 Nights / 5 Days Deluxe Room accommodation in well-rated hotels & comfortable houseboat, daily Breakfast and Dinner, dedicated Deluxe Toyota Innova for all transfers and sightseeing, airport pickup & drop, toll taxes and driver allowances.
                    </p>
                  </div>
                </div>

                <!-- Quick Reference Pricing Tier Grid -->
                <div class="bg-brand-offwhite border border-brand-border rounded-2xl p-4 sm:p-5">
                  <div class="flex items-center justify-between mb-3">
                    <h4 class="font-serif text-xs font-bold text-brand-navy uppercase tracking-wider flex items-center space-x-1.5">
                      <i data-lucide="layers" class="w-3.5 h-3.5 text-brand-blue"></i>
                      <span>Transparent Group Pricing Table</span>
                    </h4>
                    <span class="text-[11px] text-brand-muted">Click any tier to calculate</span>
                  </div>
                  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-center text-xs">
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-brand-navy text-white border-brand-navy shadow-sm" data-pax="5">
                      <span class="block text-[10px] text-slate-200 uppercase font-semibold">5 Persons</span>
                      <strong class="block text-amber-300 font-serif text-sm mt-0.5">₹59,000</strong>
                      <span class="text-[9px] text-slate-300 block">Base Price</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="6">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">6 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹70,800</strong>
                      <span class="text-[9px] text-slate-500 block">+₹11,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="7">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">7 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹85,600</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="8">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">8 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹1,00,400</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="9">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">9 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹1,15,200</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                    <div class="ww-tier-card p-2.5 rounded-xl border transition cursor-pointer select-none bg-white text-brand-navy border-brand-border hover:border-brand-blue" data-pax="10">
                      <span class="block text-[10px] text-brand-muted uppercase font-semibold">10 Persons</span>
                      <strong class="block text-brand-navy font-serif text-sm mt-0.5">₹1,30,000</strong>
                      <span class="text-[9px] text-slate-500 block">+₹14,800</span>
                    </div>
                  </div>
                </div>

              </div>
            <% } else if (pkg.pricingModel === 'himalayan_escape') { %>
              <!-- THE HIMALAYAN GRAND ESCAPE - DYNAMIC REAL-TIME GROUP PRICING CALCULATOR (12+ Travellers) -->
              <div class="space-y-6 mb-6">
                <!-- Group Occupancy Selector (+ / -) -->
                <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <span class="text-xs font-bold text-brand-navy block uppercase tracking-wider">Number of Travellers</span>
                    <span class="text-[11px] text-brand-muted block mt-0.5">Starting group size: 12 travellers (minimum 12) • Dedicated Overland Expedition Fleet</span>
                  </div>
                  <div class="flex items-center space-x-3 self-start sm:self-auto">
                    <button type="button" id="heMinusBtn" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base disabled:opacity-40 disabled:cursor-not-allowed">
                      -
                    </button>
                    <span id="heTravellersCount" class="font-serif font-bold text-2xl text-brand-navy w-12 text-center">
                      12
                    </span>
                    <button type="button" id="hePlusBtn" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                      +
                    </button>
                  </div>
                </div>

                <!-- 4-Metric Transparent Pricing Strip -->
