<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Breadcrumbs -->
  <div class="bg-brand-offwhite border-b border-brand-border py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-brand-muted flex items-center space-x-2">
      <a href="/" class="hover:text-brand-blue">Home</a>
      <span>/</span>
      <a href="/destinations" class="hover:text-brand-blue">Destinations</a>
      <span>/</span>
      <span class="text-brand-navy font-semibold"><%= destination.name %></span>
    </div>
  </div>

  <!-- Destination Hero Banner -->
  <section class="relative py-24 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="<%= destination.image %>" alt="<%= destination.name %>" fetchpriority="high" class="w-full h-full object-cover object-center brightness-[0.45]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-4 py-1.5 rounded-full inline-block mb-3">
        <%= destination.region ? destination.region.toUpperCase() : 'HIMALAYAN' %> DESTINATION GUIDE
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-3">
        <%= destination.name %>
      </h1>
      <p class="font-serif italic text-lg sm:text-xl text-brand-sky max-w-2xl mx-auto mb-6">
        "<%= destination.tagline %>"
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-semibold">
        <span class="bg-white/20 backdrop-blur px-3.5 py-1.5 rounded-full">Suggested Duration: <%= destination.suggestedDuration %></span>
        <% if (destination.altitude) { %>
          <span class="bg-white/20 backdrop-blur px-3.5 py-1.5 rounded-full flex items-center space-x-1">
            <i data-lucide="mountain" class="w-3.5 h-3.5 text-brand-sky"></i>
            <span>Elevation: <%= destination.altitude %></span>
          </span>
        <% } %>
        <% if (destination.distanceFromAirport) { %>
          <span class="bg-white/20 backdrop-blur px-3.5 py-1.5 rounded-full flex items-center space-x-1">
            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-sky"></i>
            <span><%= destination.distanceFromAirport %></span>
          </span>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Destination Details & Information -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left 2 Columns: Overview, Attractions, Things to Do -->
        <div class="lg:col-span-2 space-y-12">
          
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-navy mb-4">
              About <%= destination.name %>
            </h2>
            <p class="text-base text-brand-muted leading-relaxed mb-6">
              <%= destination.fullDescription %>
            </p>

            <!-- Featured Destination Landscape Showcase -->
            <div class="rounded-2xl overflow-hidden border border-brand-border shadow-md h-72 sm:h-96 relative group">
              <img src="<%= destination.image %>" 
                   alt="<%= destination.name %> Scenic Landscape" 
                   loading="lazy" 
                   decoding="async" 
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-4 left-4 right-4 text-white flex items-center justify-between text-xs pointer-events-none">
                <span class="font-serif font-bold text-sm sm:text-base drop-shadow-sm"><%= destination.name %>, <%= destination.region %></span>
                <span class="bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-semibold border border-white/20">
                  <%= destination.altitude || 'Himalayas' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Best Time to Visit Card -->
          <div class="bg-brand-light/70 border border-brand-border p-6 rounded-2xl flex items-start space-x-4">
            <div class="w-12 h-12 rounded-xl bg-brand-blue text-white flex items-center justify-center shrink-0">
              <i data-lucide="sun" class="w-6 h-6"></i>
            </div>
            <div>
              <h3 class="font-serif text-lg font-bold text-brand-navy mb-1">Best Time to Visit</h3>
              <p class="text-sm text-brand-navy/90 leading-relaxed"><%= destination.bestTimeToVisit %></p>
            </div>
          </div>

          <!-- Top Attractions -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-navy mb-6 flex items-center space-x-2">
              <i data-lucide="map-pin" class="w-6 h-6 text-brand-blue"></i>
              <span>Key Attractions in <%= destination.name %></span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <% (destination.attractions || []).forEach(att => { %>
                <div class="bg-brand-offwhite border border-brand-border p-4 rounded-xl flex items-center space-x-3">
                  <i data-lucide="compass" class="w-4 h-4 text-brand-blue shrink-0"></i>
                  <span class="text-xs sm:text-sm font-semibold text-brand-navy"><%= att %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Things to Do -->
          <div>
            <h2 class="font-serif text-2xl font-bold text-brand-navy mb-6 flex items-center space-x-2">
              <i data-lucide="camera" class="w-6 h-6 text-brand-blue"></i>
              <span>Things to Experience in <%= destination.name %></span>
            </h2>
            <ul class="space-y-3">
              <% (destination.thingsToDo || []).forEach(todo => { %>
                <li class="bg-brand-offwhite border border-brand-border p-4 rounded-xl flex items-start space-x-3 text-xs sm:text-sm text-brand-muted">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-brand-blue shrink-0 mt-0.5"></i>
                  <span class="text-brand-navy font-medium"><%= todo %></span>
                </li>
              <% }) %>
            </ul>
          </div>

        </div>

        <!-- Right 1 Column: Plan a Trip to this destination -->
        <div>
          <div class="sticky top-28 bg-brand-offwhite border border-brand-border rounded-2xl p-6 sm:p-7 shadow-lg space-y-6">
            
            <div class="border-b border-slate-200 pb-4">
              <span class="text-xs uppercase font-bold text-brand-blue tracking-wider block mb-1">Trip Planner</span>
              <h3 class="font-serif text-xl font-bold text-brand-navy">Visit <%= destination.name %></h3>
              <p class="text-xs text-brand-muted mt-1">Include <%= destination.name %> in your personalized Kashmir itinerary.</p>
            </div>

            <form class="ajax-enquiry-form space-y-4">
              <input type="hidden" name="source" value="Destination Guide: <%= destination.name %>">
              <input type="hidden" name="destination" value="<%= destination.name %>">

              <div>
                <label for="destLeadName" class="block text-xs font-semibold text-brand-navy mb-1">Your Full Name <span class="text-red-500">*</span></label>
                <input type="text" id="destLeadName" name="name" required placeholder="Full Name" class="form-input text-xs sm:text-sm py-2">
              </div>

              <div>
                <label for="destLeadPhone" class="block text-xs font-semibold text-brand-navy mb-1">Mobile / WhatsApp <span class="text-red-500">*</span></label>
                <input type="tel" id="destLeadPhone" name="phone" required placeholder="Mobile Number" class="form-input text-xs sm:text-sm py-2">
              </div>

              <div>
                <label for="destLeadEmail" class="block text-xs font-semibold text-brand-navy mb-1">Email Address</label>
                <input type="email" id="destLeadEmail" name="email" placeholder="Email Address" class="form-input text-xs sm:text-sm py-2">
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="destLeadDate" class="block text-xs font-semibold text-brand-navy mb-1">Travel Date</label>
                  <input type="date" id="destLeadDate" name="travelDate" class="form-input text-xs sm:text-sm py-2">
                </div>
                <div>
                  <label for="destLeadTravellers" class="block text-xs font-semibold text-brand-navy mb-1">Travellers</label>
                  <select id="destLeadTravellers" name="travellers" class="form-input text-xs sm:text-sm py-2">
                    <option value="Couple (2)">Couple (2)</option>
                    <option value="Family (3-4)">Family (3-4)</option>
                    <option value="Group (5+)">Group (5+)</option>
                    <option value="Solo">Solo</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="destLeadMessage" class="block text-xs font-semibold text-brand-navy mb-1">Specific Wishes</label>
                <textarea id="destLeadMessage" name="message" rows="2" placeholder="Tell us if you want to combine <%= destination.name %> with other places..." class="form-input text-xs sm:text-sm py-2"></textarea>
              </div>

              <button type="submit" class="w-full btn-primary py-3 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-md">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>Request a Quote</span>
              </button>
            </form>

            <div class="pt-2 border-t border-slate-200 text-center">
              <a href="https://wa.me/916006725007?text=Hello%20City%20Line%20Tours,%20I%20am%20planning%20a%20trip%20to%20<%= encodeURIComponent(destination.name) %>.%20Please%20share%20details." 
                 target="_blank" 
                 class="w-full bg-[#25D366] hover:bg-[#20ba59] text-white py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition">
                <i data-lucide="message-circle" class="w-4 h-4"></i>
                <span>Chat with Kashmir Expert (6006725007)</span>
              </a>
            </div>

          </div>
        </div>

      </div>

      <!-- Related Packages Covering This Destination -->
      <% if (relatedPackages && relatedPackages.length > 0) { %>
        <div class="mt-20 pt-12 border-t border-brand-border">
          <div class="flex items-center justify-between mb-8">
            <h3 class="font-serif text-2xl font-bold text-brand-navy">
              Packages Featuring <%= destination.name %>
            </h3>
            <a href="/packages" class="text-xs font-semibold text-brand-blue hover:underline">View All Packages &rarr;</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <% relatedPackages.slice(0, 3).forEach(pkg => { %>
              <div class="bg-white rounded-2xl border border-brand-border overflow-hidden card-hover flex flex-col shadow-sm">
                <div class="relative h-48 img-zoom-container">
                  <img src="<%= pkg.featuredImage %>" alt="<%= pkg.title %>" class="w-full h-full object-cover">
                  <div class="absolute bottom-2 right-2 bg-brand-navy/90 text-white text-[11px] px-2 py-0.5 rounded">
                    <%= pkg.duration %>
                  </div>
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                  <div>
                    <h4 class="font-serif text-base font-bold text-brand-navy mb-1 line-clamp-1">
                      <a href="/packages/<%= pkg.slug %>"><%= pkg.title %></a>
                    </h4>
                    <p class="text-xs text-brand-muted line-clamp-2 mb-3"><%= pkg.shortDescription %></p>
                  </div>
                  <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                    <span class="font-bold text-sm text-brand-blue"><%= pkg.startingPriceFormatted %></span>
                    <a href="/packages/<%= pkg.slug %>" class="btn-outline px-3 py-1 rounded-md text-xs font-semibold">
                      View Details
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>

