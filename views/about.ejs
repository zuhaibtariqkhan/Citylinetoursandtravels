<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- ========================================================
       PAGE HERO
       ======================================================== -->
  <section class="relative py-24 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/Pages/About Us.jpg" 
           alt="City Line Tours And Travels - About Us" 
           class="w-full h-full object-cover brightness-[0.35]">
      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/60 to-brand-navy/40"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <div class="inline-flex items-center space-x-2 bg-brand-sky/20 border border-brand-sky/40 text-brand-sky px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest mb-4 backdrop-blur-sm shadow-sm">
        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
        <span>Serving Since 2016</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 tracking-tight">
        CITY LINE TOURS AND TRAVELS
      </h1>
      <p class="font-serif text-lg sm:text-2xl text-brand-sky font-medium mb-3 italic">
        "Where Your Travel Dreams Take Flight"
      </p>
      <p class="text-sm sm:text-base text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Dedicated to making every journey meaningful, memorable, and hassle-free across Jammu & Kashmir and all of India.
      </p>
    </div>
  </section>

  <!-- ========================================================
       SECTION: OUR STORY
       ======================================================== -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Story Prose -->
        <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
          <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full mx-auto lg:mx-0">
            <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
            <span>OUR STORY</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-navy leading-tight text-center lg:text-left">
            Welcome to CITY LINE TOURS AND TRAVELS
          </h2>
          
          <div class="space-y-4 text-brand-muted text-sm sm:text-base leading-relaxed text-left">
            <p class="text-base sm:text-lg text-brand-navy font-medium text-center lg:text-left">
              Where every journey begins with trust, comfort, and unforgettable experiences.
            </p>

            <p>
              Since 2016, we have been dedicated to making every journey meaningful, memorable, and hassle-free. Based in the beautiful region of Jammu & Kashmir, we take pride in showcasing the breathtaking landscapes, rich culture, traditions, and warm hospitality of Kashmir while helping people explore incredible destinations across India.
            </p>

            <p>
              Over the years, our passion for travel has grown into a commitment to providing reliable travel services, thoughtfully planned itineraries, comfortable stays, and experiences that create lasting memories.
            </p>

            <p>
              Whether you are planning a peaceful family holiday, a romantic honeymoon, an adventurous mountain escape, a spiritual pilgrimage, or a group tour, we aim to make every part of your journey smooth and enjoyable.
            </p>
          </div>

          <!-- Feature Tag Pills -->
          <div class="pt-2 flex flex-wrap gap-2 text-xs font-semibold text-brand-navy">
            <span class="bg-brand-offwhite px-3 py-1.5 rounded-lg border border-brand-border flex items-center space-x-1.5">
              <i data-lucide="check" class="w-3.5 h-3.5 text-brand-blue"></i>
              <span>Trust & Comfort</span>
            </span>
            <span class="bg-brand-offwhite px-3 py-1.5 rounded-lg border border-brand-border flex items-center space-x-1.5">
              <i data-lucide="check" class="w-3.5 h-3.5 text-brand-blue"></i>
              <span>Local Destination Expertise</span>
            </span>
            <span class="bg-brand-offwhite px-3 py-1.5 rounded-lg border border-brand-border flex items-center space-x-1.5">
              <i data-lucide="check" class="w-3.5 h-3.5 text-brand-blue"></i>
              <span>Memorable Kashmir Stays</span>
            </span>
          </div>
        </div>

        <!-- Right Column: 3 Videos Showcase -->
        <div class="lg:col-span-5 relative" id="aboutVideoShowcase">
          
          <!-- Main Active Video Player -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-100 bg-brand-navy h-[340px] sm:h-[380px]">
            <video id="mainAboutVideo" 
                   src="/images/media_1.mp4" 
                   autoplay 
                   muted 
                   loop 
                   playsinline 
                   class="w-full h-full object-cover">
            </video>
            <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/85 via-transparent to-black/25 pointer-events-none"></div>

            <!-- Top Overlay Badges & Sound Toggle -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between z-10">
              <span class="inline-flex items-center space-x-1.5 bg-brand-navy/80 backdrop-blur-md text-brand-sky text-[11px] font-semibold px-3 py-1 rounded-full border border-white/10 shadow-sm pointer-events-none">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                <span id="activeVideoTitle">Kashmir Moments (Media 1)</span>
              </span>

              <button type="button" id="videoAudioToggleBtn" class="p-2 bg-brand-navy/80 hover:bg-brand-blue text-white rounded-full backdrop-blur-md transition shadow border border-white/15" title="Toggle Sound">
                <i data-lucide="volume-x" id="volumeIcon" class="w-4 h-4"></i>
              </button>
            </div>

            <!-- Bottom Location Info -->
            <div class="absolute bottom-4 left-4 right-4 text-white z-10 pointer-events-none">
              <span class="text-[10px] font-bold uppercase tracking-wider text-brand-sky">Palpora, Srinagar • Jammu & Kashmir</span>
              <h4 class="font-serif text-base sm:text-lg font-bold text-white mt-0.5">Authentic Kashmir Hospitality in Motion</h4>
            </div>
          </div>

          <!-- Video Selector Grid: 4 Videos (Media 1, Media 1_2, Media 1_1, CUTE) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-3">
            
            <!-- Video 1 (media_1.mp4) -->
            <button type="button" class="about-video-thumb active relative rounded-2xl overflow-hidden border-2 border-brand-blue shadow group text-left h-20 sm:h-22 bg-brand-navy transition-all focus:outline-none" data-video="/images/media_1.mp4" data-title="Kashmir Moments (Media 1)">
              <video src="/images/media_1.mp4" muted loop playsinline preload="metadata" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition"></video>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-1.5 left-2 right-2 text-white text-[10px] font-bold truncate flex items-center space-x-1 pointer-events-none">
                <i data-lucide="play" class="w-3 h-3 text-brand-sky shrink-0"></i>
                <span class="truncate">Media 1</span>
              </div>
            </button>

            <!-- Video 2 (media_1_2.mp4) -->
            <button type="button" class="about-video-thumb relative rounded-2xl overflow-hidden border-2 border-slate-200 shadow group text-left h-20 sm:h-22 bg-brand-navy transition-all hover:border-brand-blue focus:outline-none" data-video="/images/media_1_2.mp4" data-title="Scenic Mountain Valleys (Media 1_2)">
              <video src="/images/media_1_2.mp4" muted loop playsinline preload="none" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition"></video>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-1.5 left-2 right-2 text-white text-[10px] font-bold truncate flex items-center space-x-1 pointer-events-none">
                <i data-lucide="play" class="w-3 h-3 text-brand-sky shrink-0"></i>
                <span class="truncate">Media 1_2</span>
              </div>
            </button>

            <!-- Video 3 (media_1_1.mp4) -->
            <button type="button" class="about-video-thumb relative rounded-2xl overflow-hidden border-2 border-slate-200 shadow group text-left h-20 sm:h-22 bg-brand-navy transition-all hover:border-brand-blue focus:outline-none" data-video="/images/media_1_1.mp4" data-title="Alpine Tour Moments (Media 1_1)">
              <video src="/images/media_1_1.mp4" muted loop playsinline preload="none" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition"></video>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-1.5 left-2 right-2 text-white text-[10px] font-bold truncate flex items-center space-x-1 pointer-events-none">
                <i data-lucide="play" class="w-3 h-3 text-brand-sky shrink-0"></i>
                <span class="truncate">Media 1_1</span>
              </div>
            </button>

            <!-- Video 4 (CUTE.mp4) -->
            <button type="button" class="about-video-thumb relative rounded-2xl overflow-hidden border-2 border-slate-200 shadow group text-left h-20 sm:h-22 bg-brand-navy transition-all hover:border-brand-blue focus:outline-none" data-video="/images/CUTE.mp4" data-title="Special Travel Memories (CUTE)">
              <video src="/images/CUTE.mp4" muted loop playsinline preload="none" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition"></video>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-1.5 left-2 right-2 text-white text-[10px] font-bold truncate flex items-center space-x-1 pointer-events-none">
                <i data-lucide="play" class="w-3 h-3 text-brand-sky shrink-0"></i>
                <span class="truncate">CUTE</span>
              </div>
            </button>

          </div>

          <!-- Serving Since Badge (Positioned cleanly below videos with zero overlap) -->
          <div class="mt-4 bg-white border border-brand-border p-3.5 sm:p-4 rounded-2xl shadow-sm flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-9 h-9 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">
                2016
              </div>
              <div>
                <span class="text-[11px] font-bold text-brand-navy uppercase tracking-wider block">Serving Since 2016</span>
                <p class="font-serif text-xs font-bold text-brand-blue">"Where Your Travel Dreams Take Flight"</p>
              </div>
            </div>
            <span class="hidden sm:inline-flex items-center space-x-1 text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100 shrink-0">
              <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
              <span>Local Destination Host</span>
            </span>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================
       ANIMATED STATS & TRUST STRIP (CountUp Animation)
       ======================================================== -->
  <section class="py-12 bg-brand-navy text-white border-y border-white/10 reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-white/10">
        <div class="space-y-1 pt-3 md:pt-0">
          <div class="font-serif text-3xl sm:text-5xl font-bold text-brand-sky" data-count-to="2016">2016</div>
          <p class="text-xs uppercase tracking-wider text-slate-300 font-medium">Serving Travelers Since</p>
        </div>
        <div class="space-y-1 pt-3 md:pt-0">
          <div class="font-serif text-3xl sm:text-5xl font-bold text-brand-sky" data-count-to="1200" data-count-suffix="+">1200+</div>
          <p class="text-xs uppercase tracking-wider text-slate-300 font-medium">Happy Travelers Hosted</p>
        </div>
        <div class="space-y-1 pt-3 md:pt-0">
          <div class="font-serif text-3xl sm:text-5xl font-bold text-amber-400" data-count-to="4.9" data-count-suffix="★">4.9★</div>
          <p class="text-xs uppercase tracking-wider text-slate-300 font-medium">Average Guest Rating</p>
        </div>
        <div class="space-y-1 pt-3 md:pt-0">
          <div class="font-serif text-3xl sm:text-5xl font-bold text-brand-sky" data-count-to="10" data-count-suffix="+">10+</div>
          <p class="text-xs uppercase tracking-wider text-slate-300 font-medium">Specialized Tour Services</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       SECTION: OUR MISSION & OUR VISION (PURPOSE & DIRECTION)
       ======================================================== -->
  <section class="py-10 sm:py-20 bg-brand-offwhite border-y border-brand-border" id="purposeDirectionSection">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-16">
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3 py-0.5 sm:px-3.5 sm:py-1 rounded-full">
          PURPOSE & DIRECTION
        </span>
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-brand-navy mt-2 sm:mt-4 mb-1.5 sm:mb-3">
          Our Mission & Vision
        </h2>
        <p class="text-xs sm:text-base text-brand-muted leading-snug sm:leading-relaxed">
          The guiding values and commitments that drive every journey we organize.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8 max-w-5xl mx-auto">
        
        <!-- Mission Card -->
        <div class="bg-white p-5 sm:p-10 rounded-2xl sm:rounded-3xl border border-brand-border shadow-sm card-hover flex flex-col justify-between text-center md:text-left">
          <div class="flex flex-col items-center md:items-start">
            <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-blue-50 text-brand-blue flex items-center justify-center mb-3 sm:mb-6 shadow-xs mx-auto md:mx-0">
              <i data-lucide="target" class="w-5 h-5 sm:w-7 sm:h-7"></i>
            </div>
            <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-brand-blue block text-center md:text-left">GUIDING PURPOSE</span>
            <h3 class="font-serif text-xl sm:text-3xl font-bold text-brand-navy mt-1 mb-2 sm:mb-4 text-center md:text-left">
              Our Mission
            </h3>
            <p class="text-brand-muted text-xs sm:text-base leading-relaxed text-center md:text-left">
              Our mission is to make travel accessible, comfortable, and memorable for everyone. We strive to provide quality services, personalised travel experiences, transparent communication, and dependable assistance at every step.
            </p>
          </div>

          <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t border-slate-100 flex items-center justify-center md:justify-start space-x-2 text-[11px] sm:text-xs font-bold text-brand-blue">
            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
            <span>Accessible • Comfortable • Memorable</span>
          </div>
        </div>

        <!-- Vision Card -->
        <div class="bg-white p-5 sm:p-10 rounded-2xl sm:rounded-3xl border border-brand-border shadow-sm card-hover flex flex-col justify-between text-center md:text-left">
          <div class="flex flex-col items-center md:items-start">
            <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-sky-50 text-brand-blue flex items-center justify-center mb-3 sm:mb-6 shadow-xs mx-auto md:mx-0">
              <i data-lucide="compass" class="w-5 h-5 sm:w-7 sm:h-7"></i>
            </div>
            <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-brand-blue block text-center md:text-left">FUTURE ASPIRATION</span>
            <h3 class="font-serif text-xl sm:text-3xl font-bold text-brand-navy mt-1 mb-2 sm:mb-4 text-center md:text-left">
              Our Vision
            </h3>
            <p class="text-brand-muted text-xs sm:text-base leading-relaxed text-center md:text-left">
              To become a trusted name in the travel industry by building lasting relationships with our customers, delivering exceptional experiences, and introducing people to the beauty and diversity of destinations across India.
            </p>
          </div>

          <div class="pt-4 sm:pt-6 mt-4 sm:mt-6 border-t border-slate-100 flex items-center justify-center md:justify-start space-x-2 text-[11px] sm:text-xs font-bold text-brand-blue">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
            <span>Trust • Relationships • Exceptional Experiences</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================
       SECTION: WHAT WE OFFER
       ======================================================== -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full">
          OUR SERVICES & DESTINATIONS
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-navy mt-4 mb-4">
          What We Offer
        </h2>
        <p class="text-sm sm:text-base text-brand-muted">
          Explore our wide range of curated packages and seamless travel arrangements designed around your lifestyle.
        </p>
      </div>

      <!-- 10 Offerings Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- 1. Kashmir Holiday Packages -->
        <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border card-hover flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white text-brand-blue flex items-center justify-center mb-4 shadow-sm border border-slate-100">
              <i data-lucide="mountain-snow" class="w-5 h-5"></i>
            </div>
            <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">Kashmir Holiday Packages</h4>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Explore Srinagar, Gulmarg, Pahalgam, Sonamarg, Doodhpathri, Yusmarg, and other beautiful destinations.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60">
            <a href="/packages" class="text-xs font-semibold text-brand-blue hover:underline flex items-center space-x-1">
              <span>View Packages</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <!-- 2. Honeymoon Packages -->
        <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border card-hover flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white text-rose-500 flex items-center justify-center mb-4 shadow-sm border border-slate-100">
              <i data-lucide="heart" class="w-5 h-5"></i>
            </div>
            <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">Honeymoon Packages</h4>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Specially planned romantic holidays for couples.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60">
            <a href="/packages" class="text-xs font-semibold text-brand-blue hover:underline flex items-center space-x-1">
              <span>Romantic Getaways</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <!-- 3. Family Tours -->
        <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border card-hover flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white text-brand-blue flex items-center justify-center mb-4 shadow-sm border border-slate-100">
              <i data-lucide="users" class="w-5 h-5"></i>
            </div>
            <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">Family Tours</h4>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Comfortable and enjoyable holidays for families.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60">
            <a href="/packages" class="text-xs font-semibold text-brand-blue hover:underline flex items-center space-x-1">
              <span>Family Itineraries</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <!-- 4. Adventure Tours -->
        <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border card-hover flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white text-emerald-600 flex items-center justify-center mb-4 shadow-sm border border-slate-100">
              <i data-lucide="compass" class="w-5 h-5"></i>
            </div>
            <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">Adventure Tours</h4>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Experience mountains, valleys, trekking, snow activities, and nature.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60">
            <a href="/experiences" class="text-xs font-semibold text-brand-blue hover:underline flex items-center space-x-1">
              <span>View Activities</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <!-- 5. Pilgrimage Tours -->
        <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border card-hover flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white text-amber-600 flex items-center justify-center mb-4 shadow-sm border border-slate-100">
              <i data-lucide="sun" class="w-5 h-5"></i>
            </div>
            <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">Pilgrimage Tours</h4>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Carefully planned spiritual journeys to important religious destinations.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60">
            <a href="/contact" class="text-xs font-semibold text-brand-blue hover:underline flex items-center space-x-1">
              <span>Enquire Spiritual Tours</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <!-- 6. Ladakh Tours -->
        <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border card-hover flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-white text-indigo-600 flex items-center justify-center mb-4 shadow-sm border border-slate-100">
              <i data-lucide="map-pin" class="w-5 h-5"></i>
            </div>
            <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">Ladakh Tours</h4>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Discover breathtaking mountain landscapes and unforgettable road journeys.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60">
            <a href="/contact" class="text-xs font-semibold text-brand-blue hover:underline flex items-center space-x-1">
              <span>Explore Ladakh</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
