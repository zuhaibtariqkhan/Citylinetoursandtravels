<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=1800&q=80" 
           alt="Kashmir Landscapes" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-4 py-1.5 rounded-full inline-block mb-3">
        PARADISE ON EARTH
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-4">
        Explore Kashmir's Crown Jewels
      </h1>
      <p class="text-base text-slate-200 max-w-2xl mx-auto leading-relaxed">
        From the floating water life of Srinagar to the snowfields of Gulmarg, the pine valleys of Pahalgam, and the untouched frontier of Gurez.
      </p>
    </div>
  </section>

  <!-- Destinations Grid Section -->
  <section class="py-16 bg-brand-offwhite">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Interactive Regional Mountain Map -->
      <div class="mb-14">
        <%- include('partials/kashmir-map') %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% destinations.forEach(dest => { %>
          <div class="bg-white rounded-2xl border border-brand-border overflow-hidden card-hover flex flex-col shadow-sm">
            
            <div class="relative h-64 img-zoom-container">
              <img src="<%= dest.image %>" alt="<%= dest.name %>" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              
              <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-brand-navy text-[11px] font-bold px-2.5 py-1 rounded-full">
                <%= dest.suggestedDuration %>
              </div>

              <div class="absolute bottom-4 left-4 text-white">
                <span class="text-xs uppercase tracking-wider text-brand-sky font-semibold block mb-0.5">Destination</span>
                <h3 class="font-serif text-2xl font-bold text-white"><%= dest.name %></h3>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <p class="text-xs italic text-brand-blue font-medium mb-2">"<%= dest.tagline %>"</p>
                <p class="text-sm text-brand-muted leading-relaxed line-clamp-3 mb-4">
                  <%= dest.shortDescription %>
                </p>

                <!-- Best time badge -->
                <div class="bg-brand-light p-3 rounded-xl mb-4 text-xs text-brand-navy">
                  <div class="flex items-center space-x-1.5 font-semibold text-brand-blue mb-1">
                    <i data-lucide="sun" class="w-3.5 h-3.5"></i>
                    <span>Best Time to Visit:</span>
                  </div>
                  <p class="text-[11px] text-brand-muted line-clamp-1"><%= dest.bestTimeToVisit %></p>
                </div>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <a href="/destinations/<%= dest.slug %>" class="text-xs font-semibold text-brand-navy hover:text-brand-blue flex items-center space-x-1 group">
                  <span>Explore <%= dest.name %></span>
                  <i data-lucide="arrow-right" class="w-3.5 h-3.5 arrow-hover"></i>
                </a>
                <button class="enquire-now-btn btn-primary px-3 py-1.5 rounded-lg text-xs font-semibold" data-destination="<%= dest.name %>">
                  Plan Trip
                </button>
              </div>

            </div>

          </div>
        <% }) %>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>

