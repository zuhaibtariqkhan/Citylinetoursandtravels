<!-- ========================================================
     INTERACTIVE KASHMIR DESTINATION & ROUTE MAP
     ======================================================== -->
<% const mappedDestinations = destinations.filter(d => d.mapCoords && d.region === 'Kashmir'); %>

<div class="bg-[#102A43] text-white rounded-3xl p-5 sm:p-7 lg:p-9 shadow-2xl border border-white/10 my-4 sm:my-6" id="kashmirMapContainer">
  
  <!-- Map Section Header -->
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-6 border-b border-white/10 mb-6">
    <div>
      <div class="inline-flex items-center space-x-2 bg-brand-blue/30 border border-brand-sky/40 text-brand-sky text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
        <i data-lucide="map" class="w-3.5 h-3.5"></i>
        <span>INTERACTIVE DESTINATION MAP</span>
      </div>
      <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight">
        Navigate Kashmir's Crown Valleys
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 mt-2 max-w-2xl leading-relaxed">
        Click any valley pin on the mountain map or choose a destination chip below to explore elevation altitudes, scenic highway distances from Srinagar, top highlights, and matching tour packages.
      </p>
    </div>

    <!-- Highway Status Badge & Link to All 29 Destinations -->
    <div class="flex flex-col items-start lg:items-end gap-2 shrink-0">
      <div class="flex items-center space-x-2 bg-brand-blue/25 border border-brand-sky/40 text-brand-sky text-xs px-3.5 py-1.5 rounded-xl font-medium">
        <i data-lucide="info" class="w-3.5 h-3.5 text-cyan-300"></i>
        <span>Scenic Mountain Corridors • Subject to Weather</span>
      </div>
      <a href="/destinations" class="text-xs text-brand-sky hover:text-white transition flex items-center space-x-1 font-semibold">
        <span>View All 29 Destinations (Kashmir, Jammu & Ladakh)</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>
  </div>

  <!-- Quick Destination Selector Chips (7 Signature Kashmir Valleys) -->
  <div class="flex items-center space-x-2 overflow-x-auto pb-3 mb-6 scrollbar-thin" id="mapChipBar">
    <% mappedDestinations.forEach((d, idx) => { %>
      <button type="button" 
              class="map-dest-chip px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center space-x-2 border <%= idx === 0 ? 'bg-[#145DA0] text-white border-brand-sky shadow-md scale-105' : 'bg-white/10 hover:bg-white/20 text-slate-200 border-white/10' %>" 
              data-slug="<%= d.slug %>">
        <span class="w-2 h-2 rounded-full <%= idx === 0 ? 'bg-white' : 'bg-brand-sky' %>"></span>
        <span><%= d.name %></span>
        <span class="text-[10px] opacity-80">(<%= d.altitude ? d.altitude.split('/')[0].trim() : '' %>)</span>
      </button>
    <% }) %>
  </div>

  <!-- Interactive 2-Column Split: Vector Topographic Map + Live Destination Spotlight Card -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
    
    <!-- LEFT: Interactive Vector Topographic Mountain Map (7 Cols) -->
    <div class="lg:col-span-7 bg-[#0B1B2B] rounded-2xl p-4 sm:p-5 border border-white/10 relative overflow-hidden flex flex-col justify-between shadow-inner min-h-[440px] sm:min-h-[500px]">
      
      <!-- Top Map Legend & Compass -->
      <div class="relative z-10 flex items-center justify-between text-[11px] text-slate-300 pb-2">
        <div class="flex items-center space-x-3">
          <span class="flex items-center space-x-1.5">
            <span class="w-3.5 h-0.5 bg-brand-sky inline-block border-t border-dashed border-brand-sky"></span>
            <span>Scenic Highway</span>
          </span>
          <span class="flex items-center space-x-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-sky inline-block"></span>
            <span>Valley Pin</span>
          </span>
        </div>
        <div class="flex items-center space-x-1 bg-white/5 px-2.5 py-1 rounded-md text-[10px] text-brand-sky font-mono border border-white/10">
          <i data-lucide="compass" class="w-3 h-3"></i>
          <span>PIR PANJAL & HIMALAYAS</span>
        </div>
      </div>

      <!-- SVG Map Canvas with Mountain Ridges, Rivers & Animated Roads -->
      <div class="relative w-full h-[360px] sm:h-[420px] my-auto select-none" id="kashmirMapSvgWrapper">
        <svg viewBox="0 0 1000 650" class="w-full h-full preserve-3d" style="filter: drop-shadow(0 4px 12px rgba(0,0,0,0.5));">
          <defs>
            <!-- Background Gradients -->
            <radialGradient id="valleyGlow" cx="50%" cy="55%" r="65%">
              <stop offset="0%" stop-color="#143152" stop-opacity="0.85"/>
              <stop offset="60%" stop-color="#0c1d33" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#071322" stop-opacity="1"/>
            </radialGradient>
            
            <linearGradient id="routeGold" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8"/>
              <stop offset="50%" stop-color="#60a5fa"/>
              <stop offset="100%" stop-color="#93c5fd"/>
            </linearGradient>

            <filter id="glowEffect" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
          </defs>

          <!-- Mountain Basin Background Shape -->
          <rect width="1000" height="650" rx="20" fill="url(#valleyGlow)"/>

          <!-- Topographic Elevation Contours -->
          <path d="M 80 180 Q 250 80 500 90 T 920 160 Q 940 380 880 540 Q 650 620 450 610 Q 150 600 90 440 Z" 
                fill="none" stroke="#1e3a5f" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.6"/>
          <path d="M 140 240 Q 300 150 500 160 T 840 220 Q 860 400 810 500 Q 600 560 460 550 Q 220 540 150 400 Z" 
                fill="none" stroke="#254d7e" stroke-width="1.5" opacity="0.5"/>
          <path d="M 220 300 Q 350 240 500 250 T 750 290 Q 770 420 720 470 Q 560 510 470 500 Q 280 490 230 390 Z" 
                fill="none" stroke="#336699" stroke-width="1.5" opacity="0.4"/>

          <!-- Mountain Ridge Silhouettes & Labels -->
          <!-- Greater Himalayas (North & East) -->
          <path d="M 380 90 L 410 50 L 440 90 L 480 40 L 530 90 L 580 30 L 640 90 L 700 40 L 760 95 L 820 45 L 880 110" 
                fill="none" stroke="#486581" stroke-width="2" opacity="0.45"/>
          <text x="600" y="55" fill="#829ab1" font-size="11" font-weight="700" letter-spacing="3" opacity="0.7">GREATER HIMALAYAN RANGE</text>

          <!-- Pir Panjal Range (South & West) -->
          <path d="M 80 480 L 120 430 L 160 480 L 200 420 L 250 470 L 300 410 L 360 470 L 420 430 L 480 490" 
                fill="none" stroke="#486581" stroke-width="2" opacity="0.45"/>
          <text x="140" y="605" fill="#829ab1" font-size="11" font-weight="700" letter-spacing="3" opacity="0.7">PIR PANJAL MOUNTAIN RANGE</text>

          <!-- Iconic Peaks Labels -->
          <!-- Apharwat Peak (Gulmarg) -->
          <g transform="translate(180, 270)">
            <polygon points="0,0 -12,20 12,20" fill="#38bdf8" opacity="0.75"/>
            <polygon points="0,0 -5,8 5,8" fill="#ffffff" opacity="0.95"/>
            <text x="16" y="16" fill="#cbd5e1" font-size="10" font-weight="600">Mt. Apharwat (4,390m)</text>
          </g>

          <!-- Kolahoi Peak (Pahalgam/Sonamarg) -->
          <g transform="translate(730, 200)">
            <polygon points="0,0 -14,24 14,24" fill="#38bdf8" opacity="0.75"/>
            <polygon points="0,0 -6,10 6,10" fill="#ffffff" opacity="0.95"/>
            <text x="18" y="18" fill="#cbd5e1" font-size="10" font-weight="600">Kolahoi Glacier (5,425m)</text>
          </g>

          <!-- Habba Khatoon Peak (Gurez) -->
          <g transform="translate(560, 65)">
            <polygon points="0,0 -15,22 15,22" fill="#38bdf8" opacity="0.8"/>
            <polygon points="0,0 -6,9 6,9" fill="#ffffff" opacity="0.95"/>
            <text x="18" y="18" fill="#93c5fd" font-size="10" font-weight="600">Habba Khatoon (3,975m)</text>
          </g>

          <!-- Meandering Glacial Rivers -->
          <!-- Jhelum River (Central Kashmir) -->
          <path d="M 720 540 Q 640 480 560 430 T 480 360 T 380 320 T 260 280 T 140 240" 
                fill="none" stroke="#0284c7" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
          <text x="360" y="305" fill="#38bdf8" font-size="9" font-style="italic" opacity="0.6">Jhelum River & Dal Lake</text>

          <!-- Sindh River (Sonamarg to Srinagar) -->
          <path d="M 700 230 Q 620 280 540 310 T 480 360" 
                fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/>

          <!-- Lidder River (Pahalgam) -->
          <path d="M 740 470 Q 700 480 640 470 T 560 440" 
                fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/>

          <!-- Kishanganga River (Gurez) -->
          <path d="M 460 95 Q 520 100 580 90 T 660 110" 
                fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/>

          <!-- Connecting Scenic Highway Lines radiating from Srinagar (480, 360) -->
          <!-- 1. Srinagar -> Gulmarg (480,360 to 240,338) -->
          <path id="route-gulmarg" class="map-highway-path" 
                d="M 480 360 Q 360 370 240 338" 
                fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.75"/>

          <!-- 2. Srinagar -> Pahalgam (480,360 to 740,468) -->
          <path id="route-pahalgam" class="map-highway-path" 
                d="M 480 360 Q 600 410 740 468" 
                fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.75"/>

          <!-- 3. Srinagar -> Sonamarg (480,360 to 700,228) -->
          <path id="route-sonamarg" class="map-highway-path" 
                d="M 480 360 Q 580 270 700 228" 
                fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.75"/>

          <!-- 4. Srinagar -> Doodhpathri (480,360 to 360,442) -->
          <path id="route-doodhpathri" class="map-highway-path" 
                d="M 480 360 Q 420 410 360 442" 
                fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.75"/>

          <!-- 5. Srinagar -> Yusmarg (480,360 to 460,520) -->
          <path id="route-yusmarg" class="map-highway-path" 
                d="M 480 360 Q 470 450 460 520" 
                fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.75"/>

          <!-- 6. Srinagar -> Gurez Valley across Razdan Pass (480,360 to 520,98) -->
          <path id="route-gurez-valley" class="map-highway-path" 
                d="M 480 360 Q 460 210 520 98" 
                fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="6,4" opacity="0.75"/>
        </svg>

        <!-- HTML Interactive Hotspot Pins Overlay (Strictly for Mapped Valleys) -->
        <% mappedDestinations.forEach((dest, idx) => { 
          const coords = dest.mapCoords || { x: 50, y: 50 };
          const isCapital = dest.slug === 'srinagar';
        %>
          <div class="map-pin-marker absolute transform -translate-x-1/2 -translate-y-1/2 cursor-pointer transition-all duration-300 z-20 group"
               style="left: <%= coords.x %>%; top: <%= coords.y %>%;"
               data-slug="<%= dest.slug %>"
               title="<%= dest.name %> • <%= dest.altitude %>">
            
            <!-- Animated Radar Pulse Rings -->
            <span class="absolute -inset-2.5 rounded-full bg-brand-sky/40 animate-ping opacity-60"></span>
            <span class="absolute -inset-1 rounded-full <%= isCapital ? 'bg-brand-sky/50' : 'bg-brand-sky/30' %>"></span>

            <!-- Main Pin Button -->
            <button type="button" 
                    class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-2xl flex items-center justify-center shadow-lg transition-transform duration-200 group-hover:scale-125 border-2 <%= isCapital ? 'bg-[#145DA0] text-white border-white ring-2 ring-brand-sky' : 'bg-[#102A43] text-white border-brand-sky/80 hover:border-white' %>">
              <% if (dest.slug === 'srinagar') { %>
                <i data-lucide="waves" class="w-4 h-4 sm:w-5 sm:h-5 text-white"></i>
              <% } else if (dest.slug === 'gulmarg') { %>
                <i data-lucide="snowflake" class="w-4 h-4 sm:w-5 sm:h-5 text-cyan-300"></i>
              <% } else if (dest.slug === 'pahalgam') { %>
                <i data-lucide="trees" class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-300"></i>
              <% } else if (dest.slug === 'sonamarg') { %>
                <i data-lucide="mountain" class="w-4 h-4 sm:w-5 sm:h-5 text-sky-200"></i>
              <% } else if (dest.slug === 'doodhpathri') { %>
                <i data-lucide="droplets" class="w-4 h-4 sm:w-5 sm:h-5 text-cyan-200"></i>
              <% } else if (dest.slug === 'gurez-valley') { %>
                <i data-lucide="shield" class="w-4 h-4 sm:w-5 sm:h-5 text-sky-300"></i>
              <% } else { %>
                <i data-lucide="compass" class="w-4 h-4 sm:w-5 sm:h-5 text-brand-sky"></i>
              <% } %>
            </button>

            <!-- Destination Label Tag -->
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1.5 whitespace-nowrap bg-[#102A43]/95 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/20 shadow-md text-center pointer-events-none group-hover:scale-105 transition-transform">
              <span class="block text-[11px] sm:text-xs font-bold text-white leading-tight"><%= dest.name %></span>
              <span class="block text-[9px] text-brand-sky font-mono"><%= dest.altitude ? dest.altitude.split('/')[0].trim() : '' %></span>
            </div>

          </div>
        <% }) %>
      </div>

      <!-- Map Footer Hint -->
      <div class="relative z-10 pt-3 border-t border-white/10 flex flex-wrap items-center justify-between text-[11px] text-slate-400 gap-2">
        <span class="flex items-center space-x-1.5">
          <i data-lucide="mouse-pointer" class="w-3.5 h-3.5 text-brand-sky"></i>
          <span>Click any pin or chip to preview valley details & routes</span>
        </span>
        <span class="text-brand-sky font-medium">Hub: Sheikh Ul-Alam Airport (SXR), Srinagar</span>
      </div>

    </div>

    <!-- RIGHT: Dynamic Destination Spotlight Card (5 Cols) -->
    <div class="lg:col-span-5 bg-white text-brand-navy rounded-2xl p-5 sm:p-6 shadow-xl border border-slate-200 flex flex-col justify-between" id="destSpotlightCard">
      
      <!-- Card Dynamic Content Wrapper -->
      <div id="destSpotlightContent">
        <!-- Default destination is loaded dynamically by JS or first in mapped list -->
        <% const defaultDest = mappedDestinations[0] || {}; %>
        
        <!-- Header & Category Badge -->
        <div class="flex items-start justify-between gap-3 mb-3">
          <div>
            <span class="inline-block bg-[#EAF3FB] text-[#145DA0] text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-1 border border-[#145DA0]/20" id="spotlightBadge">
              <%= defaultDest.badge || 'Crown Capital' %>
            </span>
            <h4 class="font-serif text-2xl sm:text-3xl font-bold text-brand-navy" id="spotlightName">
              <%= defaultDest.name %>
            </h4>
          </div>
          <div class="text-right">
            <span class="text-[10px] text-brand-slate uppercase block font-semibold">Suggested Stay</span>
            <span class="text-xs font-bold text-brand-navy bg-[#EAF3FB] px-2.5 py-1 rounded-lg border border-[#d0e4f7] inline-block" id="spotlightDuration">
              <%= defaultDest.suggestedDuration || '2 to 3 Days' %>
            </span>
          </div>
        </div>

        <!-- Tagline -->
        <p class="text-xs sm:text-sm italic text-[#2563A6] font-serif mb-3 leading-relaxed" id="spotlightTagline">
          "<%= defaultDest.tagline %>"
        </p>

        <!-- Destination Image Preview -->
        <div class="relative h-40 sm:h-44 rounded-xl overflow-hidden shadow-md mb-4 group">
          <img src="<%= defaultDest.image %>" 
               alt="<%= defaultDest.name %>" 
               id="spotlightImage" 
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white text-xs">
            <span class="flex items-center space-x-1 bg-black/40 backdrop-blur-sm px-2.5 py-1 rounded-md">
              <i data-lucide="mountain" class="w-3.5 h-3.5 text-brand-sky"></i>
              <span id="spotlightAltitudeText"><%= defaultDest.altitude || '1,585 m / 5,200 ft' %></span>
            </span>
            <span class="bg-[#145DA0] text-white px-2.5 py-1 rounded-md font-semibold text-[11px]" id="spotlightSeasonBadge">
              All-Season
            </span>
          </div>
        </div>

        <!-- Metrics Strip: Highway & Airport Distance -->
        <div class="bg-[#EAF3FB] rounded-xl p-3 border border-[#d0e4f7] mb-3.5 space-y-1.5 text-xs">
          <div class="flex items-center justify-between">
            <span class="text-[#526579] flex items-center space-x-1.5">
              <i data-lucide="plane-landing" class="w-3.5 h-3.5 text-brand-blue"></i>
              <span>Distance from Airport:</span>
            </span>
            <span class="font-bold text-brand-navy" id="spotlightDistance">
              <%= defaultDest.distanceFromAirport || '12 km • ~25 mins drive' %>
            </span>
          </div>
          <div class="flex items-center justify-between pt-1.5 border-t border-[#d0e4f7]">
            <span class="text-[#526579] flex items-center space-x-1.5">
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-blue"></i>
              <span>Highway Route:</span>
            </span>
            <span class="font-semibold text-brand-blue" id="spotlightHighway">
              <%= defaultDest.routeHighway || 'Central Valley Corridor' %>
            </span>
          </div>
        </div>

        <!-- Key Attractions Highlights -->
        <div class="mb-4">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-slate mb-1.5">Must-Visit Sights</span>
          <div class="flex flex-wrap gap-1.5" id="spotlightAttractions">
            <% (defaultDest.attractions || []).slice(0, 4).forEach(att => { %>
              <span class="text-[11px] bg-[#EAF3FB] text-brand-navy px-2.5 py-1 rounded-lg border border-[#145DA0]/20 font-medium">
                <%= att %>
              </span>
            <% }) %>
          </div>
        </div>

      </div>

      <!-- Action Buttons -->
      <div class="pt-3 border-t border-slate-200 space-y-2">
        <a href="/destinations/<%= defaultDest.slug %>" 
           id="spotlightDetailLink" 
           class="w-full btn-primary py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-md">
          <span>Explore Full <%= defaultDest.name %> Guide</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>

        <div class="grid grid-cols-2 gap-2 text-xs">
          <a href="/packages" class="btn-outline py-2 rounded-xl font-semibold text-center flex items-center justify-center space-x-1">
            <i data-lucide="package" class="w-3.5 h-3.5 text-brand-blue"></i>
            <span>View Packages</span>
          </a>
          <a href="https://wa.me/916006725007?text=Hi%20City%20Line%20Tours,%20I%20am%20interested%20in%20planning%20a%20trip%20to%20<%= defaultDest.name %>" 
             target="_blank" 
             id="spotlightWhatsappLink" 
             class="bg-[#25D366] hover:bg-[#20ba59] text-white py-2 rounded-xl font-semibold text-center transition flex items-center justify-center space-x-1 shadow-sm">
            <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
            <span>WhatsApp Quote</span>
          </a>
        </div>
      </div>

    </div>

  </div>

</div>

<!-- Interactive Map Client Script -->
<script>
  (function initKashmirInteractiveMap() {
    // Destinations data serialized from server (Mapped Kashmir Valleys)
    const destinationsData = <%- JSON.stringify(mappedDestinations) %>;
    if (!destinationsData || !destinationsData.length) return;

    const mapPins = document.querySelectorAll('.map-pin-marker');
    const chipBtns = document.querySelectorAll('.map-dest-chip');
    const highwayPaths = document.querySelectorAll('.map-highway-path');

    // Spotlight card DOM elements
    const nameEl = document.getElementById('spotlightName');
    const badgeEl = document.getElementById('spotlightBadge');
    const taglineEl = document.getElementById('spotlightTagline');
    const durationEl = document.getElementById('spotlightDuration');
    const imageEl = document.getElementById('spotlightImage');
    const altitudeEl = document.getElementById('spotlightAltitudeText');
    const distanceEl = document.getElementById('spotlightDistance');
    const highwayEl = document.getElementById('spotlightHighway');
    const attractionsEl = document.getElementById('spotlightAttractions');
    const detailLinkEl = document.getElementById('spotlightDetailLink');
    const whatsappLinkEl = document.getElementById('spotlightWhatsappLink');

    function selectDestination(slug) {
      const dest = destinationsData.find(d => d.slug === slug);
      if (!dest) return;

      // 1. Update Chip buttons styling
      chipBtns.forEach(btn => {
        if (btn.getAttribute('data-slug') === slug) {
          btn.className = 'map-dest-chip px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center space-x-2 border bg-[#145DA0] text-white border-brand-sky shadow-md scale-105';
          const dot = btn.querySelector('span');
          if (dot) dot.className = 'w-2 h-2 rounded-full bg-white';
        } else {
          btn.className = 'map-dest-chip px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center space-x-2 border bg-white/10 hover:bg-white/20 text-slate-200 border-white/10';
          const dot = btn.querySelector('span');
          if (dot) dot.className = 'w-2 h-2 rounded-full bg-brand-sky';
        }
      });

      // 2. Update Map Pin styling
      mapPins.forEach(pin => {
        const pinBtn = pin.querySelector('button');
        if (pin.getAttribute('data-slug') === slug) {
          pin.classList.add('scale-125', 'z-30');
          if (pinBtn) {
            pinBtn.classList.add('ring-4', 'ring-cyan-300', 'border-white');
          }
        } else {
          pin.classList.remove('scale-125', 'z-30');
          if (pinBtn) {
            pinBtn.classList.remove('ring-4', 'ring-cyan-300');
          }
        }
      });

      // 3. Highlight corresponding Highway Route on SVG
      highwayPaths.forEach(path => {
        if (path.id === 'route-' + slug) {
          path.setAttribute('stroke', '#ffffff');
          path.setAttribute('stroke-width', '4');
          path.setAttribute('opacity', '1');
        } else {
          path.setAttribute('stroke', '#38bdf8');
          path.setAttribute('stroke-width', '2.5');
          path.setAttribute('opacity', '0.65');
        }
      });

      // 4. Update Spotlight Card content smoothly
      if (nameEl) nameEl.textContent = dest.name;
      if (badgeEl) badgeEl.textContent = dest.badge || 'Kashmir Valley';
      if (taglineEl) taglineEl.textContent = '"' + dest.tagline + '"';
      if (durationEl) durationEl.textContent = dest.suggestedDuration || '2 to 3 Days';
      if (imageEl) {
        imageEl.src = dest.image;
        imageEl.alt = dest.name;
      }
      if (altitudeEl) altitudeEl.textContent = dest.altitude || 'Mountain Valley';
      if (distanceEl) distanceEl.textContent = dest.distanceFromAirport || 'Srinagar Corridor';
      if (highwayEl) highwayEl.textContent = dest.routeHighway || 'Scenic Highway';

      if (attractionsEl) {
        attractionsEl.innerHTML = '';
        (dest.attractions || []).slice(0, 4).forEach(att => {
          const span = document.createElement('span');
          span.className = 'text-[11px] bg-[#EAF3FB] text-brand-navy px-2.5 py-1 rounded-lg border border-[#145DA0]/20 font-medium';
          span.textContent = att;
          attractionsEl.appendChild(span);
        });
      }

      if (detailLinkEl) {
        detailLinkEl.href = '/destinations/' + dest.slug;
        detailLinkEl.querySelector('span').textContent = 'Explore Full ' + dest.name + ' Guide';
      }

      if (whatsappLinkEl) {
        whatsappLinkEl.href = 'https://wa.me/916006725007?text=' + encodeURIComponent('Hi City Line Tours, I am exploring your interactive map and would like a customized itinerary covering ' + dest.name + ' (' + (dest.suggestedDuration || 'Kashmir tour') + ').');
      }

      // Re-initialize Lucide icons if available
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    }

    // Attach click events to pins and chips
    mapPins.forEach(pin => {
      pin.addEventListener('click', () => {
        const slug = pin.getAttribute('data-slug');
        if (slug) selectDestination(slug);
      });
    });

    chipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        if (slug) selectDestination(slug);
      });
    });

    // Initial highlight for first destination
    selectDestination(destinationsData[0].slug);
  })();
</script>
