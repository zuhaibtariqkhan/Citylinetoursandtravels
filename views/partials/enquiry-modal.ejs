<!-- Universal Enquiry Modal -->
<div id="enquiryModal" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-brand-border overflow-hidden">
    
    <!-- Modal Header -->
    <div class="bg-brand-navy p-4 sm:p-6 text-white flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-brand-blue flex items-center justify-center text-white shrink-0">
          <i data-lucide="send" class="w-5 h-5"></i>
        </div>
        <div>
          <h3 id="modalTargetTitle" class="font-serif text-base sm:text-lg font-bold text-white">Plan Your Kashmir Journey</h3>
          <p class="text-xs text-brand-sky">City Line Tours And Travels • Fast Response</p>
        </div>
      </div>
      <button type="button" aria-label="Close enquiry modal" class="close-modal-btn w-9 h-9 flex items-center justify-center text-slate-300 hover:text-white rounded-lg hover:bg-white/10 transition">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Modal Form Body -->
    <div class="p-4 sm:p-6">
      <form id="modalEnquiryForm" class="ajax-enquiry-form space-y-3.5 sm:space-y-4">
        <input type="hidden" name="source" value="Package / Quick Modal">
        <input type="hidden" id="modalPackageTitle" name="packageTitle" value="">
        <input type="hidden" id="modalDestination" name="destination" value="">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label for="modalName" class="block text-xs font-semibold text-brand-navy mb-1">Full Name <span class="text-red-500">*</span></label>
            <div class="relative">
              <i data-lucide="user" class="w-4 h-4 text-brand-muted absolute left-3 top-3.5"></i>
              <input type="text" id="modalName" name="name" required placeholder="e.g. Rahul Sharma" class="form-input pl-9 text-sm min-h-[44px]">
            </div>
          </div>
          <div>
            <label for="modalPhone" class="block text-xs font-semibold text-brand-navy mb-1">Phone Number <span class="text-red-500">*</span></label>
            <div class="relative">
              <i data-lucide="phone" class="w-4 h-4 text-brand-muted absolute left-3 top-3.5"></i>
              <input type="tel" id="modalPhone" name="phone" required placeholder="e.g. +91 98765 43210" class="form-input pl-9 text-sm min-h-[44px]">
            </div>
          </div>
        </div>

        <div>
          <label for="modalEmail" class="block text-xs font-semibold text-brand-navy mb-1">Email Address <span class="text-slate-400 font-normal">(To receive detailed itinerary)</span></label>
          <div class="relative">
            <i data-lucide="mail" class="w-4 h-4 text-brand-muted absolute left-3 top-3.5"></i>
            <input type="email" id="modalEmail" name="email" placeholder="e.g. rahul@example.com" class="form-input pl-9 text-sm min-h-[44px]">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label for="modalTravelDate" class="block text-xs font-semibold text-brand-navy mb-1">Travel Date</label>
            <div class="relative">
              <i data-lucide="calendar" class="w-4 h-4 text-brand-muted absolute left-3 top-3.5"></i>
              <input type="date" id="modalTravelDate" name="travelDate" class="form-input pl-9 text-sm min-h-[44px]">
            </div>
          </div>
          <div>
            <label for="modalTravellers" class="block text-xs font-semibold text-brand-navy mb-1">No. of Travellers</label>
            <div class="relative">
              <i data-lucide="users" class="w-4 h-4 text-brand-muted absolute left-3 top-3.5"></i>
              <select id="modalTravellers" name="travellers" class="form-input pl-9 text-sm min-h-[44px]">
                <option value="2 Adults">2 Adults (Couple)</option>
                <option value="Family (3-4)">Family (3-4 Persons)</option>
                <option value="Group (5+)">Group (5+ Persons)</option>
                <option value="Solo Traveller">Solo Traveller</option>
              </select>
            </div>
          </div>
        </div>

        <div>
          <label for="modalMessage" class="block text-xs font-semibold text-brand-navy mb-1">Special Requirements or Questions</label>
          <textarea id="modalMessage" name="message" rows="3" placeholder="Tell us if you want houseboat night, Gondola tickets, specific hotels or dietary preferences..." class="form-input text-sm"></textarea>
        </div>

        <div class="pt-1 sm:pt-2">
          <button type="submit" class="w-full btn-primary py-3 rounded-xl font-semibold text-sm flex items-center justify-center space-x-2 shadow-md min-h-[44px]">
            <i data-lucide="send" class="w-4 h-4"></i>
            <span>Send My Enquiry & Get Quotation</span>
          </button>
          <p class="text-[11px] text-center text-brand-muted mt-2">
            🔒 Your details are secure. We respect your privacy and never spam.
          </p>
        </div>
      </form>
    </div>

  </div>
</div>

