<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>
  <%= pageTitle || 'City Line Tours And Travels | Kashmir Tourism' %>
</title>
<meta name="description"
  content="Discover Kashmir with City Line Tours And Travels. Thoughtfully planned holiday packages, luxury houseboats, Shikara rides, Gulmarg Gondola, and personalized tour itineraries.">
<meta name="keywords"
  content="Kashmir tour packages, Srinagar houseboats, Gulmarg Gondola, Pahalgam holidays, Sonamarg, Kashmir travel agency">

<!-- Favicon -->
<link rel="icon" type="image/jpeg" href="/images/LOGO.jpeg">
<link rel="apple-touch-icon" href="/images/LOGO.jpeg">

<!-- Google Fonts: Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          brand: {
            blue: '#145DA0',
            navy: '#0B2545',
            royal: '#2563EB',
            sky: '#60A5FA',
            light: '#EFF6FF',
            offwhite: '#F8FAFC',
            text: '#172B4D',
            muted: '#64748B',
            border: '#E2E8F0'
          }
        },
        fontFamily: {
          sans: ['Inter', 'sans-serif'],
          serif: ['Georgia', 'Times New Roman', 'serif']
        }
      }
    }
  }
</script>

<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>

<!-- Brand Custom Styles -->
<link rel="stylesheet" href="/css/style.css">