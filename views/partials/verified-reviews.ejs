<!-- ========================================================
     GUEST REVIEWS & TRAVELER STORIES SHOWCASE
     ======================================================== -->
<section class="py-8 sm:py-16 bg-white" id="verifiedReviewsSection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-5 sm:mb-10 reveal">
      <div class="inline-flex items-center space-x-2 bg-brand-light text-brand-blue border border-brand-border text-xs font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider mb-2.5">
        <i data-lucide="message-square" class="w-3.5 h-3.5 text-brand-blue"></i>
        <span>TRAVELER REFLECTIONS • GUEST STORIES</span>
      </div>
      <h2 class="font-serif text-xl sm:text-3xl font-bold text-brand-navy mb-1.5 sm:mb-3">
        Memories Shared by Our Travelers
      </h2>
      <p class="text-xs sm:text-base text-brand-muted leading-snug sm:leading-relaxed">
        Thoughtful hospitality, genuine local care, and memorable mountain journeys as shared by travelers who explored Kashmir with our team.
      </p>
    </div>

    <!-- Rating Summary Scorecard Banner -->
    <div class="bg-[#102A43] text-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 lg:p-9 mb-5 sm:mb-10 shadow-lg sm:shadow-xl border border-white/10 reveal">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
        
        <!-- Score Column (5 Cols) -->
        <div class="lg:col-span-5 text-center lg:text-left lg:border-r border-white/10 lg:pr-8">
          <div class="flex items-center justify-center lg:justify-start space-x-3 mb-2">
            <span class="font-serif text-3xl sm:text-5xl font-extrabold text-amber-400">4.9</span>
            <div>
              <div class="flex items-center space-x-1 text-amber-400 text-base">
                <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
              </div>
              <span class="text-xs text-slate-300 font-medium">Guest Satisfaction Rating</span>
            </div>
          </div>
          <p class="text-xs text-slate-300 mb-3 leading-relaxed">
            Consistently appreciated for punctual airport coordination, courteous mountain chauffeurs, and authentic houseboat hospitality.
          </p>
          <div class="inline-flex items-center space-x-2 bg-white/10 px-3 py-1 rounded-full text-xs text-brand-sky border border-white/15">
            <i data-lucide="shield-check" class="w-3.5 h-3.5 text-cyan-300"></i>
            <span class="font-medium">Local Srinagar Host • Serving Since 2016</span>
          </div>
        </div>

        <!-- 3 Authentic Hospitality Pillars (7 Cols) -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-3.5 text-xs">
          
          <div class="bg-white/5 rounded-2xl p-4 border border-white/10">
            <div class="flex items-center space-x-1.5 text-brand-sky font-bold mb-1">
              <i data-lucide="user-check" class="w-4 h-4"></i>
              <span>Local Chauffeurs</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-snug">Courteous, verified mountain drivers experienced with snow routes.</p>
          </div>

          <div class="bg-white/5 rounded-2xl p-4 border border-white/10">
            <div class="flex items-center space-x-1.5 text-cyan-300 font-bold mb-1">
              <i data-lucide="shield-check" class="w-4 h-4"></i>
              <span>Direct Coordination</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-snug">Palpora, Srinagar headquarters with dedicated on-trip phone assistance.</p>
          </div>

          <div class="bg-white/5 rounded-2xl p-4 border border-white/10">
            <div class="flex items-center space-x-1.5 text-amber-300 font-bold mb-1">
              <i data-lucide="badge-percent" class="w-4 h-4"></i>
              <span>Clear Inclusions</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-snug">Upfront day-wise itineraries with all vehicle permits and tolls accounted for.</p>
          </div>

        </div>

      </div>
    </div>

    <!-- Review Category Filter Tabs -->
    <div class="flex items-center justify-center space-x-1.5 sm:space-x-2 overflow-x-auto pb-2 sm:pb-3 mb-4 sm:mb-6 scrollbar-thin" id="reviewFilterBar">
      <button type="button" 
              class="review-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-brand-blue text-white border-brand-blue shadow-sm"
              data-category="all">
        All Feedback (<%= testimonials.length %>)
      </button>
      <button type="button" 
              class="review-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="honeymoon">
        Couples & Honeymoon
      </button>
      <button type="button" 
              class="review-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="family">
        Family Vacations
      </button>
      <button type="button" 
              class="review-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="friends">
        Adventure & Mountain Treks
      </button>
      <button type="button" 
              class="review-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="offbeat">
        Offbeat Valleys
      </button>
    </div>

    <!-- Testimonials Cards Carousel on Mobile, Grid on Desktop -->
    <div class="flex md:grid overflow-x-auto md:overflow-visible md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 pb-3 pt-1 no-scrollbar snap-x snap-mandatory" id="reviewsGrid">
      <% testimonials.slice(0, 6).forEach((rev, idx) => { %>
        <div class="review-card bg-brand-offwhite p-3.5 sm:p-6 rounded-2xl border border-brand-border hover:shadow-md transition-all duration-300 flex flex-col justify-between w-[265px] sm:w-[300px] md:w-auto shrink-0 md:shrink snap-center shadow-xs"
             data-category="<%= rev.category || 'all' %>"
             data-index="<%= idx %>">
          
          <div>
            <!-- Top Badges: Stars + Trip Category -->
            <div class="flex items-center justify-between gap-2 mb-2 sm:mb-3">
              <div class="flex items-center space-x-0.5 text-amber-400">
                <% for (let i = 0; i < (rev.rating || 5); i++) { %>
                  <i data-lucide="star" class="w-3 h-3 sm:w-4 sm:h-4 fill-amber-400 text-amber-400"></i>
                <% } %>
              </div>
              <span class="inline-flex items-center space-x-1 bg-[#EAF3FB] text-brand-navy text-[9px] sm:text-[10px] font-semibold px-2 sm:px-2.5 py-0.5 rounded-full border border-brand-border">
                <span><%= rev.tripType || 'Kashmir Holiday' %></span>
              </span>
            </div>

            <!-- Review Title -->
            <h4 class="font-serif text-xs sm:text-base font-bold text-brand-navy mb-1 line-clamp-1">
              <%= rev.title || 'Exceptional Kashmir Experience' %>
            </h4>

            <!-- Review Narrative -->
            <p class="text-[11px] sm:text-sm text-slate-600 italic leading-relaxed mb-3 line-clamp-3 sm:line-clamp-none">
              "<%= rev.review %>"
            </p>
          </div>

          <!-- Card Footer: Traveler Info + Package -->
          <div class="pt-2.5 sm:pt-3 border-t border-slate-200/70">
            <div class="flex items-center space-x-2.5 mb-2 sm:mb-2.5">
              <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-full <%= rev.avatarColor || 'bg-brand-blue' %> text-white flex items-center justify-center font-bold text-[10px] sm:text-xs shrink-0 shadow-xs">
                <%= rev.name.split(' ').map(n => n.charAt(0)).slice(0, 2).join('') %>
              </div>
              <div class="min-w-0">
                <h5 class="font-bold text-xs sm:text-sm text-brand-navy truncate"><%= rev.name %></h5>
                <p class="text-[10px] sm:text-[11px] text-brand-muted truncate flex items-center space-x-1">
                  <i data-lucide="map-pin" class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-brand-blue"></i>
                  <span><%= rev.location %></span>
                </p>
              </div>
            </div>

            <!-- Traveled Package -->
            <div class="bg-white rounded-lg sm:rounded-xl p-1.5 sm:p-2 border border-brand-border text-[10px] sm:text-[11px] flex items-center justify-between">
              <div class="truncate pr-1.5">
                <span class="text-brand-muted block text-[9px] uppercase font-semibold">Package:</span>
                <% if (rev.packageSlug) { %>
                  <a href="/packages/<%= rev.packageSlug %>" class="text-brand-blue font-semibold hover:underline truncate block">
                    <%= rev.package %>
                  </a>
                <% } else { %>
                  <span class="text-brand-navy font-semibold truncate block"><%= rev.package %></span>
                <% } %>
              </div>
              <span class="text-[9px] sm:text-[10px] text-slate-400 shrink-0 font-medium"><%= rev.date %></span>
            </div>

          </div>

        </div>
      <% }) %>
    </div>

    <!-- Mobile Carousel Navigation Indicators (Mobile only) -->
    <div class="md:hidden flex flex-col items-center justify-center space-y-1.5 mt-3" id="reviewsMobileNav">
      <!-- Dots -->
      <div class="flex items-center space-x-1.5" id="reviewsMobileDots">
        <% testimonials.slice(0, 6).forEach((_, idx) => { %>
          <button type="button" 
                  class="review-dot h-1.5 rounded-full transition-all duration-300 <%= idx === 0 ? 'w-5 bg-brand-blue' : 'w-1.5 bg-slate-300' %>" 
                  data-index="<%= idx %>" 
                  aria-label="Review <%= idx + 1 %>"></button>
        <% }) %>
      </div>
      <!-- Subtle helper text -->
      <div class="inline-flex items-center space-x-1 text-[10px] font-semibold text-brand-blue/80">
        <i data-lucide="move-horizontal" class="w-3 h-3 text-brand-blue"></i>
        <span>Swipe to read traveler memories</span>
      </div>
    </div>

    <!-- Share Your Feedback Direct Box -->
    <div class="mt-6 sm:mt-10 bg-brand-light/60 rounded-xl sm:rounded-2xl p-3.5 sm:p-6 border border-brand-blue/20 text-center max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4">
      <div class="text-center sm:text-left">
        <h4 class="font-serif text-base sm:text-lg font-bold text-brand-navy">Recently Traveled With Us?</h4>
        <p class="text-xs text-brand-muted mt-0.5">
          We welcome your genuine feedback, suggestions, and holiday memories.
        </p>
      </div>
      <a href="https://wa.me/916006725007?text=Hi%20City%20Line%20Tours,%20I%20would%20like%20to%20share%20my%20feedback%20and%20experience%20from%20my%20recent%20Kashmir%20trip!" 
         target="_blank" 
         class="w-full sm:w-auto btn-primary px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-1.5 shadow-sm shrink-0 min-h-[44px]">
        <i data-lucide="message-square-plus" class="w-3.5 h-3.5"></i>
        <span>Share Your Feedback</span>
      </a>
    </div>

  </div>
</section>
