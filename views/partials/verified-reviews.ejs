<!-- ========================================================
     VERIFIED GUEST REVIEWS & STAR RATING SHOWCASE
     ======================================================== -->
<section class="py-20 bg-white" id="verifiedReviewsSection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 reveal">
      <div class="inline-flex items-center space-x-2 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider mb-3">
        <i data-lucide="check-check" class="w-3.5 h-3.5 text-emerald-600"></i>
        <span>100% VERIFIED GUEST EXPERIENCES</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-navy mb-4">
        Loved by Families, Honeymooners & Explorers
      </h2>
      <p class="text-base text-brand-muted leading-relaxed">
        Read real, unedited stories from travelers across India and abroad who experienced paradise with City Line Tours And Travels.
      </p>
    </div>

    <!-- Rating Summary Scorecard Banner -->
    <div class="bg-gradient-to-r from-brand-navy via-[#0f2d4a] to-brand-navy text-white rounded-3xl p-6 sm:p-8 lg:p-10 mb-12 shadow-xl border border-white/10 reveal">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Score Column (4 Cols) -->
        <div class="lg:col-span-4 text-center lg:text-left lg:border-r border-white/10 lg:pr-8">
          <div class="flex items-center justify-center lg:justify-start space-x-3 mb-2">
            <span class="font-serif text-5xl sm:text-6xl font-extrabold text-amber-400">4.9</span>
            <div>
              <div class="flex items-center space-x-1 text-amber-400 text-lg">
                <i data-lucide="star" class="w-5 h-5 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-5 h-5 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-5 h-5 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-5 h-5 fill-amber-400 text-amber-400"></i>
                <i data-lucide="star" class="w-5 h-5 fill-amber-400 text-amber-400"></i>
              </div>
              <span class="text-xs text-slate-300 font-medium">Out of 5.0 Stars</span>
            </div>
          </div>
          <p class="text-xs text-slate-300 mb-4 leading-relaxed">
            Based on <strong class="text-white font-semibold">480+ Verified Guest Ratings</strong> on Google Reviews & TripAdvisor across Kashmir journeys.
          </p>
          <div class="inline-flex items-center space-x-2 bg-white/10 px-3 py-1.5 rounded-full text-xs text-brand-sky">
            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
            <span class="font-semibold">Certificate of Local Excellence</span>
          </div>
        </div>

        <!-- Rating Distribution Bars (4 Cols) -->
        <div class="lg:col-span-4 space-y-2.5 text-xs text-slate-300 lg:border-r border-white/10 lg:pr-8">
          <div class="flex items-center space-x-3">
            <span class="w-12 text-right font-medium">5 Star</span>
            <div class="flex-1 bg-white/10 h-2.5 rounded-full overflow-hidden">
              <div class="bg-amber-400 h-full rounded-full w-[96%]"></div>
            </div>
            <span class="w-9 font-bold text-white">96%</span>
          </div>

          <div class="flex items-center space-x-3">
            <span class="w-12 text-right font-medium">4 Star</span>
            <div class="flex-1 bg-white/10 h-2.5 rounded-full overflow-hidden">
              <div class="bg-amber-400 h-full rounded-full w-[4%]"></div>
            </div>
            <span class="w-9 font-bold text-white">4%</span>
          </div>

          <div class="flex items-center space-x-3">
            <span class="w-12 text-right font-medium">3 Star</span>
            <div class="flex-1 bg-white/10 h-2.5 rounded-full overflow-hidden">
              <div class="bg-amber-400 h-full rounded-full w-0"></div>
            </div>
            <span class="w-9 text-slate-400">0%</span>
          </div>

          <div class="flex items-center space-x-3">
            <span class="w-12 text-right font-medium">2 Star</span>
            <div class="flex-1 bg-white/10 h-2.5 rounded-full overflow-hidden">
              <div class="bg-amber-400 h-full rounded-full w-0"></div>
            </div>
            <span class="w-9 text-slate-400">0%</span>
          </div>

          <div class="flex items-center space-x-3">
            <span class="w-12 text-right font-medium">1 Star</span>
            <div class="flex-1 bg-white/10 h-2.5 rounded-full overflow-hidden">
              <div class="bg-amber-400 h-full rounded-full w-0"></div>
            </div>
            <span class="w-9 text-slate-400">0%</span>
          </div>
        </div>

        <!-- 4 Authentic Pillars (4 Cols) -->
        <div class="lg:col-span-4 grid grid-cols-2 gap-3 text-xs">
          <div class="bg-white/5 rounded-xl p-3 border border-white/5">
            <div class="flex items-center space-x-1.5 text-emerald-400 font-bold mb-1">
              <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              <span>100% Verified</span>
            </div>
            <p class="text-[11px] text-slate-300">Only travelers with confirmed bookings</p>
          </div>

          <div class="bg-white/5 rounded-xl p-3 border border-white/5">
            <div class="flex items-center space-x-1.5 text-brand-sky font-bold mb-1">
              <i data-lucide="user-check" class="w-4 h-4"></i>
              <span>Local Chauffeurs</span>
            </div>
            <p class="text-[11px] text-slate-300">Courteous, vetted mountain drivers</p>
          </div>

          <div class="bg-white/5 rounded-xl p-3 border border-white/5">
            <div class="flex items-center space-x-1.5 text-amber-400 font-bold mb-1">
              <i data-lucide="badge-percent" class="w-4 h-4"></i>
              <span>Zero Hidden Fees</span>
            </div>
            <p class="text-[11px] text-slate-300">All tolls, parking & taxes upfront</p>
          </div>

          <div class="bg-white/5 rounded-xl p-3 border border-white/5">
            <div class="flex items-center space-x-1.5 text-rose-400 font-bold mb-1">
              <i data-lucide="map-pin" class="w-4 h-4"></i>
              <span>Srinagar Office</span>
            </div>
            <p class="text-[11px] text-slate-300">Palpora based local coordination</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Review Category Filter Tabs -->
    <div class="flex items-center justify-center space-x-2 overflow-x-auto pb-4 mb-8 scrollbar-thin" id="reviewFilterBar">
      <button type="button" 
              class="review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-brand-blue text-white border-brand-blue shadow-sm"
              data-category="all">
        All Reviews (<%= testimonials.length %>)
      </button>
      <button type="button" 
              class="review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="honeymoon">
        ❤️ Honeymoon & Couples
      </button>
      <button type="button" 
              class="review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="family">
        👨‍👩‍👧‍👦 Family Vacations
      </button>
      <button type="button" 
              class="review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="friends">
        ⛷️ Friends & Adventure
      </button>
      <button type="button" 
              class="review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200"
              data-category="offbeat">
        🌲 Offbeat Valleys (Gurez/Doodhpathri)
      </button>
    </div>

    <!-- Testimonials Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="reviewsGrid">
      <% testimonials.forEach(rev => { %>
        <div class="review-card bg-brand-offwhite p-6 sm:p-7 rounded-2xl border border-brand-border hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
             data-category="<%= rev.category || 'all' %>">
          
          <div>
            <!-- Top Badges: Stars + Verified Booking -->
            <div class="flex items-center justify-between gap-2 mb-3.5">
              <div class="flex items-center space-x-1 text-amber-400">
                <% for (let i = 0; i < (rev.rating || 5); i++) { %>
                  <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
                <% } %>
              </div>
              <span class="inline-flex items-center space-x-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">
                <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i>
                <span>Verified Trip</span>
              </span>
            </div>

            <!-- Review Title -->
            <h4 class="font-serif text-base font-bold text-brand-navy mb-2 line-clamp-1">
              <%= rev.title || 'Exceptional Kashmir Experience' %>
            </h4>

            <!-- Review Narrative -->
            <p class="text-xs sm:text-sm text-slate-600 italic leading-relaxed mb-5">
              "<%= rev.review %>"
            </p>
          </div>

          <!-- Card Footer: Traveler Info + Package & Helpful Button -->
          <div class="pt-4 border-t border-slate-200/70">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-10 h-10 rounded-full <%= rev.avatarColor || 'bg-brand-blue' %> text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-sm">
                <%= rev.name.split(' ').map(n => n.charAt(0)).slice(0, 2).join('') %>
              </div>
              <div class="min-w-0">
                <h5 class="font-bold text-xs sm:text-sm text-brand-navy truncate"><%= rev.name %></h5>
                <p class="text-[11px] text-brand-muted truncate flex items-center space-x-1">
                  <i data-lucide="map-pin" class="w-3 h-3 text-brand-blue"></i>
                  <span><%= rev.location %></span>
                </p>
              </div>
            </div>

            <!-- Traveled Package & Date -->
            <div class="bg-white rounded-xl p-2.5 border border-brand-border text-[11px] flex items-center justify-between mb-3">
              <div class="truncate pr-2">
                <span class="text-brand-muted block text-[10px] uppercase font-semibold">Package:</span>
                <% if (rev.packageSlug) { %>
                  <a href="/packages/<%= rev.packageSlug %>" class="text-brand-blue font-semibold hover:underline truncate block">
                    <%= rev.package %>
                  </a>
                <% } else { %>
                  <span class="text-brand-navy font-semibold truncate block"><%= rev.package %></span>
                <% } %>
              </div>
              <span class="text-[10px] text-slate-400 shrink-0 font-medium"><%= rev.date %></span>
            </div>

            <!-- Helpful Vote Counter -->
            <div class="flex items-center justify-between text-xs text-brand-muted">
              <span class="text-[11px] text-slate-400"><%= rev.tripType || 'Kashmir Holiday' %></span>
              <button type="button" 
                      class="helpful-vote-btn hover:text-brand-blue flex items-center space-x-1 transition text-[11px]" 
                      data-id="<%= rev.id %>" 
                      data-count="<%= rev.helpfulCount || 20 %>">
                <i data-lucide="thumbs-up" class="w-3 h-3"></i>
                <span>Helpful (<span class="helpful-count"><%= rev.helpfulCount || 20 %></span>)</span>
              </button>
            </div>

          </div>

        </div>
      <% }) %>
    </div>

    <!-- Share Your Feedback Direct Box -->
    <div class="mt-12 bg-brand-light/70 rounded-2xl p-6 sm:p-8 border border-brand-blue/20 text-center max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h4 class="font-serif text-lg font-bold text-brand-navy">Recently Traveled With Us?</h4>
        <p class="text-xs text-brand-muted mt-1">
          Share your feedback, vacation photos, and memories with our team to be featured on our website.
        </p>
      </div>
      <a href="https://wa.me/916006725007?text=Hi%20City%20Line%20Tours,%20I%20would%20like%20to%20share%20my%20review%20and%20photos%20from%20my%20recent%20Kashmir%20trip!" 
         target="_blank" 
         class="btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs flex items-center space-x-1.5 shadow-sm shrink-0">
        <i data-lucide="message-square-plus" class="w-4 h-4"></i>
        <span>Share Your Review</span>
      </a>
    </div>

  </div>
</section>

<!-- Review Category Filter & Helpful Button Script -->
<script>
  (function initVerifiedReviews() {
    const filterBtns = document.querySelectorAll('.review-filter-btn');
    const reviewCards = document.querySelectorAll('.review-card');
    const helpfulBtns = document.querySelectorAll('.helpful-vote-btn');

    // Filter logic
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        // Update active button styles
        filterBtns.forEach(b => {
          if (b === btn) {
            b.className = 'review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-brand-blue text-white border-brand-blue shadow-sm';
          } else {
            b.className = 'review-filter-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border bg-white hover:bg-slate-50 text-slate-600 border-slate-200';
          }
        });

        // Show/hide cards with animation
        reviewCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Helpful voting with localStorage
    helpfulBtns.forEach(btn => {
      const id = btn.getAttribute('data-id');
      const countEl = btn.querySelector('.helpful-count');
      const votedKey = 'cityline_rev_voted_' + id;

      if (localStorage.getItem(votedKey)) {
        btn.classList.add('text-brand-blue', 'font-bold');
      }

      btn.addEventListener('click', () => {
        if (localStorage.getItem(votedKey)) return;
        let count = parseInt(btn.getAttribute('data-count'), 10) || 0;
        count++;
        btn.setAttribute('data-count', count);
        if (countEl) countEl.textContent = count;
        btn.classList.add('text-brand-blue', 'font-bold');
        localStorage.setItem(votedKey, 'true');
      });
    });
  })();
</script>
