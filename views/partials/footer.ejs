                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </a>

            <!-- Facebook -->
            <a href="https://www.facebook.com/share/1JE2hRUfsW/?mibextid=wwXIfr" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="w-11 h-11 rounded-xl bg-[#1877F2] hover:bg-[#166fe5] hover:scale-110 flex items-center justify-center text-white transition-all shadow-md" 
               title="Follow City Line Tours on Facebook"
               aria-label="Facebook">
              <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <!-- Email -->
            <a href="mailto:<%= settings.email || 'askcitylinetravels@gmail.com' %>" 
               class="w-11 h-11 rounded-xl bg-gradient-to-tr from-[#EA4335] to-[#f87171] hover:scale-110 flex items-center justify-center text-white transition-all shadow-md" 
               title="Email us: <%= settings.email || 'askcitylinetravels@gmail.com' %>"
               aria-label="Email">
              <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Explore Destinations & Packages -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h4 class="font-serif text-lg font-bold mb-4 text-white text-center md:text-left">Explore Kashmir</h4>
        <ul class="space-y-2 text-sm text-slate-300 flex flex-col items-center md:items-start w-full">
          <li><a href="/destinations/srinagar" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Srinagar & Dal Lake</a></li>
          <li><a href="/destinations/gulmarg" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Gulmarg Skiing & Gondola</a></li>
          <li><a href="/destinations/pahalgam" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Pahalgam & Betaab Valley</a></li>
          <li><a href="/destinations/sonamarg" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Sonamarg & Glaciers</a></li>
          <li><a href="/destinations/doodhpathri" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Doodhpathri Meadows</a></li>
          <li><a href="/destinations/gurez-valley" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Gurez Valley Frontier</a></li>
          <li><a href="/packages" class="text-brand-sky font-semibold hover:underline mt-2 inline-block">View All Tour Packages &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 3: Travel Planning -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h4 class="font-serif text-lg font-bold mb-4 text-white text-center md:text-left">Travel Planning</h4>
        <ul class="space-y-2 text-sm text-slate-300 flex flex-col items-center md:items-start w-full">
          <li><a href="/packages" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Kashmir Tour Packages</a></li>
          <li><a href="/experiences" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Kashmir Experiences</a></li>
          <li><a href="/hotels" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Houseboats & Hotels</a></li>
          <li><a href="/about" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>About Our Company</a></li>
          <li><a href="/contact" class="hover:text-brand-sky transition flex items-center"><i data-lucide="chevron-right" class="w-3.5 h-3.5 mr-1.5 text-brand-sky"></i>Contact Our Specialists</a></li>
        </ul>
      </div>

      <!-- Col 4: Get in Touch -->
      <div class="space-y-3.5 flex flex-col items-center md:items-start text-center md:text-left">
        <h4 class="font-serif text-lg font-bold mb-4 text-white text-center md:text-left">Get In Touch</h4>
        <div class="flex items-start justify-center md:justify-start space-x-3 text-sm text-slate-300 text-center md:text-left">
          <i data-lucide="map-pin" class="w-4 h-4 text-brand-sky shrink-0 mt-0.5"></i>
          <span><%= settings.address || 'Palpora, Srinagar, Jammu & Kashmir, India' %></span>
        </div>
        <div class="flex items-start justify-center md:justify-start space-x-3 text-sm text-slate-300 text-center md:text-left">
          <i data-lucide="phone" class="w-4 h-4 text-brand-sky shrink-0 mt-0.5"></i>
          <div class="flex flex-col space-y-1 items-center md:items-start">
            <a href="tel:6006725007" class="hover:text-white font-medium transition py-0.5 inline-block">6006725007</a>
            <a href="tel:9906676890" class="hover:text-white font-medium transition py-0.5 inline-block">9906676890</a>
          </div>
        </div>
        <div class="flex items-center justify-center md:justify-start space-x-3 text-sm text-slate-300 text-center md:text-left">
          <i data-lucide="message-circle" class="w-4 h-4 text-emerald-400 shrink-0"></i>
          <a href="https://wa.me/916006725007" target="_blank" class="text-emerald-300 hover:text-white transition py-0.5 inline-block">
            WhatsApp: 6006725007
          </a>
        </div>
        <div class="flex items-center justify-center md:justify-start text-sm text-slate-300 text-center md:text-left">
          <a href="mailto:<%= settings.email || 'askcitylinetravels@gmail.com' %>" 
             class="inline-flex items-center space-x-3 hover:text-white break-all transition py-0.5 group"
             title="Email: <%= settings.email || 'askcitylinetravels@gmail.com' %>">
            <i data-lucide="mail" class="w-4 h-4 text-brand-sky group-hover:text-white transition shrink-0"></i>
            <span class="group-hover:underline"><%= settings.email || 'askcitylinetravels@gmail.com' %></span>
          </a>
        </div>
        <div class="flex items-center justify-center md:justify-start text-sm text-slate-300 text-center md:text-left">
          <a href="https://www.citylinetravels.com" 
             target="_blank" 
             rel="noopener noreferrer" 
             class="inline-flex items-center space-x-3 hover:text-white break-all transition py-0.5 group"
             title="Official Website: www.citylinetravels.com">
            <i data-lucide="globe" class="w-4 h-4 text-brand-sky group-hover:text-white transition shrink-0"></i>
            <span class="group-hover:underline">www.citylinetravels.com</span>
          </a>
        </div>
        <div class="flex items-center justify-center md:justify-start space-x-3 text-sm text-slate-300 pt-1 text-center md:text-left">
          <i data-lucide="clock" class="w-4 h-4 text-brand-sky shrink-0"></i>
          <span>Monday – Saturday: 10:00 AM – 5:00 PM</span>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Developer Credit -->
    <div class="pt-6 sm:pt-8 flex items-center justify-center text-center text-xs text-slate-400">
      <div class="flex flex-wrap items-center justify-center gap-y-2 gap-x-2.5">
        <span>&copy; <%= new Date().getFullYear() %> <strong>City Line Tours And Travels</strong>. All rights reserved.</span>
        <span class="text-slate-600 hidden sm:inline" aria-hidden="true">•</span>
        <a href="https://www.instagram.com/zuhahahaib" 
           target="_blank" 
           rel="noopener noreferrer" 
           id="ztmCredit" 
           class="ztm-credit inline-flex items-center gap-1.5 hover:opacity-95 transition-all cursor-pointer group" 
           aria-label="Crafted and Developed by ZTM - Instagram @zuhahahaib"
           title="Crafted & Developed by Zuhaib (@zuhahahaib)">
          <span class="ztm-prefix text-[11px] font-normal tracking-wide text-slate-400 group-hover:text-slate-300 transition-colors">Crafted &amp; Developed by</span>
          <span class="ztm-brand relative inline-flex flex-col items-center cursor-pointer">
            <span class="ztm-wordmark font-bold text-xs tracking-wider uppercase inline-flex items-center text-[#DFC17B]">
              <span class="ztm-letter inline-block" style="--l-idx: 0;">Z</span>
              <span class="ztm-letter inline-block" style="--l-idx: 1;">T</span>
              <span class="ztm-letter inline-block" style="--l-idx: 2;">M</span>
            </span>
            <span class="ztm-underline" aria-hidden="true"></span>
          </span>
        </a>
      </div>
    </div>

  </div>
</footer>
