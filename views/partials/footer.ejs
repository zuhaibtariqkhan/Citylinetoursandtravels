<footer class="bg-brand-navy text-white pt-10 sm:pt-16 pb-6 sm:pb-8 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 4-Column Grid -->
