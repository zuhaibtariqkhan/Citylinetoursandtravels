      <!-- Col 1: Brand -->
      <div class="space-y-4 flex flex-col items-center md:items-start text-center md:text-left">
        <div class="flex items-center space-x-3">
          <img src="/images/LOGO.jpeg" alt="City Line Tours And Travels Logo" class="w-12 h-12 object-contain rounded-xl bg-white p-0.5 shadow">
          <div class="text-left">
            <div class="font-serif text-xl font-bold tracking-tight text-white">City Line</div>
            <div class="text-[10px] tracking-widest text-brand-sky uppercase -mt-0.5">Tours And Travels</div>
          </div>
        </div>
        <p class="text-xs font-serif italic text-brand-sky text-center md:text-left">
          "<%= settings.tagline || 'Where Your Travel Dreams Take Flight' %>"
        </p>
        <p class="text-xs text-slate-300 leading-relaxed text-center md:text-left max-w-sm md:max-w-none">
          <%= settings.shortAbout || 'Your premier Kashmir travel company offering personalized holiday packages, luxury houseboat stays, Shikara rides, and unforgettable mountain journeys.' %>
        </p>
        <!-- Social Channels with Real Handle -->
        <div class="pt-2 space-y-2.5 flex flex-col items-center md:items-start w-full">
          <div class="text-[11px] font-semibold text-slate-300 uppercase tracking-wider flex flex-wrap items-center justify-center md:justify-start gap-1.5">
            <span>Follow Us:</span>
            <span class="text-brand-sky font-bold normal-case">@citylinetoursandtravels</span>
          </div>

          <div class="flex items-center justify-center md:justify-start space-x-3 pt-1">
            <!-- Instagram -->
            <a href="https://www.instagram.com/citylinetoursandtravels" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="w-11 h-11 rounded-xl bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] hover:scale-110 flex items-center justify-center text-white transition-all shadow-md" 
               title="Follow @citylinetoursandtravels on Instagram"
               aria-label="Instagram">
              <svg class="w-5 h-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- WhatsApp -->
            <a href="https://wa.me/916006725007" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="w-11 h-11 rounded-xl bg-[#25D366] hover:bg-[#20ba59] hover:scale-110 flex items-center justify-center text-white transition-all shadow-md" 
               title="Chat on WhatsApp: 6006725007"
