<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=1800&q=80" 
           alt="Kashmir Travel FAQs" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-4 py-1.5 rounded-full inline-block mb-3">
        TRAVEL ADVICE & PLANNING
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-4">
        Frequently Asked Questions
      </h1>
      <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about weather, packing, custom itineraries, stays, and booking with City Line Tours.
      </p>
    </div>
  </section>

  <!-- FAQs Accordion Section -->
  <section class="py-16 bg-brand-offwhite">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="space-y-4">
        <% faqs.forEach((faq, idx) => { %>
          <div class="faq-item bg-white rounded-2xl border border-brand-border overflow-hidden transition-all shadow-sm <%= idx === 0 ? 'active' : '' %>">
            <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between font-serif text-base sm:text-lg font-bold text-brand-navy hover:text-brand-blue transition">
              <span><%= faq.question %></span>
              <i data-lucide="chevron-down" class="faq-icon w-5 h-5 text-brand-blue shrink-0 transition-transform duration-300"></i>
            </button>
            <div class="faq-answer px-6 text-sm text-brand-muted leading-relaxed">
              <div class="pb-5 pt-1 border-t border-slate-100">
                <%= faq.answer %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Still have questions CTA -->
      <div class="mt-16 bg-white border border-brand-border rounded-2xl p-8 text-center shadow-sm">
        <h3 class="font-serif text-xl font-bold text-brand-navy mb-2">Still Have Questions?</h3>
        <p class="text-sm text-brand-muted mb-6">Our Kashmir travel team is happy to guide you on timing, clothing, and custom requests.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact" class="btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm">
            Contact Support
          </a>
          <a href="https://wa.me/916006725007" target="_blank" class="bg-[#25D366] text-white px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center space-x-1.5 hover:bg-[#20ba59]">
            <i data-lucide="message-circle" class="w-4 h-4"></i>
            <span>Ask on WhatsApp (6006725007)</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>

