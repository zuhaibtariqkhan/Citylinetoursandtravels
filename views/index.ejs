      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 text-center md:text-left reveal">
        <div class="flex flex-col items-center md:items-start text-center md:text-left">
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full mx-auto md:mx-0">
            FEATURED HOLIDAYS
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-navy mt-3 mb-2 text-center md:text-left">
            Find Your Perfect Kashmir Escape
          </h2>
          <p class="text-sm sm:text-base text-brand-muted max-w-xl text-center md:text-left">
            Thoughtfully organized packages with confirmed stays, private transfers, and day-wise itineraries.
          </p>
        </div>
        <div class="mt-3 md:mt-0 flex justify-center md:justify-start">
          <a href="/packages" class="text-sm font-semibold text-brand-blue hover:text-brand-navy flex items-center space-x-1 group">
            <span>Browse All Packages</span>
            <i data-lucide="arrow-right" class="w-4 h-4 arrow-hover"></i>
          </a>
