        <!-- Live Primary Metrics Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-brand-ice p-3.5 rounded-xl border border-brand-border/60">
            <span class="text-[10px] text-brand-muted uppercase font-bold block mb-1">Current Temperature</span>
            <div class="flex items-baseline space-x-1.5">
              <span class="text-3xl font-serif font-bold text-brand-navy" id="modalCurrentTemp">--°C</span>
              <span class="text-xs text-brand-slate font-medium" id="modalConditionDesc">--</span>
            </div>
            <span class="text-[11px] text-slate-500 block mt-1">Feels like: <strong id="modalFeelsLike">--°C</strong></span>
          </div>

          <div class="bg-brand-ice p-3.5 rounded-xl border border-brand-border/60">
            <span class="text-[10px] text-brand-muted uppercase font-bold block mb-1">Today's Range & Sun</span>
            <div class="text-xs text-brand-navy font-semibold">
              Max: <span id="modalTempMax">--°C</span> · Min: <span id="modalTempMin">--°C</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-1 flex items-center space-x-2">
              <span>🌅 <strong id="modalSunrise">--</strong></span>
              <span>🌇 <strong id="modalSunset">--</strong></span>
            </div>
          </div>

          <div class="bg-brand-ice p-3.5 rounded-xl border border-brand-border/60">
            <span class="text-[10px] text-brand-muted uppercase font-bold block mb-1">Wind & Atmosphere</span>
            <div class="text-sm font-bold text-brand-navy" id="modalWind">-- km/h</div>
            <span class="text-[11px] text-slate-500 block mt-1">Humidity: <strong id="modalHumidity">--%</strong></span>
          </div>

          <div class="bg-brand-ice p-3.5 rounded-xl border border-brand-border/60">
            <span class="text-[10px] text-brand-muted uppercase font-bold block mb-1">Precipitation Probability</span>
            <div class="text-sm font-bold text-brand-blue" id="modalPrecipProb">--%</div>
            <span class="text-[11px] text-slate-500 block mt-1">Elevation: <strong id="modalElevation">--</strong></span>
          </div>
        </div>

        <!-- Mountain Travel Advisory Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border-2 border-brand-blue/30 shadow-xs" id="modalAdvisoryCard">
          <div class="flex items-center space-x-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200" id="modalAdvisoryBadge">
              Favourable Conditions
            </span>
            <h4 class="font-serif text-sm sm:text-base font-bold text-brand-navy" id="modalAdvisoryHeadline">
              Generally Favourable for Sightseeing
            </h4>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" id="modalAdvisoryMessage">
            Clear to partly cloudy conditions. Favourable for outdoor sightseeing, Shikara rides, meadow treks, and photography.
          </p>
          <div class="mt-2.5 pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between text-[11px] text-brand-slate gap-1">
            <span id="modalActivityNotice">⚠️ Carry light to medium woollens as evening temperatures drop rapidly.</span>
            <span class="font-semibold text-brand-blue" id="modalPrecipSummary">Precipitation risk low</span>
          </div>
        </div>

        <!-- Next 24 Hours Hourly Forecast Track -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <h4 class="font-serif text-sm font-bold text-brand-navy flex items-center space-x-1.5">
              <i data-lucide="clock" class="w-4 h-4 text-brand-blue"></i>
              <span>Next 24 Hours' Weather Forecast</span>
            </h4>
            <span class="text-[11px] text-slate-400">Hourly intervals (IST)</span>
          </div>
          <div class="flex overflow-x-auto gap-2.5 pb-2 no-scrollbar scrollbar-thin" id="modalHourlyTrack">
            <!-- Dynamically populated via JS -->
            <div class="text-xs text-slate-400 py-4">Loading 24h forecast...</div>
          </div>
        </div>

        <!-- 5-Day Extended Outlook -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <h4 class="font-serif text-sm font-bold text-brand-navy flex items-center space-x-1.5">
              <i data-lucide="calendar" class="w-4 h-4 text-brand-blue"></i>
              <span>5-Day Weather Outlook</span>
            </h4>
            <span class="text-[11px] text-slate-400">Day & Night Estimates</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" id="modalDailyGrid">
            <!-- Dynamically populated via JS -->
            <div class="text-xs text-slate-400 py-4">Loading 5-day outlook...</div>
          </div>
        </div>

        <!-- Statutory Transparency Notice -->
        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-[10px] text-slate-500 leading-relaxed space-y-1">
          <p>
            <strong>Data Transparency &amp; Provider Notice:</strong> Meteorological data is retrieved from 
            <a href="https://open-meteo.com/" target="_blank" rel="noopener" class="text-brand-blue font-semibold hover:underline">Open-Meteo High-Resolution Numerical Atmospheric Models</a> (ECMWF and GFS).
          </p>
          <p>
            <strong>Important Safety Notice:</strong> Model forecasts represent high-altitude numerical estimations and are not physical on-site automated weather stations. High-altitude operations, Gondola Phase II transits, and mountain pass travel are subject to daily official safety clearance by the Jammu &amp; Kashmir traffic police and local administration.
          </p>
          <p class="text-brand-slate font-medium" id="modalProviderTimestamp">
            Model timestamp: Loading...
          </p>
        </div>

      </div>

    </div>
  </div>

