            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>Handcrafted Itineraries</span>
            </div>
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>Heritage Houseboat Stays</span>
            </div>
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>Dedicated Private Vehicles</span>
            </div>
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>24/7 Local Support</span>
            </div>
          </div>

          <div class="pt-3 flex items-center space-x-4">
            <a href="/about" class="btn-primary px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center space-x-2">
              <span>Our Story</span>
              <i data-lucide="arrow-right" class="w-4 h-4 arrow-hover"></i>
            </a>
            <a href="/contact" class="btn-outline px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm">
              Talk to Our Travel Team
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================
       SECTION 05: ANIMATED METRICS & TRUST STRIP (CountUp Animation)
       ======================================================== -->
  <section class="py-8 sm:py-10 bg-[#102A43] text-white border-y border-white/10 reveal" id="homepageStats">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        
        <!-- Highlight 1: Serving Since 2016 -->
        <div class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 lg:border-none lg:bg-transparent lg:border-r lg:border-white/15">
          <div class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#EAF3FB] leading-none mb-2" data-count-to="2016">2016</div>
          <div class="font-sans text-xs sm:text-sm font-semibold text-white uppercase tracking-wider">Serving Since 2016</div>
          <p class="font-sans text-[11px] sm:text-xs text-slate-300 mt-1">Local Kashmir Expertise</p>
        </div>

        <!-- Highlight 2: 7 Signature Kashmir Valleys -->
        <div class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 lg:border-none lg:bg-transparent lg:border-r lg:border-white/15">
          <div class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#EAF3FB] leading-none mb-2" data-count-to="7">7</div>
          <div class="font-sans text-xs sm:text-sm font-semibold text-white uppercase tracking-wider">7 Signature Valleys</div>
          <p class="font-sans text-[11px] sm:text-xs text-slate-300 mt-1">Signature Kashmir Valleys</p>
        </div>

        <!-- Highlight 3: 100% Tailor-Made Itinerary -->
        <div class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 lg:border-none lg:bg-transparent lg:border-r lg:border-white/15">
          <div class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#EAF3FB] leading-none mb-2" data-count-to="100" data-count-suffix="%">100%</div>
          <div class="font-sans text-xs sm:text-sm font-semibold text-white uppercase tracking-wider">Tailor-Made Itinerary</div>
          <p class="font-sans text-[11px] sm:text-xs text-slate-300 mt-1">Bespoke Travel Design</p>
        </div>

        <!-- Highlight 4: 4.9★ Dedicated Guest Care -->
        <div class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 lg:border-none lg:bg-transparent">
          <div class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-bold text-amber-400 leading-none mb-2" data-count-to="4.9" data-count-suffix="★">4.9★</div>
          <div class="font-sans text-xs sm:text-sm font-semibold text-white uppercase tracking-wider">Average Guest Rating</div>
          <p class="font-sans text-[11px] sm:text-xs text-slate-300 mt-1">Verified Traveler Satisfaction</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================
       SECTION 06: INTERACTIVE KASHMIR MOUNTAIN ROUTE & REGIONAL MAP
       ======================================================== -->
