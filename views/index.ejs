<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <%- include('partials/head') %>
  <!-- Prioritize the visible hero image; later slides load when needed. -->
  <link rel="preload" as="image" href="/images/HERO%20SECTION%20(1).jpg" fetchpriority="high">
</head>
<body class="bg-white text-brand-text">

  <!-- Header -->
  <%- include('partials/header') %>

  <!-- Success Notification Flash (if redirected with ?enquiry_success=true) -->
  <div id="flashNotice" class="hidden max-w-4xl mx-auto my-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-900 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-600 shrink-0"></i>
      <div>
        <p class="font-bold text-sm">Thank you! Your travel enquiry has been received.</p>
        <p class="text-xs text-emerald-700">Our Kashmir travel specialist will review your request and connect with you shortly via phone or WhatsApp.</p>
      </div>
    </div>
    <button onclick="document.getElementById('flashNotice').remove()" class="text-emerald-700 hover:text-emerald-900 p-1">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
  </div>

  <script>
    if (window.location.search.includes('enquiry_success=true')) {
      document.getElementById('flashNotice').classList.remove('hidden');
    }
  </script>

  <%
    const heroWDests = (typeof weatherData !== 'undefined' && weatherData && weatherData.destinations) ? weatherData.destinations : {};
    const srinagarLive = heroWDests.srinagar || null;
    const srinagarCurrent = srinagarLive ? srinagarLive.current : null;
    const srinagarCode = (srinagarCurrent && srinagarCurrent.weatherCode !== null && srinagarCurrent.weatherCode !== undefined) ? srinagarCurrent.weatherCode : 1;
    const srinagarTemp = (srinagarCurrent && srinagarCurrent.temperature !== null && srinagarCurrent.temperature !== undefined) ? srinagarCurrent.temperature : 10;
    const srinagarCond = (srinagarCurrent && srinagarCurrent.condition) ? srinagarCurrent.condition : 'Mainly Clear';
    const srinagarIcon = (srinagarCurrent && srinagarCurrent.icon) ? srinagarCurrent.icon : 'sun';
  %>

  <!-- ========================================================
       SECTION 01: HERO SECTION (Ken-Burns Slider & Real-Time Weather Effects)
       ======================================================== -->
  <section class="relative min-h-[82vh] sm:min-h-[86vh] flex items-center justify-center overflow-hidden bg-brand-navy" 
           id="heroSection"
           data-srinagar-code="<%= srinagarCode %>"
           data-srinagar-temp="<%= srinagarTemp %>"
           data-srinagar-cond="<%= srinagarCond %>"
           data-srinagar-icon="<%= srinagarIcon %>">
    
    <!-- Multi-Scene Ken-Burns Slider Container -->
    <div class="absolute inset-0 z-0" id="heroSlider">
      
      <!-- Slide 1: Hero Section Photo 1 -->
      <div class="hero-slide active" data-slide="0">
        <img src="/images/HERO SECTION (1).jpg" 
             alt="City Line Tours Kashmir Scenic View 1" 
             class="kenburns-1 brightness-[0.75]"
             loading="eager"
             fetchpriority="high"
             decoding="async">
      </div>

      <!-- Slide 2: Hero Section Photo 2 -->
      <div class="hero-slide" data-slide="1">
        <img src="/images/HERO SECTION (2).jpg" 
             alt="City Line Tours Kashmir Scenic View 2" 
             class="kenburns-2 brightness-[0.70]"
             loading="lazy"
             decoding="async">
      </div>

      <!-- Slide 3: Hero Section Photo 3 -->
      <div class="hero-slide" data-slide="2">
        <img src="/images/HERO SECTION (3).jpg" 
             alt="City Line Tours Kashmir Scenic View 3" 
             class="kenburns-3 brightness-[0.75]"
             loading="lazy"
             decoding="async">
      </div>

      <!-- Slide 4: Hero Section Photo 4 -->
      <div class="hero-slide" data-slide="3">
        <img src="/images/HERO SECTION (4).jpg" 
             alt="City Line Tours Kashmir Scenic View 4" 
             class="kenburns-4 brightness-[0.75]"
             loading="lazy"
             decoding="async">
      </div>

      <!-- Dual Layer Gradient Overlay for Rich Readability & Contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/50 to-brand-navy/35 z-10 pointer-events-none"></div>
    </div>

    <!-- Ambient Gentle Snowfall Canvas Overlay -->
    <canvas id="snowCanvas" class="absolute inset-0 pointer-events-none z-10 w-full h-full"></canvas>

    <!-- Hero Content -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-12 sm:pt-16 pb-16 sm:pb-20">
      
      <!-- Small Introductory Label -->
      <div class="hero-badge-enter inline-flex items-center space-x-2 bg-white/15 backdrop-blur-md px-3.5 py-1.5 rounded-full text-brand-sky text-xs font-semibold uppercase tracking-widest mb-4 border border-white/20 shadow-sm">
        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-sky"></i>
        <span>KASHMIR • INDIA</span>
      </div>

      <!-- Main Georgia Bold Heading -->
      <h1 class="hero-title-enter font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-white tracking-tight leading-[1.15] mb-4 drop-shadow-md">
        Discover the Paradise on Earth
      </h1>

      <!-- Supporting Text -->
      <p class="hero-text-enter max-w-xl mx-auto text-sm sm:text-base text-slate-200 font-normal leading-relaxed mb-7">
        Explore the breathtaking beauty of Kashmir with thoughtfully planned journeys, unforgettable experiences and personalised travel arrangements.
      </p>

      <!-- Primary Hero CTA -->
      <div class="hero-cta-enter flex items-center justify-center space-x-3">
        <a href="/packages" class="btn-primary px-7 py-3 rounded-xl text-sm font-semibold shadow-md hover:shadow-lg flex items-center justify-center space-x-2">
          <span>Explore Tour Packages</span>
          <i data-lucide="arrow-right" class="w-4 h-4 arrow-hover"></i>
        </a>
      </div>

      <!-- Scroll to explore indicator -->
      <div class="mt-6 sm:mt-8 flex flex-col items-center justify-center text-slate-300 text-[11px] font-medium space-y-1 opacity-75 animate-bounce">
        <span>Scroll to Explore</span>
        <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
      </div>

    </div>

    <!-- Bottom Controls: Live Weather Effect Pill & Scene Indicators -->
    <div class="absolute bottom-4 sm:bottom-5 inset-x-0 z-20 px-4 sm:px-8 flex items-center justify-between text-xs">
      
      <!-- Live Srinagar Weather Dynamic Effect Control -->
      <div class="relative inline-block" id="heroWeatherControl">
        <button id="snowToggleBtn" type="button" 
                class="snow-toggle-btn px-3 py-1.5 rounded-full text-[11px] font-medium flex items-center space-x-1.5 bg-black/40 hover:bg-black/60 text-white backdrop-blur-md border border-white/20 transition-all shadow-md group cursor-pointer"
                title="Live Srinagar weather effect (Click to customize or preview)">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400" id="heroWeatherPulseDot"></span>
          </span>
          <i id="heroWeatherIcon" data-lucide="<%= srinagarIcon || 'sun' %>" class="w-3.5 h-3.5 text-amber-300"></i>
          <span id="snowStatusText">Srinagar: <%= srinagarCond %> (<%= srinagarTemp %>°C)</span>
          <i data-lucide="chevron-up" class="w-3 h-3 text-slate-300 group-hover:text-white transition"></i>
        </button>

        <!-- Weather Effect Mode Selector Dropdown -->
        <div id="heroWeatherMenu" class="hidden absolute bottom-full left-0 mb-2 w-56 bg-brand-navy/95 backdrop-blur-xl border border-white/20 rounded-2xl shadow-2xl p-1.5 text-xs text-white z-50">
          <div class="px-2.5 py-1.5 border-b border-white/10 text-[10px] uppercase font-bold text-brand-sky tracking-wider flex items-center justify-between">
            <span>Srinagar Weather FX</span>
            <span class="text-[9px] text-emerald-400 bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-500/30 font-mono">LIVE API</span>
          </div>
          <div class="py-1 space-y-0.5" id="heroWeatherOptions">
            <button type="button" data-mode="auto" class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-white active-mode bg-white/15">
              <span class="flex items-center space-x-2">
                <i data-lucide="radio" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span>Live Srinagar Real-Time</span>
              </span>
              <span class="text-[9px] text-emerald-400 font-bold uppercase tracking-wider">LIVE</span>
            </button>
            <button type="button" data-mode="rain" class="w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-slate-200 hover:text-white">
              <i data-lucide="cloud-rain" class="w-3.5 h-3.5 text-cyan-300"></i>
              <span>Rain Effect</span>
            </button>
            <button type="button" data-mode="thunderstorm" class="w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-slate-200 hover:text-white">
              <i data-lucide="cloud-lightning" class="w-3.5 h-3.5 text-amber-300"></i>
              <span>Thunderstorm &amp; Lightning</span>
            </button>
            <button type="button" data-mode="snow" class="w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-slate-200 hover:text-white">
              <i data-lucide="snowflake" class="w-3.5 h-3.5 text-white"></i>
              <span>Snowfall Effect</span>
            </button>
            <button type="button" data-mode="fog" class="w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-slate-200 hover:text-white">
              <i data-lucide="cloud-fog" class="w-3.5 h-3.5 text-slate-300"></i>
              <span>Mountain Mist &amp; Fog</span>
            </button>
            <button type="button" data-mode="clear" class="w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-slate-200 hover:text-white">
              <i data-lucide="sun" class="w-3.5 h-3.5 text-amber-400"></i>
              <span>Clear Mountain Skies</span>
            </button>
            <button type="button" data-mode="off" class="w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-xl hover:bg-white/10 transition text-left text-[11px] font-medium text-slate-400 hover:text-slate-200 border-t border-white/10 mt-1 pt-1.5">
              <i data-lucide="eye-off" class="w-3.5 h-3.5"></i>
              <span>Pause / Off</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Ken-Burns Scene Switcher Bullets -->
      <div class="flex items-center space-x-2.5 bg-black/30 backdrop-blur px-3 py-1.5 rounded-full border border-white/10" id="heroSceneNav">
        <button type="button" class="hero-scene-dot w-6 sm:w-8 h-1.5 rounded-full bg-brand-sky transition-all duration-300" data-target="0" title="Kashmir Scenic 1"></button>
        <button type="button" class="hero-scene-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-target="1" title="Kashmir Scenic 2"></button>
        <button type="button" class="hero-scene-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-target="2" title="Kashmir Scenic 3"></button>
        <button type="button" class="hero-scene-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-target="3" title="Kashmir Scenic 4"></button>
      </div>

    </div>

  </section>

  <!-- ========================================================
       SECTION 02: QUICK TRIP CONSULTATION BAR
       ======================================================== -->
  <section class="relative z-20 pt-6 pb-6 sm:pt-8 sm:pb-8 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 reveal" id="quickConsultationBar">
    <div class="bg-white rounded-2xl shadow-lg border border-brand-border p-4 sm:p-5 lg:p-6">
      <div class="mb-3.5 flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-3 gap-2">
        <div class="flex items-center space-x-2 text-brand-navy">
          <div class="w-7 h-7 rounded-lg bg-brand-softsky text-brand-blue flex items-center justify-center">
            <i data-lucide="compass" class="w-4 h-4"></i>
          </div>
          <span class="text-xs sm:text-sm font-bold uppercase tracking-wider">Quick Travel Consultation</span>
        </div>
        <span class="text-xs text-brand-slate">Direct local itinerary & custom quotation delivered to your phone</span>
      </div>

      <form id="quickEnquiryForm" class="ajax-enquiry-form grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="hidden" name="source" value="Homepage Quick Bar">

        <!-- Destination Select -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Destination</label>
          <div class="relative">
            <i data-lucide="map-pin" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <select name="destination" class="form-input pl-9 text-xs sm:text-sm py-2">
              <option value="All Kashmir (Classic Tour)">All Kashmir (Classic)</option>
              <option value="Srinagar & Dal Lake">Srinagar & Dal Lake</option>
              <option value="Gulmarg Ski & Gondola">Gulmarg Ski & Gondola</option>
              <option value="Pahalgam & Betaab Valley">Pahalgam & Betaab</option>
              <option value="Sonamarg Glaciers">Sonamarg Glaciers</option>
              <option value="Offbeat (Doodhpathri & Gurez)">Offbeat Valleys</option>
            </select>
          </div>
        </div>

        <!-- Travel Date -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Travel Date</label>
          <div class="relative">
            <i data-lucide="calendar" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <input type="date" name="travelDate" class="form-input pl-9 text-xs sm:text-sm py-2">
          </div>
        </div>

        <!-- Travellers -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Travellers</label>
          <div class="relative">
            <i data-lucide="users" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <select name="travellers" class="form-input pl-9 text-xs sm:text-sm py-2">
              <option value="Couple (2 Adults)">Couple (2 Adults)</option>
              <option value="Family (3-4 Pax)">Family (3-4 Pax)</option>
              <option value="Group (5+ Pax)">Group (5+ Pax)</option>
              <option value="Solo (1 Person)">Solo (1 Person)</option>
            </select>
          </div>
        </div>

        <!-- Contact (Phone / Mobile) -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Mobile Number <span class="text-rose-500">*</span></label>
          <div class="relative">
            <i data-lucide="phone" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <input type="tel" name="phone" required placeholder="Phone / WhatsApp" class="form-input pl-9 text-xs sm:text-sm py-2">
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex items-end">
          <button type="submit" class="w-full btn-primary h-[38px] rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-sm">
            <span>Send My Enquiry</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>

      </form>
    </div>
  </section>

  <!-- ========================================================
       SECTION 03: LIVE MOUNTAIN CLIMATE & VALLEY TRAVEL ADVISORY
       ======================================================== -->
  <%
    const wDests = (typeof weatherData !== 'undefined' && weatherData && weatherData.destinations) ? weatherData.destinations : {};
    const hasLiveFeed = (typeof weatherData !== 'undefined' && weatherData && weatherData.isAvailable);
    const weatherLastUpdatedIST = (typeof weatherData !== 'undefined' && weatherData && weatherData.modelTimeIST) ? weatherData.modelTimeIST : 'Live Satellite Feed (Open-Meteo)';
    
    const kashmirDestinations = [
      { id: 'srinagar', name: 'Srinagar', lat: '34.0837', lon: '74.7973', alt: '1,585m', zone: 'Dal Lake & Valley Basin', defaultTemp: 10, defaultDesc: 'Mainly Clear', defaultIcon: 'sun', defaultWind: '10 km/h NNW', defaultHum: '69%', defaultRain: '10%' },
      { id: 'gulmarg', name: 'Gulmarg', lat: '34.0484', lon: '74.3805', alt: '2,650m', zone: 'Apharwat & Pir Panjal', defaultTemp: -1, defaultDesc: 'Alpine Chill', defaultIcon: 'snowflake', defaultWind: '7 km/h SSW', defaultHum: '83%', defaultRain: '25%' },
      { id: 'pahalgam', name: 'Pahalgam', lat: '34.0163', lon: '75.3150', alt: '2,130m', zone: 'Lidder River Valley', defaultTemp: 6, defaultDesc: 'Light Drizzle', defaultIcon: 'cloud-rain', defaultWind: '12 km/h NE', defaultHum: '75%', defaultRain: '45%' },
      { id: 'sonamarg', name: 'Sonamarg', lat: '34.3100', lon: '75.2950', alt: '2,730m', zone: 'Thajiwas Glacier & Sindh', defaultTemp: -1, defaultDesc: 'Moderate Snow', defaultIcon: 'snowflake', defaultWind: '2 km/h SSE', defaultHum: '88%', defaultRain: '60%' },
      { id: 'doodhpathri', name: 'Doodhpathri', lat: '33.8787', lon: '74.5684', alt: '2,730m', zone: 'Shaliganga Pine Meadows', defaultTemp: 5, defaultDesc: 'Crisp Meadows', defaultIcon: 'cloud-sun', defaultWind: '2 km/h SSW', defaultHum: '91%', defaultRain: '30%' },
      { id: 'yusmarg', name: 'Yusmarg', lat: '33.8290', lon: '74.6644', alt: '2,400m', zone: 'Pir Panjal Meadow & River', defaultTemp: 6, defaultDesc: 'Mountain Breeze', defaultIcon: 'cloud-sun', defaultWind: '2 km/h SSW', defaultHum: '91%', defaultRain: '20%' }
    ];
  %>
  <section class="py-6 sm:py-12 bg-brand-ice border-y border-brand-border reveal" id="liveWeatherSection">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Component Header (Desktop Standard, Mobile Full-Width Clean) -->
      <div class="weather-mobile-container sm:block">
        
        <!-- Header -->
        <div class="weather-mobile-header flex flex-col sm:flex-row sm:items-end justify-between gap-2.5 sm:gap-4 pb-3 sm:pb-5 border-b border-brand-border mb-3 sm:mb-6 text-center sm:text-left items-center sm:items-end">
          <div class="flex flex-col items-center sm:items-start">
            <div class="inline-flex items-center space-x-1.5 sm:space-x-2 bg-white border border-brand-border text-brand-blue text-[10px] sm:text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2 shadow-xs">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-blue"></span>
              </span>
              <span>MOUNTAIN CLIMATE &amp; TRAVEL ADVISORY</span>
            </div>
            <h2 class="font-serif text-base sm:text-3xl font-bold text-brand-navy tracking-tight leading-snug sm:leading-normal">
              Live Kashmir Mountain Weather &amp; Valley Status
            </h2>
            <p class="text-[11px] sm:text-xs text-brand-slate mt-1 max-w-2xl leading-relaxed text-center sm:text-left">
              Genuine meteorological model feed via Open-Meteo. High-altitude operations, Gondola rides, and passes operate subject to daily local safety clearance.
            </p>
          </div>
          <div class="text-[10px] sm:text-xs text-brand-slate flex items-center space-x-1.5 shrink-0 bg-white sm:bg-transparent px-2.5 py-1 sm:p-0 rounded-full sm:rounded-none border sm:border-0 border-brand-border shadow-xs sm:shadow-none mt-1 sm:mt-0">
            <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-blue"></i>
            <span id="weatherLastUpdated"><%= weatherLastUpdatedIST %></span>
          </div>
        </div>

        <!-- 6-Valley Weather Live Carousel on Mobile, Grid on Desktop -->
        <div class="weather-mobile-scroll-container flex sm:grid overflow-x-auto sm:overflow-visible sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3 sm:gap-3.5 pb-2.5 sm:pb-0 no-scrollbar snap-x snap-mandatory" id="weatherCardsGrid">
        
        <% kashmirDestinations.forEach(item => { 
          const live = wDests[item.id] || null;
          const temp = (live && live.current && live.current.temperature !== null) ? live.current.temperature : item.defaultTemp;
          const feels = (live && live.current && live.current.apparentTemperature !== null) ? live.current.apparentTemperature : temp - 2;
          const cond = (live && live.current && live.current.condition) ? live.current.condition : item.defaultDesc;
          const icon = (live && live.current && live.current.icon) ? live.current.icon : item.defaultIcon;
          const hum = (live && live.current && live.current.relativeHumidity !== null) ? `${live.current.relativeHumidity}%` : item.defaultHum;
          const wind = (live && live.current && live.current.windSpeed !== null) ? `${live.current.windSpeed} km/h ${live.current.windCardinal || ''}` : item.defaultWind;
          const rainProb = (live && live.todaySummary && live.todaySummary.precipProbability !== undefined) ? live.todaySummary.precipProbability : parseInt(item.defaultRain);
          const advisory = (live && live.travelAdvisory) ? live.travelAdvisory : { badge: 'Favourable', badgeColor: 'emerald', message: 'Clear conditions. Favourable for sightseeing.' };
        %>
          <!-- Destination Card -->
          <div class="weather-card bg-white rounded-xl sm:rounded-2xl p-3.5 sm:p-4 border border-brand-border shadow-xs sm:shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between w-[195px] sm:w-auto shrink-0 sm:shrink snap-start cursor-pointer group"
               data-dest="<%= item.id %>" 
               data-lat="<%= item.lat %>" 
               data-lon="<%= item.lon %>">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-navy"><%= item.name %></span>
                <span class="weather-status-badge text-[9px] px-1.5 py-0.5 rounded-full <%= hasLiveFeed ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200' %> font-semibold border">
                  <%= hasLiveFeed ? 'Live Feed' : 'Checking' %>
                </span>
              </div>
              <div class="flex items-baseline space-x-2 my-1">
                <span class="text-2xl font-serif font-bold text-brand-navy" id="weatherTemp-<%= item.id %>"><%= temp %>°C</span>
                <span class="text-xs text-brand-slate font-medium truncate" id="weatherDesc-<%= item.id %>"><%= cond %></span>
              </div>
              <div class="grid grid-cols-2 gap-1 text-[11px] text-slate-500 mt-2 pt-2 border-t border-slate-100">
                <span>Humidity: <strong class="text-brand-navy font-semibold" id="weatherHumidity-<%= item.id %>"><%= hum %></strong></span>
                <span>Wind: <strong class="text-brand-navy font-semibold" id="weatherWind-<%= item.id %>"><%= wind %></strong></span>
              </div>
              <div class="flex items-center justify-between text-[11px] text-slate-500 mt-1">
                <span>Feels: <strong class="text-brand-navy font-semibold" id="weatherFeels-<%= item.id %>"><%= feels %>°C</strong></span>
                <span>Precip: <strong class="text-brand-blue font-semibold" id="weatherPrecip-<%= item.id %>"><%= rainProb %>%</strong></span>
              </div>
            </div>
            
