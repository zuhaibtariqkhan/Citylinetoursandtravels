            </div>
            <h3 class="font-serif text-lg sm:text-2xl font-bold text-brand-navy" id="modalDestTitle">
              Srinagar Valley Weather & Travel Advisory
            </h3>
          </div>
        </div>
        <button type="button" id="closeWeatherModalBtn" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Destination Selector Tabs -->
      <div class="px-4 sm:px-6 pt-3 pb-2 border-b border-slate-100 bg-slate-50/70 overflow-x-auto no-scrollbar flex items-center space-x-2" id="modalDestTabs">
        <% kashmirDestinations.forEach((d, idx) => { %>
          <button type="button" 
                  class="modal-tab-btn px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition border <%= idx === 0 ? 'bg-brand-blue text-white border-brand-blue shadow-xs' : 'bg-white text-slate-700 hover:bg-slate-100 border-slate-200' %>"
