    <div class="bg-white rounded-2xl sm:rounded-3xl max-w-4xl w-full max-h-[92vh] overflow-y-auto shadow-2xl border border-brand-border flex flex-col animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-6 border-b border-brand-border flex items-center justify-between sticky top-0 bg-white z-10">
        <div class="flex items-center space-x-2.5 sm:space-x-3">
          <div class="w-10 h-10 rounded-xl bg-brand-softsky text-brand-blue flex items-center justify-center shrink-0">
            <i data-lucide="cloud-sun" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="inline-flex items-center space-x-1.5 text-[10px] uppercase font-bold text-brand-blue tracking-wider">
