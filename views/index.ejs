        <% (featuredPackages.length > 0 ? featuredPackages : allPackages).slice(0, 12).forEach(pkg => { %>
          <div class="bg-white rounded-2xl border border-brand-border overflow-hidden card-hover flex flex-col shadow-sm">
            
            <!-- Image & Category Tag -->
            <div class="relative h-52 img-zoom-container">
              <img src="<%= pkg.featuredImage %>" alt="<%= pkg.title %>" loading="lazy" decoding="async" class="w-full h-full object-cover">
              <div class="absolute top-3 left-3">
                <span class="bg-white/95 backdrop-blur text-brand-navy text-[11px] font-bold px-3 py-1 rounded-full shadow-sm">
                  <%= pkg.category %> Special
                </span>
              </div>
              <div class="absolute bottom-2.5 right-2.5 bg-brand-navy/90 text-white text-[11px] px-2.5 py-1 rounded-md flex items-center space-x-1.5 backdrop-blur-sm">
                <i data-lucide="calendar" class="w-3.5 h-3.5 text-brand-sky"></i>
                <span><%= pkg.duration %></span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-serif text-lg font-bold text-brand-navy mb-1.5 line-clamp-1 hover:text-brand-blue transition">
                  <a href="/packages/<%= pkg.slug %>"><%= pkg.title %></a>
                </h3>

                <!-- Destination Tags -->
                <div class="flex items-center text-xs text-brand-muted mb-2.5 space-x-1.5">
                  <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-blue shrink-0"></i>
                  <span class="truncate"><%= (pkg.destinationCoverage || []).join(' • ') %></span>
                </div>

                <p class="text-xs text-brand-muted leading-relaxed line-clamp-2 mb-3">
                  <%= pkg.shortDescription %>
                </p>

                <!-- Information Badges with Lucide Icons -->
                <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600 bg-brand-offwhite p-2.5 rounded-xl mb-3.5">
                  <div class="flex items-center space-x-1.5">
                    <i data-lucide="bed-double" class="w-3.5 h-3.5 text-brand-blue"></i>
                    <span class="truncate">Houseboat & Hotel</span>
                  </div>
                  <div class="flex items-center space-x-1.5">
                    <i data-lucide="car" class="w-3.5 h-3.5 text-brand-blue"></i>
                    <span class="truncate">Private Vehicle</span>
                  </div>
                </div>
              </div>

              <!-- Price & Actions -->
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span class="text-[10px] text-brand-muted uppercase block">
                    <%= (pkg.pricingModel === 'winter_wonderland' || pkg.pricingModel === 'fixed_couple' || pkg.pricingModel === 'himalayan_escape' || pkg.pricingModel === 'tulip_festival' || pkg.pricingModel === 'amarnath_yatra' || pkg.pricingModel === 'autumn_chinar') ? 'Total Package' : 'Starting From' %>
                  </span>
                  <span class="font-serif text-base sm:text-lg font-bold text-brand-blue">
                    <%= pkg.startingPriceFormatted %>
                  </span>
                  <% if (pkg.price && pkg.pricingModel !== 'fixed_couple' && pkg.pricingModel !== 'winter_wonderland' && pkg.pricingModel !== 'himalayan_escape' && pkg.pricingModel !== 'tulip_festival' && pkg.pricingModel !== 'amarnath_yatra' && pkg.pricingModel !== 'autumn_chinar') { %>
                    <span class="text-[10px] text-brand-muted">/ person</span>
                  <% } else if (pkg.pricingModel === 'himalayan_escape') { %>
                    <span class="text-[10px] text-brand-muted">(12 Travellers Base)</span>
                  <% } else if (pkg.pricingModel === 'winter_wonderland') { %>
                    <span class="text-[10px] text-brand-muted">(5 Persons)</span>
                  <% } else if (pkg.pricingModel === 'fixed_couple') { %>
                    <span class="text-[10px] text-brand-muted">(Couple)</span>
                  <% } else if (pkg.pricingModel === 'tulip_festival') { %>
                    <span class="text-[10px] text-brand-muted">(2 Travellers Base)</span>
                  <% } else if (pkg.pricingModel === 'amarnath_yatra') { %>
                    <span class="text-[10px] text-brand-muted">(2 Yatris Base)</span>
                  <% } else if (pkg.pricingModel === 'autumn_chinar') { %>
                    <span class="text-[10px] text-brand-muted">(2 Persons Base)</span>
                  <% } %>
                </div>

                <div class="flex items-center space-x-2">
                  <a href="/packages/<%= pkg.slug %>" class="btn-outline px-3 py-1.5 rounded-lg text-xs font-semibold">
                    View Details
                  </a>
                  <button class="enquire-now-btn btn-primary px-3 py-1.5 rounded-lg text-xs font-semibold" data-package="<%= pkg.title %>">
                    Request a Quote
                  </button>
