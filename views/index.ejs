          <div class="icon-container-light mb-4 w-11 h-11 flex items-center justify-center rounded-xl bg-brand-softsky text-brand-blue">
            <i data-lucide="calendar" class="w-5 h-5"></i>
          </div>
          <h3 class="font-serif text-lg font-bold text-brand-navy mb-2">Beautifully Planned Journeys</h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
            Thoughtfully timed sightseeing schedules so you spend less time waiting in traffic and more time enjoying breathtaking vistas.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-white p-6 rounded-2xl border border-brand-border card-hover">
          <div class="icon-container-light mb-4 w-11 h-11 flex items-center justify-center rounded-xl bg-brand-softsky text-brand-blue">
            <i data-lucide="sliders" class="w-5 h-5"></i>
          </div>
          <h3 class="font-serif text-lg font-bold text-brand-navy mb-2">Flexible Travel Options</h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
            From budget-conscious family holidays to luxury honeymoon suites and boutique stays, we adapt to your budget.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="bg-white p-6 rounded-2xl border border-brand-border card-hover">
          <div class="icon-container-light mb-4 w-11 h-11 flex items-center justify-center rounded-xl bg-brand-softsky text-brand-blue">
            <i data-lucide="mountain" class="w-5 h-5"></i>
          </div>
