<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">

  <!-- Header -->
  <%- include('partials/header') %>

  <!-- Success Notification Flash (if redirected with ?enquiry_success=true) -->
  <div id="flashNotice" class="hidden max-w-4xl mx-auto my-4 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-900 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-600 shrink-0"></i>
      <div>
        <p class="font-bold text-sm">Thank you! Your travel enquiry has been received.</p>
        <p class="text-xs text-emerald-700">Our Kashmir travel specialist will review your request and connect with you shortly via phone or email.</p>
      </div>
    </div>
    <button onclick="document.getElementById('flashNotice').remove()" class="text-emerald-700 hover:text-emerald-900 p-1">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
  </div>

  <script>
    if (window.location.search.includes('enquiry_success=true')) {
      document.getElementById('flashNotice').classList.remove('hidden');
    }
  </script>

  <!-- ========================================================
       SECTION 01: HERO SECTION (Ken-Burns Slider & Snowfall)
       ======================================================== -->
  <section class="relative min-h-[82vh] sm:min-h-[86vh] flex items-center justify-center overflow-hidden bg-brand-navy" id="heroSection">
    
    <!-- Multi-Scene Ken-Burns Slider Container -->
    <div class="absolute inset-0 z-0" id="heroSlider">
      
      <!-- Slide 1: Hero Section Photo 1 -->
      <div class="hero-slide active" data-slide="0">
        <img src="/images/HERO SECTION (1).jpg" 
             alt="City Line Tours Kashmir Scenic View 1" 
             class="kenburns-1 brightness-[0.75]"
             loading="eager"
             fetchpriority="high">
      </div>

      <!-- Slide 2: Hero Section Photo 2 -->
      <div class="hero-slide" data-slide="1">
        <img src="/images/HERO SECTION (2).jpg" 
             alt="City Line Tours Kashmir Scenic View 2" 
             class="kenburns-2 brightness-[0.70]">
      </div>

      <!-- Slide 3: Hero Section Photo 3 -->
      <div class="hero-slide" data-slide="2">
        <img src="/images/HERO SECTION (3).jpg" 
             alt="City Line Tours Kashmir Scenic View 3" 
             class="kenburns-3 brightness-[0.75]">
      </div>

      <!-- Dual Layer Gradient Overlay for Rich Readability & Contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/50 to-brand-navy/35 z-10"></div>
    </div>

    <!-- Ambient Gentle Snowfall Canvas Overlay -->
    <canvas id="snowCanvas" class="absolute inset-0 pointer-events-none z-10 w-full h-full"></canvas>

    <!-- Hero Content -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-12 sm:pt-16 pb-16 sm:pb-20">
      
      <!-- Small Introductory Label -->
      <div class="hero-badge-enter inline-flex items-center space-x-2 bg-white/15 backdrop-blur-md px-3.5 py-1.5 rounded-full text-brand-sky text-xs font-semibold uppercase tracking-widest mb-4 border border-white/20 shadow-sm">
        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-sky"></i>
        <span>KASHMIR • INDIA</span>
      </div>

      <!-- Main Georgia Bold Heading -->
      <h1 class="hero-title-enter font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-white tracking-tight leading-[1.15] mb-4 drop-shadow-md">
        Discover the Paradise on Earth
      </h1>

      <!-- Supporting Text -->
      <p class="hero-text-enter max-w-xl mx-auto text-sm sm:text-base text-slate-200 font-normal leading-relaxed mb-7">
        Explore the breathtaking beauty of Kashmir with thoughtfully planned journeys, unforgettable experiences and personalised travel arrangements.
      </p>

      <!-- Primary Hero CTA -->
      <div class="hero-cta-enter flex items-center justify-center">
        <a href="/packages" class="btn-primary px-7 py-3 rounded-xl text-sm font-semibold shadow-md hover:shadow-lg flex items-center justify-center space-x-2">
          <span>Explore Packages</span>
          <i data-lucide="arrow-right" class="w-4 h-4 arrow-hover"></i>
        </a>
      </div>

      <!-- Scroll to explore indicator -->
      <div class="mt-6 sm:mt-8 flex flex-col items-center justify-center text-slate-300 text-[11px] font-medium space-y-1 opacity-75 animate-bounce">
        <span>Scroll to Explore</span>
        <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
      </div>

    </div>

    <!-- Bottom Controls: Snowfall Toggle & Scene Indicators -->
    <div class="absolute bottom-4 sm:bottom-5 inset-x-0 z-20 px-4 sm:px-8 flex items-center justify-between text-xs">
      
      <!-- Snowfall Toggle Pill -->
      <button id="snowToggleBtn" type="button" class="snow-toggle-btn px-3 py-1.5 rounded-full text-[11px] font-medium flex items-center space-x-1.5">
        <i data-lucide="snowflake" class="w-3.5 h-3.5 text-cyan-300"></i>
        <span id="snowStatusText">Snowfall: Active</span>
      </button>

      <!-- Ken-Burns Scene Switcher Bullets -->
      <div class="flex items-center space-x-2.5 bg-black/30 backdrop-blur px-3 py-1.5 rounded-full border border-white/10" id="heroSceneNav">
        <button type="button" class="hero-scene-dot w-6 sm:w-8 h-1.5 rounded-full bg-brand-sky transition-all duration-300" data-target="0" title="Kashmir Scenic 1"></button>
        <button type="button" class="hero-scene-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-target="1" title="Kashmir Scenic 2"></button>
        <button type="button" class="hero-scene-dot w-2 h-1.5 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" data-target="2" title="Kashmir Scenic 3"></button>
      </div>

    </div>

  </section>

  <!-- ========================================================
       SECTION 02: QUICK TRIP CONSULTATION BAR
       ======================================================== -->
  <section class="relative z-20 pt-6 pb-6 sm:pt-8 sm:pb-8 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 reveal" id="quickConsultationBar">
    <div class="bg-white rounded-2xl shadow-lg border border-brand-border p-4 sm:p-5 lg:p-6">
      <div class="mb-3.5 flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-3 gap-2">
        <div class="flex items-center space-x-2 text-brand-navy">
          <div class="w-7 h-7 rounded-lg bg-brand-softsky text-brand-blue flex items-center justify-center">
            <i data-lucide="compass" class="w-4 h-4"></i>
          </div>
          <span class="text-xs sm:text-sm font-bold uppercase tracking-wider">Quick Travel Consultation</span>
        </div>
        <span class="text-xs text-brand-slate">Direct local itinerary & custom quotation delivered to your phone</span>
      </div>

      <form id="quickEnquiryForm" class="ajax-enquiry-form grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="hidden" name="source" value="Homepage Quick Bar">

        <!-- Destination Select -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Destination</label>
          <div class="relative">
            <i data-lucide="map-pin" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <select name="destination" class="form-input pl-9 text-xs sm:text-sm py-2">
              <option value="All Kashmir (Classic Tour)">All Kashmir (Classic)</option>
              <option value="Srinagar & Dal Lake">Srinagar & Dal Lake</option>
              <option value="Gulmarg Ski & Gondola">Gulmarg Ski & Gondola</option>
              <option value="Pahalgam & Betaab Valley">Pahalgam & Betaab</option>
              <option value="Sonamarg Glaciers">Sonamarg Glaciers</option>
              <option value="Offbeat (Doodhpathri & Gurez)">Offbeat Valleys</option>
            </select>
          </div>
        </div>

        <!-- Travel Date -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Travel Date</label>
          <div class="relative">
            <i data-lucide="calendar" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <input type="date" name="travelDate" class="form-input pl-9 text-xs sm:text-sm py-2">
          </div>
        </div>

        <!-- Travellers -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Travellers</label>
          <div class="relative">
            <i data-lucide="users" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <select name="travellers" class="form-input pl-9 text-xs sm:text-sm py-2">
              <option value="Couple (2 Adults)">Couple (2 Adults)</option>
              <option value="Family (3-4 Pax)">Family (3-4 Pax)</option>
              <option value="Group (5+ Pax)">Group (5+ Pax)</option>
              <option value="Solo (1 Person)">Solo (1 Person)</option>
            </select>
          </div>
        </div>

        <!-- Contact (Phone / Mobile) -->
        <div>
          <label class="block text-[11px] font-semibold text-brand-slate mb-1 uppercase tracking-wider">Mobile Number <span class="text-rose-500">*</span></label>
          <div class="relative">
            <i data-lucide="phone" class="w-4 h-4 text-brand-blue absolute left-3 top-2.5"></i>
            <input type="tel" name="phone" required placeholder="Phone / WhatsApp" class="form-input pl-9 text-xs sm:text-sm py-2">
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex items-end">
          <button type="submit" class="w-full btn-primary h-[38px] rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-sm">
            <span>Send Enquiry</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>

      </form>
    </div>
  </section>

  <!-- ========================================================
       SECTION 03: LIVE MOUNTAIN CLIMATE & VALLEY TRAVEL ADVISORY
       ======================================================== -->
  <section class="py-10 sm:py-12 bg-brand-ice border-y border-brand-border reveal" id="liveWeatherSection">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Component Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-5 border-b border-brand-border mb-6">
        <div>
          <div class="inline-flex items-center space-x-2 bg-white border border-brand-border text-brand-blue text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>LIVE TRAVEL ADVISORY</span>
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-navy tracking-tight">
            Live Kashmir Mountain Weather & Valley Status
          </h2>
        </div>
        <div class="text-xs text-brand-slate flex items-center space-x-2">
          <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-blue"></i>
          <span id="weatherLastUpdated">Live Updates Active</span>
        </div>
      </div>

      <!-- 6-Valley Weather Live Carousel / Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3.5" id="weatherCardsGrid">
        
        <!-- 1. Srinagar -->
        <div class="bg-white rounded-2xl p-4 border border-brand-border shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Srinagar</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Open</span>
            </div>
            <div class="flex items-baseline space-x-2 my-1">
              <span class="text-2xl font-serif font-bold text-brand-navy">14°C</span>
              <span class="text-xs text-brand-slate font-medium">Clear Sky</span>
            </div>
            <p class="text-[11px] text-brand-muted mt-1 leading-snug">Dal Lake Shikara & Boulevard road smooth.</p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-brand-slate">
            <span>Alt: 1,585m</span>
            <span class="text-brand-blue font-semibold">Houseboats Active</span>
          </div>
        </div>

        <!-- 2. Gulmarg -->
        <div class="bg-white rounded-2xl p-4 border border-brand-border shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Gulmarg</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-50 text-cyan-700 font-medium">Snow Peak</span>
            </div>
            <div class="flex items-baseline space-x-2 my-1">
              <span class="text-2xl font-serif font-bold text-brand-navy">4°C</span>
              <span class="text-xs text-brand-slate font-medium">Snow Cover</span>
            </div>
            <p class="text-[11px] text-brand-muted mt-1 leading-snug">Gondola Phase 1 & 2 operational.</p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-brand-slate">
            <span>Alt: 2,650m</span>
            <span class="text-brand-blue font-semibold">Warm Woollens req.</span>
          </div>
        </div>

        <!-- 3. Pahalgam -->
        <div class="bg-white rounded-2xl p-4 border border-brand-border shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Pahalgam</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Clear</span>
            </div>
            <div class="flex items-baseline space-x-2 my-1">
              <span class="text-2xl font-serif font-bold text-brand-navy">10°C</span>
              <span class="text-xs text-brand-slate font-medium">Pleasant</span>
            </div>
            <p class="text-[11px] text-brand-muted mt-1 leading-snug">Betaab & Aru valleys easily accessible.</p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-brand-slate">
            <span>Alt: 2,130m</span>
            <span class="text-brand-blue font-semibold">Lidder Riverside</span>
          </div>
        </div>

        <!-- 4. Sonamarg -->
        <div class="bg-white rounded-2xl p-4 border border-brand-border shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Sonamarg</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-50 text-cyan-700 font-medium">Glacial</span>
            </div>
            <div class="flex items-baseline space-x-2 my-1">
              <span class="text-2xl font-serif font-bold text-brand-navy">6°C</span>
              <span class="text-xs text-brand-slate font-medium">Cool Breeze</span>
            </div>
            <p class="text-[11px] text-brand-muted mt-1 leading-snug">Thajiwas Glacier pony trek open.</p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-brand-slate">
            <span>Alt: 2,740m</span>
            <span class="text-brand-blue font-semibold">Z-Morh Tunnel Clear</span>
          </div>
        </div>

        <!-- 5. Doodhpathri -->
        <div class="bg-white rounded-2xl p-4 border border-brand-border shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Doodhpathri</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Serene</span>
            </div>
            <div class="flex items-baseline space-x-2 my-1">
              <span class="text-2xl font-serif font-bold text-brand-navy">11°C</span>
              <span class="text-xs text-brand-slate font-medium">Sunny</span>
            </div>
            <p class="text-[11px] text-brand-muted mt-1 leading-snug">Milky Shaliganga river meadows pristine.</p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-brand-slate">
            <span>Alt: 2,730m</span>
            <span class="text-brand-blue font-semibold">Perfect Day Trip</span>
          </div>
        </div>

        <!-- 6. Gurez Valley -->
        <div class="bg-white rounded-2xl p-4 border border-brand-border shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">Gurez Valley</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">Mountain Pass</span>
            </div>
            <div class="flex items-baseline space-x-2 my-1">
              <span class="text-2xl font-serif font-bold text-brand-navy">5°C</span>
              <span class="text-xs text-brand-slate font-medium">Crisp Alpine</span>
            </div>
            <p class="text-[11px] text-brand-muted mt-1 leading-snug">Razdan Pass open with verified permits.</p>
          </div>
          <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-brand-slate">
            <span>Alt: 2,400m</span>
            <span class="text-brand-blue font-semibold">Habba Khatoon</span>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================
       SECTION 04: INTRODUCTION
       ======================================================== -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Large Kashmir Photograph -->
        <div class="relative reveal">
          <div class="relative rounded-2xl overflow-hidden shadow-xl">
            <img src="https://images.unsplash.com/photo-1566837945700-30057527ade0?auto=format&fit=crop&w=1000&q=80" 
                 alt="Kashmiri Houseboat and Shikara" 
                 loading="lazy"
                 decoding="async"
                 class="w-full h-[380px] sm:h-[420px] object-cover hover:scale-105 transition-transform duration-700">
          </div>
          <!-- Floating Experience Badge: Serving Since 2016 -->
          <div class="absolute -bottom-5 -right-5 bg-brand-navy text-white p-4 sm:p-5 rounded-2xl shadow-xl hidden sm:flex items-center space-x-4 border border-white/10 max-w-xs animate-float">
            <div class="w-11 h-11 rounded-xl bg-brand-blue flex items-center justify-center text-white shrink-0">
              <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <div>
              <div class="text-xs font-semibold text-brand-sky">Serving Since 2016</div>
              <div class="text-sm font-serif font-bold">Licensed Kashmir Specialist</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Editorial Intro Text & Heritage Statement -->
        <div class="space-y-5 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-softsky px-3 py-1 rounded-full border border-brand-border">
            LOCAL KASHMIR HOST • SERVING SINCE 2016
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl lg:text-[36px] font-bold text-brand-navy leading-tight">
            A Decade of Kashmiri Hospitality & Trust
          </h2>
          <p class="text-sm sm:text-base text-brand-slate leading-relaxed">
            Since 2016, <strong>City Line Tours And Travels</strong> has been dedicated to making every journey meaningful, memorable, and hassle-free. Based in Palpora, Srinagar, we take pride in showcasing the breathtaking landscapes, rich culture, and warm hospitality of Kashmir while helping travelers explore incredible destinations across Jammu, Kashmir, and Ladakh.
          </p>
          <p class="text-sm sm:text-base text-brand-slate leading-relaxed">
            From the peaceful ripples of Dal Lake at dawn to the snow-covered slopes of Apharwat Peak in Gulmarg and the roaring waters of the Lidder River in Pahalgam, our journeys are planned with care, transparent communication, and genuine passion for hospitality.
          </p>

          <!-- Key Highlights Bullet Points -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1.5">
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>Handcrafted Itineraries</span>
            </div>
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>Heritage Houseboat Stays</span>
            </div>
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>Dedicated Private Vehicles</span>
            </div>
            <div class="flex items-center space-x-2 text-sm font-semibold text-brand-navy">
              <i data-lucide="badge-check" class="w-4 h-4 text-brand-blue"></i>
              <span>24/7 Local Support</span>
            </div>
          </div>

          <div class="pt-3 flex items-center space-x-4">
            <a href="/about" class="btn-primary px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center space-x-2">
              <span>Our Story</span>
              <i data-lucide="arrow-right" class="w-4 h-4 arrow-hover"></i>
            </a>
            <a href="/contact" class="btn-outline px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm">
              Contact Us
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================
       SECTION 05: ANIMATED METRICS & TRUST STRIP (CountUp Animation)
       ======================================================== -->
  <section class="py-8 sm:py-10 bg-[#102A43] text-white border-y border-white/10 reveal" id="homepageStats">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        
        <!-- Highlight 1: Serving Since 2016 -->
        <div class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 lg:border-none lg:bg-transparent lg:border-r lg:border-white/15">
          <div class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#EAF3FB] leading-none mb-2" data-count-to="2016">2016</div>
          <div class="font-sans text-xs sm:text-sm font-semibold text-white uppercase tracking-wider">Serving Since 2016</div>
          <p class="font-sans text-[11px] sm:text-xs text-slate-300 mt-1">Local Kashmir Expertise</p>
        </div>

        <!-- Highlight 2: 7 Signature Kashmir Valleys -->
        <div class="flex flex-col items-center text-center p-4 sm:p-5 rounded-2xl bg-white/[0.04] border border-white/10 lg:border-none lg:bg-transparent lg:border-r lg:border-white/15">
