<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-12 sm:py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/Pages/CONTACT US.jpeg" 
           alt="Contact City Line Tours And Travels" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-3.5 py-1.5 rounded-full inline-block mb-3">
        CONNECT WITH US
      </span>
      <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-3 sm:mb-4">
        We Are Here to Help Plan Your Journey
      </h1>
      <p class="text-xs sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Have questions about itineraries, weather, Gondola passes, or custom packages? Reach out to our local team anytime.
      </p>
    </div>
  </section>

  <!-- Direct Contact Channels -->
  <section class="py-12 sm:py-20 bg-brand-offwhite">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1.5 rounded-full inline-block mb-3">
          DIRECT CHANNELS
        </span>
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-brand-navy mb-3">
          Get in Touch Directly
        </h2>
        <p class="text-xs sm:text-base text-brand-muted">
          Connect directly with our local Kashmir travel coordinators via phone, WhatsApp, email, or visit our Srinagar office.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        
        <!-- Card 1: Phone Helplines -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-brand-border shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-brand-light text-brand-blue flex items-center justify-center mb-5">
              <i data-lucide="phone" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-navy mb-1.5">Phone Helplines</h3>
            <p class="text-xs sm:text-sm text-brand-muted mb-6 leading-relaxed">
              Speak directly with our Kashmir coordinators for customized itineraries, pricing quotes, and instant travel support.
            </p>
          </div>
          <div class="space-y-2.5 pt-2 border-t border-brand-border/60">
            <a href="tel:6006725007" class="flex items-center justify-between p-3 rounded-xl bg-brand-offwhite hover:bg-brand-light text-brand-navy hover:text-brand-blue transition font-semibold text-sm group">
              <span class="flex items-center">
                <i data-lucide="phone-call" class="w-4 h-4 mr-2.5 text-brand-blue"></i>
                6006725007
              </span>
              <span class="text-xs text-brand-blue font-medium group-hover:underline">Call Line 1 &rarr;</span>
            </a>
            <a href="tel:9906676890" class="flex items-center justify-between p-3 rounded-xl bg-brand-offwhite hover:bg-brand-light text-brand-navy hover:text-brand-blue transition font-semibold text-sm group">
              <span class="flex items-center">
                <i data-lucide="phone" class="w-4 h-4 mr-2.5 text-brand-navy"></i>
                9906676890
              </span>
              <span class="text-xs text-brand-blue font-medium group-hover:underline">Call Line 2 &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Card 2: WhatsApp Chat -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-brand-border shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5">
              <i data-lucide="message-circle" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-navy mb-1.5">WhatsApp Chat</h3>
            <p class="text-xs sm:text-sm text-brand-muted mb-6 leading-relaxed">
              Instant responses, fast PDF package sharing, real-time weather updates, and seamless booking support.
            </p>
          </div>
          <div class="pt-2 border-t border-brand-border/60">
            <a href="https://wa.me/916006725007" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center space-x-2 py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition shadow-sm min-h-[44px]">
              <i data-lucide="message-circle" class="w-4 h-4"></i>
              <span>Chat on WhatsApp (+91 6006725007)</span>
            </a>
          </div>
        </div>

        <!-- Card 3: Direct Email -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-brand-border shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-brand-light text-brand-blue flex items-center justify-center mb-5">
              <i data-lucide="mail" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-navy mb-1.5">Email Enquiries</h3>
            <p class="text-xs sm:text-sm text-brand-muted mb-6 leading-relaxed">
              Send us your group enquiries, corporate travel requirements, or custom travel plans directly.
            </p>
          </div>
          <div class="pt-2 border-t border-brand-border/60">
            <a href="mailto:askcitylinetravels@gmail.com?subject=Travel%20Enquiry%20-%20City%20Line%20Tours%20And%20Travels&body=Hello%20City%20Line%20Tours%20And%20Travels,%0A%0AI%20would%20like%20to%20plan%20a%20trip%20with%20your%20team.%20Please%20share%20itinerary%20details%20and%20pricing.%0A%0AThank%20you!" 
               class="w-full flex items-center justify-center space-x-2 py-3.5 px-4 rounded-xl bg-brand-blue hover:bg-blue-700 text-white font-semibold text-sm transition shadow-sm min-h-[44px] break-all">
              <i data-lucide="mail" class="w-4 h-4 shrink-0"></i>
              <span>askcitylinetravels@gmail.com</span>
            </a>
          </div>
        </div>

        <!-- Card 4: Head Office -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl sm:rounded-3xl border border-brand-border shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-brand-light text-brand-blue flex items-center justify-center mb-5">
              <i data-lucide="map-pin" class="w-6 h-6"></i>
            </div>
            <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-navy mb-1.5">Head Office</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-3">
              Palpora, Srinagar, Jammu & Kashmir, India
            </p>
            <div class="inline-flex items-center text-xs text-brand-blue font-semibold bg-brand-light/80 px-3 py-1 rounded-full mb-6">
              <i data-lucide="clock" class="w-3.5 h-3.5 mr-1.5"></i>
              Monday – Saturday: 10:00 AM – 5:00 PM
            </div>
          </div>
          <div class="pt-2 border-t border-brand-border/60">
            <a href="https://maps.google.com/?q=Palpora,+Srinagar,+Jammu+and+Kashmir" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center space-x-2 py-3.5 px-4 rounded-xl border-2 border-brand-navy/15 hover:border-brand-blue text-brand-navy hover:text-brand-blue font-semibold text-sm transition min-h-[44px]">
              <i data-lucide="map" class="w-4 h-4"></i>
              <span>Find on Map (Palpora, Srinagar)</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Trust & Assistance Banner -->
      <div class="mt-10 sm:mt-12 bg-white rounded-2xl border border-brand-border p-6 sm:p-8 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center sm:text-left">
          <div class="flex items-start space-x-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
              <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <div>
              <h4 class="font-bold text-sm text-brand-navy">Registered & Verified</h4>
              <p class="text-xs text-brand-muted mt-0.5">Officially registered Kashmir tour operator with local fleet.</p>
            </div>
          </div>
          <div class="flex items-start space-x-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
              <i data-lucide="headphones" class="w-5 h-5"></i>
            </div>
            <div>
              <h4 class="font-bold text-sm text-brand-navy">24/7 On-Trip Support</h4>
              <p class="text-xs text-brand-muted mt-0.5">Dedicated tour coordinator assigned to every guest throughout the trip.</p>
            </div>
          </div>
          <div class="flex items-start space-x-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-brand-blue flex items-center justify-center shrink-0">
              <i data-lucide="sparkles" class="w-5 h-5"></i>
            </div>
            <div>
              <h4 class="font-bold text-sm text-brand-navy">Tailor-Made Plans</h4>
              <p class="text-xs text-brand-muted mt-0.5">Customized itineraries with hotels, houseboats, cabs & passes.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>
