<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-12 sm:py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/Pages/CONTACT US.jpeg" 
           alt="Contact City Line Tours And Travels" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-3.5 py-1.5 rounded-full inline-block mb-3">
        CONNECT WITH US
      </span>
      <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-3 sm:mb-4">
        We Are Here to Help Plan Your Journey
      </h1>
      <p class="text-xs sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Have questions about itineraries, weather, Gondola passes, or custom packages? Reach out to our local team anytime.
      </p>
    </div>
  </section>

  <!-- Contact Information & Form -->
  <section class="py-10 sm:py-16 bg-brand-offwhite">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-12">
        
        <!-- Left 1 Column: Contact Cards -->
        <div class="space-y-4 sm:space-y-6">
          
          <div class="bg-white p-4 sm:p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-3.5 sm:space-x-4">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center shrink-0">
                <i data-lucide="phone" class="w-5 h-5 sm:w-6 sm:h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-base sm:text-lg font-bold text-brand-navy mb-0.5 sm:mb-1">Phone Helplines</h4>
                <p class="text-xs text-brand-muted mb-2">Speak directly with our Kashmir coordinators</p>
                <div class="space-y-1">
                  <a href="tel:6006725007" class="text-sm font-bold text-brand-blue hover:underline flex items-center">
                    <i data-lucide="phone-call" class="w-3.5 h-3.5 mr-1.5 text-brand-blue"></i>
                    6006725007
                  </a>
                  <a href="tel:9906676890" class="text-sm font-bold text-brand-navy hover:underline flex items-center">
                    <i data-lucide="phone" class="w-3.5 h-3.5 mr-1.5 text-brand-navy"></i>
                    9906676890
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white p-4 sm:p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-3.5 sm:space-x-4">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                <i data-lucide="message-circle" class="w-5 h-5 sm:w-6 sm:h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-base sm:text-lg font-bold text-brand-navy mb-0.5 sm:mb-1">WhatsApp Chat</h4>
                <p class="text-xs text-brand-muted mb-2">Instant quotes & itinerary sharing</p>
                <a href="https://wa.me/916006725007" target="_blank" class="text-sm font-bold text-emerald-600 hover:underline flex items-center">
                  <i data-lucide="message-circle" class="w-3.5 h-3.5 mr-1.5"></i>
                  6006725007
                </a>
              </div>
            </div>
          </div>

          <div class="bg-white p-4 sm:p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-3.5 sm:space-x-4">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center shrink-0">
                <i data-lucide="mail" class="w-5 h-5 sm:w-6 sm:h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-base sm:text-lg font-bold text-brand-navy mb-0.5 sm:mb-1">Email Enquiries</h4>
                <p class="text-xs text-brand-muted mb-2">Send us group or custom requests</p>
                <a href="mailto:<%= settings.email %>" class="text-sm font-bold text-brand-blue hover:underline break-all"><%= settings.email %></a>
              </div>
            </div>
          </div>

          <div class="bg-white p-4 sm:p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-3.5 sm:space-x-4">
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center shrink-0">
                <i data-lucide="map-pin" class="w-5 h-5 sm:w-6 sm:h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-base sm:text-lg font-bold text-brand-navy mb-0.5 sm:mb-1">Head Office</h4>
                <p class="text-xs text-brand-muted leading-relaxed">Palpora, Srinagar, Jammu & Kashmir, India</p>
                <p class="text-[11px] text-brand-blue font-semibold mt-2">Monday – Saturday: 10:00 AM – 5:00 PM</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right 2 Columns: Message Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl sm:rounded-3xl border border-brand-border shadow-xl p-4 sm:p-10">
            <div class="border-b border-brand-border pb-4 sm:pb-6 mb-6 sm:mb-8 text-center sm:text-left">
              <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full">
                SEND AN ENQUIRY
              </span>
              <h2 class="font-serif text-xl sm:text-3xl font-bold text-brand-navy mt-2.5 sm:mt-3">
                Send Us a Message
              </h2>
              <p class="text-xs sm:text-sm text-brand-muted mt-1">
                Your enquiry will be sent directly to our team at <strong>askcitylinetravels@gmail.com</strong>.
              </p>
            </div>

            <form id="contactForm" class="space-y-4 sm:space-y-5">
              <input type="hidden" name="source" value="Contact Us Page Form">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-5">
                <div>
                  <label for="contactName" class="block text-xs font-semibold text-brand-navy mb-1.5">Full Name <span class="text-red-500">*</span></label>
                  <input type="text" id="contactName" name="name" required placeholder="Your Full Name" class="form-input min-h-[44px]">
                </div>
                <div>
                  <label for="contactPhone" class="block text-xs font-semibold text-brand-navy mb-1.5">Mobile Number <span class="text-red-500">*</span></label>
                  <input type="tel" id="contactPhone" name="phone" required placeholder="Phone / WhatsApp" class="form-input min-h-[44px]">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-5">
                <div>
                  <label for="contactEmail" class="block text-xs font-semibold text-brand-navy mb-1.5">Email Address</label>
                  <input type="email" id="contactEmail" name="email" placeholder="Your Email Address" class="form-input min-h-[44px]">
                </div>
                <div>
                  <label for="contactDestination" class="block text-xs font-semibold text-brand-navy mb-1.5">Interested Destination / Tour</label>
                  <input type="text" id="contactDestination" name="destination" placeholder="e.g. 6 Days Kashmir Honeymoon" class="form-input min-h-[44px]">
                </div>
              </div>

              <div>
                <label for="contactMessage" class="block text-xs font-semibold text-brand-navy mb-1.5">Your Message / Travel Plans <span class="text-red-500">*</span></label>
                <textarea id="contactMessage" name="message" rows="4" required placeholder="Please describe your planned dates, number of guests, or questions you have..." class="form-input"></textarea>
              </div>

              <div class="pt-1">
                <div class="flex flex-col sm:flex-row items-center gap-3">
                  <button type="submit" id="contactSubmitBtn" class="w-full sm:w-auto btn-primary px-8 py-3.5 rounded-xl font-semibold text-sm flex items-center justify-center space-x-2 shadow-md min-h-[44px]">
                    <i data-lucide="mail" class="w-4 h-4"></i>
                    <span>Send Enquiry via Email</span>
                  </button>
                  <a href="mailto:askcitylinetravels@gmail.com?subject=Travel%20Enquiry%20-%20City%20Line%20Tours%20And%20Travels&body=Hello%20City%20Line%20Tours%20And%20Travels,%0A%0AI%20would%20like%20to%20enquire%20about%20a%20tour%20package.%20Please%20share%20details.%0A%0AThank%20you!" 
                     class="w-full sm:w-auto btn-outline px-6 py-3.5 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 min-h-[44px]"
                     title="Email askcitylinetravels@gmail.com directly">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                    <span>Direct Email</span>
                  </a>
                </div>
                <p class="text-xs text-brand-muted mt-2.5 text-center sm:text-left">
                  🔒 Enquiries are forwarded directly to <strong>askcitylinetravels@gmail.com</strong>.
                </p>
              </div>

            </form>
          </div>
        </div>

      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const contactForm = document.getElementById('contactForm');
      if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();

          const name = document.getElementById('contactName')?.value.trim() || '';
          const phone = document.getElementById('contactPhone')?.value.trim() || '';
          const email = document.getElementById('contactEmail')?.value.trim() || '';
          const destination = document.getElementById('contactDestination')?.value.trim() || '';
          const message = document.getElementById('contactMessage')?.value.trim() || '';

          const subject = encodeURIComponent(
            destination ? `Trip Enquiry: ${destination} - ${name || 'Customer'}` :
            `Travel Enquiry from ${name || 'Website Customer'} - City Line Tours And Travels`
          );

          const bodyLines = [
            'Hello City Line Tours And Travels,',
            '',
            'I would like to enquire about travel planning with City Line Tours And Travels:',
            name ? `• Full Name: ${name}` : '',
            phone ? `• Mobile / WhatsApp: ${phone}` : '',
            email ? `• Email: ${email}` : '',
            destination ? `• Interested Destination / Tour: ${destination}` : '',
            '',
            'Travel Details & Message:',
            message,
            '',
            'Please share itinerary options, availability, and pricing quotation.',
            '',
            'Thank you!'
          ].filter(Boolean).join('\n');

          // Asynchronously record enquiry in the backend
          try {
            fetch('/api/enquiries', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name,
                phone,
                email,
                destination,
                message,
                source: 'Contact Us Page Form'
              })
            }).catch(() => {});
          } catch (err) {}

          // Immediately redirect to user email client
          window.location.href = `mailto:askcitylinetravels@gmail.com?subject=${subject}&body=${encodeURIComponent(bodyLines)}`;
        });
      }
    });
  </script>
</body>
</html>

