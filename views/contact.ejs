<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/Pages/CONTACT US.jpeg" 
           alt="Contact City Line Tours And Travels" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-4 py-1.5 rounded-full inline-block mb-3">
        CONNECT WITH US
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-4">
        We Are Here to Help Plan Your Journey
      </h1>
      <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Have questions about itineraries, weather, Gondola passes, or custom packages? Reach out to our local team anytime.
      </p>
    </div>
  </section>

  <!-- Contact Information & Form -->
  <section class="py-16 bg-brand-offwhite">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left 1 Column: Contact Cards -->
        <div class="space-y-6">
          
          <div class="bg-white p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center shrink-0">
                <i data-lucide="phone" class="w-6 h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-lg font-bold text-brand-navy mb-1">Phone Helplines</h4>
                <p class="text-xs text-brand-muted mb-2">Speak directly with our Kashmir coordinators</p>
                <div class="space-y-1">
                  <a href="tel:6006725007" class="text-sm font-bold text-brand-blue hover:underline flex items-center">
                    <i data-lucide="phone-call" class="w-3.5 h-3.5 mr-1.5 text-brand-blue"></i>
                    6006725007
                  </a>
                  <a href="tel:9906676890" class="text-sm font-bold text-brand-navy hover:underline flex items-center">
                    <i data-lucide="phone" class="w-3.5 h-3.5 mr-1.5 text-brand-navy"></i>
                    9906676890
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                <i data-lucide="message-circle" class="w-6 h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-lg font-bold text-brand-navy mb-1">WhatsApp Chat</h4>
                <p class="text-xs text-brand-muted mb-2">Instant quotes & itinerary sharing</p>
                <a href="https://wa.me/916006725007" target="_blank" class="text-sm font-bold text-emerald-600 hover:underline flex items-center">
                  <i data-lucide="message-circle" class="w-3.5 h-3.5 mr-1.5"></i>
                  6006725007
                </a>
              </div>
            </div>
          </div>

          <div class="bg-white p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center shrink-0">
                <i data-lucide="mail" class="w-6 h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-lg font-bold text-brand-navy mb-1">Email Enquiries</h4>
                <p class="text-xs text-brand-muted mb-2">Send us group or custom requests</p>
                <a href="mailto:<%= settings.email %>" class="text-sm font-bold text-brand-blue hover:underline break-all"><%= settings.email %></a>
              </div>
            </div>
          </div>

          <div class="bg-white p-7 rounded-2xl border border-brand-border shadow-sm">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-xl bg-brand-light text-brand-blue flex items-center justify-center shrink-0">
                <i data-lucide="map-pin" class="w-6 h-6"></i>
              </div>
              <div>
                <h4 class="font-serif text-lg font-bold text-brand-navy mb-1">Head Office</h4>
                <p class="text-xs text-brand-muted leading-relaxed">Palpora, Srinagar, Jammu & Kashmir, India</p>
                <p class="text-[11px] text-brand-blue font-semibold mt-2">Monday – Saturday: 10:00 AM – 5:00 PM</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right 2 Columns: Message Form -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-3xl border border-brand-border shadow-xl p-8 sm:p-10">
            <div class="border-b border-brand-border pb-6 mb-8">
              <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full">
                SEND AN ENQUIRY
              </span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-navy mt-3">
                Send Us a Message
              </h2>
              <p class="text-sm text-brand-muted mt-1">
                Your message will be delivered immediately to our operations team by email.
              </p>
            </div>

            <form id="contactForm" class="ajax-enquiry-form space-y-5">
              <input type="hidden" name="source" value="Contact Us Page Form">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-xs font-semibold text-brand-navy mb-1.5">Full Name <span class="text-red-500">*</span></label>
                  <input type="text" name="name" required placeholder="Your Full Name" class="form-input">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-brand-navy mb-1.5">Mobile Number <span class="text-red-500">*</span></label>
                  <input type="tel" name="phone" required placeholder="Phone / WhatsApp" class="form-input">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-xs font-semibold text-brand-navy mb-1.5">Email Address</label>
                  <input type="email" name="email" placeholder="Your Email Address" class="form-input">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-brand-navy mb-1.5">Interested Destination / Tour</label>
                  <input type="text" name="destination" placeholder="e.g. 6 Days Kashmir Honeymoon" class="form-input">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-brand-navy mb-1.5">Your Message / Travel Plans <span class="text-red-500">*</span></label>
                <textarea name="message" rows="5" required placeholder="Please describe your planned dates, number of guests, or questions you have..." class="form-input"></textarea>
              </div>

              <div>
                <button type="submit" class="btn-primary px-8 py-3.5 rounded-xl font-semibold text-sm flex items-center space-x-2 shadow-md">
                  <i data-lucide="send" class="w-4 h-4"></i>
                  <span>Send My Enquiry</span>
                </button>
                <p class="text-xs text-brand-muted mt-2">
                  🔒 We typically respond within 2-4 hours during business hours.
                </p>
              </div>

            </form>
          </div>
        </div>

      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>

