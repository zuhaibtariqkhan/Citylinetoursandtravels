<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-brand-offwhite text-brand-text min-h-screen">
  <%- include('navbar') %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="font-serif text-3xl font-bold text-brand-navy">Destinations Management</h1>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">Manage Kashmir destinations, attractions, and guides.</p>
      </div>

      <a href="/admin/destinations/new" class="btn-primary px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 shadow-sm">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Add Destination</span>
      </a>
    </div>

    <!-- Destinations Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% destinations.forEach(dest => { %>
        <div class="bg-white rounded-2xl border border-brand-border overflow-hidden shadow-sm flex flex-col justify-between">
          <div>
            <div class="relative h-44">
              <img src="<%= dest.image %>" alt="<%= dest.name %>" class="w-full h-full object-cover">
              <div class="absolute bottom-3 left-3 text-white">
                <h3 class="font-serif text-xl font-bold text-white drop-shadow"><%= dest.name %></h3>
              </div>
            </div>

            <div class="p-5">
              <p class="text-xs italic text-brand-blue font-medium mb-2">"<%= dest.tagline %>"</p>
              <p class="text-xs text-brand-muted line-clamp-2 mb-3"><%= dest.shortDescription %></p>
              <div class="text-[11px] text-brand-navy bg-brand-light p-2 rounded">
                <strong>Best Time:</strong> <%= dest.bestTimeToVisit %>
              </div>
            </div>
          </div>

          <div class="p-4 bg-brand-offwhite border-t border-slate-100 flex items-center justify-between text-xs">
            <a href="/destinations/<%= dest.slug %>" target="_blank" class="text-brand-muted hover:text-brand-navy flex items-center space-x-1">
              <i data-lucide="eye" class="w-3.5 h-3.5"></i>
              <span>Preview</span>
            </a>

            <div class="flex items-center space-x-2">
              <a href="/admin/destinations/<%= dest.id %>/edit" class="btn-outline px-3 py-1 rounded-md font-semibold">
                Edit
              </a>
              <form action="/admin/destinations/<%= dest.id %>/delete" method="POST" onsubmit="return confirm('Delete destination <%= dest.name %>?')">
                <button type="submit" class="text-rose-600 hover:text-rose-800 p-1">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </form>
            </div>
          </div>

        </div>
      <% }) %>
    </div>

  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

