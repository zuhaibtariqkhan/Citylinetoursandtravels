<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-brand-offwhite text-brand-text min-h-screen">
  <%- include('navbar') %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="font-serif text-3xl font-bold text-brand-navy">Customer Tour Enquiries</h1>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">Manage leads, follow-ups, quotations, and communications.</p>
      </div>

      <div class="flex items-center space-x-3">
        <a href="/admin/enquiries/export" class="btn-primary px-4 py-2 rounded-xl text-xs font-semibold flex items-center space-x-1.5 shadow-sm">
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          <span>Export to CSV</span>
        </a>
      </div>
    </div>

    <!-- Search & Status Filter Bar -->
    <div class="bg-white p-5 rounded-2xl border border-brand-border shadow-sm mb-6 flex flex-col md:flex-row items-center justify-between gap-4">
      
      <!-- Status Pills -->
      <div class="flex items-center space-x-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 text-xs font-semibold">
        <a href="/admin/enquiries?status=all" class="px-3 py-1.5 rounded-full transition <%= statusFilter === 'all' ? 'bg-brand-blue text-white' : 'bg-brand-offwhite text-brand-navy hover:bg-brand-light' %>">
          All
        </a>
        <a href="/admin/enquiries?status=new" class="px-3 py-1.5 rounded-full transition <%= statusFilter === 'new' ? 'bg-brand-blue text-white' : 'bg-brand-offwhite text-brand-navy hover:bg-brand-light' %>">
          New
        </a>
        <a href="/admin/enquiries?status=contacted" class="px-3 py-1.5 rounded-full transition <%= statusFilter === 'contacted' ? 'bg-brand-blue text-white' : 'bg-brand-offwhite text-brand-navy hover:bg-brand-light' %>">
          Contacted
        </a>
        <a href="/admin/enquiries?status=quotation sent" class="px-3 py-1.5 rounded-full transition <%= statusFilter === 'quotation sent' ? 'bg-brand-blue text-white' : 'bg-brand-offwhite text-brand-navy hover:bg-brand-light' %>">
          Quote Sent
        </a>
        <a href="/admin/enquiries?status=confirmed" class="px-3 py-1.5 rounded-full transition <%= statusFilter === 'confirmed' ? 'bg-brand-blue text-white' : 'bg-brand-offwhite text-brand-navy hover:bg-brand-light' %>">
          Confirmed
        </a>
      </div>

      <!-- Search Box -->
      <form action="/admin/enquiries" method="GET" class="w-full md:w-72">
        <div class="relative">
          <i data-lucide="search" class="w-4 h-4 text-brand-muted absolute left-3 top-3"></i>
          <input type="text" name="search" value="<%= search %>" placeholder="Search name, phone, ID..." class="form-input pl-9 text-xs py-2 w-full">
        </div>
      </form>

    </div>

    <!-- Enquiries Table -->
    <div class="bg-white rounded-2xl border border-brand-border shadow-sm overflow-hidden">
      <% if (enquiries.length === 0) { %>
        <div class="p-16 text-center text-brand-muted">
          <i data-lucide="search-x" class="w-12 h-12 mx-auto text-slate-300 mb-3"></i>
          <p class="font-semibold text-base">No enquiries found</p>
          <p class="text-xs mt-1">Try adjusting your status filter or search keyword.</p>
        </div>
      <% } else { %>
        <div class="divide-y divide-slate-100">
          <% enquiries.forEach(enq => { %>
            <div class="p-6 hover:bg-slate-50/70 transition">
              <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
                
                <!-- Main Info -->
                <div class="space-y-2 flex-1">
                  <div class="flex items-center space-x-3">
                    <span class="font-mono font-bold text-xs bg-brand-light text-brand-blue px-2.5 py-1 rounded-md">
                      #<%= enq.id %>
                    </span>
                    <span class="text-xs text-brand-muted">
                      <%= new Date(enq.createdAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %> IST
                    </span>
                    <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                      <%= enq.source %>
                    </span>
                  </div>

                  <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-4">
                    <h3 class="font-serif text-lg font-bold text-brand-navy"><%= enq.name %></h3>
                    <div class="flex items-center space-x-3 text-xs">
                      <a href="tel:<%= enq.phone %>" class="font-bold text-brand-blue hover:underline flex items-center">
                        <i data-lucide="phone" class="w-3.5 h-3.5 mr-1"></i>
                        <%= enq.phone %>
                      </a>
                      <% if (enq.email) { %>
                        <a href="mailto:<%= enq.email %>" class="text-slate-600 hover:underline flex items-center">
                          <i data-lucide="mail" class="w-3.5 h-3.5 mr-1"></i>
                          <%= enq.email %>
                        </a>
                      <% } %>
                    </div>
                  </div>

                  <!-- Trip Details Grid -->
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs bg-brand-offwhite p-3 rounded-xl border border-slate-100">
                    <div>
                      <span class="text-brand-muted block text-[10px] uppercase">Package/Destination</span>
                      <strong class="text-brand-navy"><%= enq.packageTitle || enq.destination || 'Custom Tour' %></strong>
                    </div>
                    <div>
                      <span class="text-brand-muted block text-[10px] uppercase">Travel Date</span>
                      <strong class="text-brand-navy"><%= enq.travelDate || 'Flexible' %></strong>
                    </div>
                    <div>
                      <span class="text-brand-muted block text-[10px] uppercase">Travellers</span>
                      <strong class="text-brand-navy"><%= enq.travellers || '1 Person' %></strong>
                    </div>
                    <div>
                      <span class="text-brand-muted block text-[10px] uppercase">Budget / Style</span>
                      <strong class="text-brand-navy"><%= enq.budget || enq.accommodation || 'Standard' %></strong>
                    </div>
                  </div>

                  <!-- Customer Message -->
                  <% if (enq.message) { %>
                    <div class="bg-blue-50/60 text-brand-navy text-xs p-3 rounded-lg border-l-2 border-brand-blue mt-2">
                      <span class="font-semibold block mb-0.5">Message / Special Notes:</span>
                      <%= enq.message %>
                    </div>
                  <% } %>

                  <!-- Internal Notes Log -->
                  <% if (enq.notes && enq.notes.length > 0) { %>
                    <div class="space-y-1 pt-2">
                      <span class="text-[11px] font-bold text-brand-navy uppercase">Follow-up History:</span>
                      <% enq.notes.forEach(note => { %>
                        <div class="text-[11px] text-slate-600 bg-white p-2 rounded border border-slate-200">
                          <span><%= note.text %></span>
                          <span class="text-[9px] text-brand-muted block mt-0.5"><%= new Date(note.date).toLocaleDateString('en-IN') %></span>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>

                </div>

                <!-- Status Update & Controls Box -->
                <div class="bg-brand-offwhite p-4 rounded-xl border border-brand-border w-full lg:w-72 shrink-0 space-y-3">
                  
                  <form action="/admin/enquiries/<%= enq.id %>/status" method="POST" class="space-y-2">
                    <div>
                      <label class="block text-[11px] font-semibold text-brand-navy mb-1 uppercase">Update Status</label>
                      <select name="status" class="form-input text-xs py-1.5 font-semibold">
                        <option value="New" <%= enq.status === 'New' ? 'selected' : '' %>>New</option>
                        <option value="Contacted" <%= enq.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                        <option value="Follow-up Required" <%= enq.status === 'Follow-up Required' ? 'selected' : '' %>>Follow-up Required</option>
                        <option value="Quotation Sent" <%= enq.status === 'Quotation Sent' ? 'selected' : '' %>>Quotation Sent</option>
                        <option value="Confirmed" <%= enq.status === 'Confirmed' ? 'selected' : '' %>>Confirmed Booking</option>
                        <option value="Cancelled" <%= enq.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                        <option value="Closed" <%= enq.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                      </select>
                    </div>

                    <div>
                      <input type="text" name="noteText" placeholder="Add follow-up note..." class="form-input text-xs py-1.5">
                    </div>

                    <button type="submit" class="w-full btn-outline py-1.5 rounded-lg text-xs font-semibold">
                      Save Status & Note
                    </button>
                  </form>

                  <div class="pt-2 border-t border-slate-200 space-y-2 text-xs">
                    <button type="button" 
                            class="open-proposal-modal-btn w-full bg-[#25D366] hover:bg-[#20ba59] text-white py-2 px-3 rounded-lg text-xs font-semibold flex items-center justify-center space-x-1.5 transition shadow-sm"
                            data-id="<%= enq.id %>"
                            data-name="<%= enq.name %>"
                            data-phone="<%= (enq.phone || '').replace(/[^0-9]/g, '') %>"
                            data-package="<%= enq.packageTitle || enq.destination || 'Custom Kashmir Tour' %>"
                            data-date="<%= enq.travelDate || 'Upcoming Dates' %>"
                            data-travellers="<%= enq.travellers || '2 Guests' %>"
                            data-budget="<%= enq.budget || enq.accommodation || 'Standard' %>">
                      <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                      <span>1-Click WhatsApp Proposal</span>
                    </button>

                    <div class="flex items-center justify-between pt-1">
                      <a href="tel:<%= enq.phone %>" class="text-brand-blue font-semibold hover:underline flex items-center">
                        <i data-lucide="phone-call" class="w-3 h-3 mr-1"></i> Call Client
                      </a>

                      <form action="/admin/enquiries/<%= enq.id %>/delete" method="POST" onsubmit="return confirm('Delete this enquiry record permanently?')">
                        <button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-semibold">
                          Delete Record
                        </button>
                      </form>
                    </div>
                  </div>

                </div>

              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- ========================================================
       1-CLICK WHATSAPP PROPOSAL GENERATOR MODAL
       ======================================================== -->
  <div id="proposalModal" class="fixed inset-0 z-50 hidden bg-brand-navy/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full border border-brand-border shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
      
      <!-- Modal Header -->
      <div class="bg-brand-navy text-white px-6 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-full bg-[#25D366] text-white flex items-center justify-center font-bold">
            <i data-lucide="message-circle" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="font-serif text-lg font-bold" id="propModalCustName">Customer Proposal</h3>
            <p class="text-[11px] text-slate-300" id="propModalRef">Ref #ENQ-12345 • WhatsApp Generator</p>
          </div>
        </div>
        <button type="button" id="propModalCloseBtn" class="text-slate-300 hover:text-white p-1 rounded-lg">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-5 flex-1">
        
        <!-- Template Selection Tabs -->
        <div>
          <label class="block text-xs uppercase font-bold text-brand-navy mb-2">Choose Proposal Template</label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" id="propTemplateTabs">
            <button type="button" class="prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border-2 border-brand-blue bg-brand-light text-brand-blue active" data-template="standard">
              🏔️ Comprehensive Tour
            </button>
            <button type="button" class="prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border border-brand-border bg-white text-brand-navy hover:bg-brand-light" data-template="honeymoon">
              💍 Honeymoon Special
            </button>
            <button type="button" class="prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border border-brand-border bg-white text-brand-navy hover:bg-brand-light" data-template="quick">
              ⚡ Quick Follow-up
            </button>
          </div>
        </div>

        <!-- Editable Proposal Textarea -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs uppercase font-bold text-brand-navy">Proposal Message (Fully Editable)</label>
            <span class="text-[11px] text-brand-muted" id="propCharCount">0 characters</span>
          </div>
          <textarea id="propMessageText" rows="11" class="form-input text-xs font-mono leading-relaxed p-3.5 w-full bg-slate-50 border-slate-300 rounded-xl focus:bg-white"></textarea>
        </div>

        <!-- Recipient Phone Confirmation -->
        <div class="bg-brand-offwhite p-3 rounded-xl border border-brand-border flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
          <div>
            <span class="text-brand-muted block text-[10px] uppercase">Destination WhatsApp Number:</span>
            <input type="text" id="propPhoneInput" class="font-bold text-brand-navy bg-transparent border-b border-dashed border-brand-blue outline-none py-0.5" placeholder="e.g. 919876543210">
          </div>
          <span class="text-[11px] text-slate-500">Standard Indian country format</span>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="bg-slate-50 border-t border-brand-border px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <button type="button" id="propCopyBtn" class="w-full sm:w-auto btn-outline text-xs py-2 px-4 rounded-xl font-semibold flex items-center justify-center space-x-1.5">
          <i data-lucide="copy" class="w-3.5 h-3.5"></i>
          <span id="propCopyBtnText">Copy Proposal Text</span>
        </button>

        <div class="flex items-center space-x-2 w-full sm:w-auto">
          <button type="button" id="propModalCancelBtn" class="w-1/3 sm:w-auto px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800">
            Cancel
          </button>
          <button type="button" id="propSendWaBtn" class="w-2/3 sm:w-auto bg-[#25D366] hover:bg-[#20ba59] text-white text-xs font-semibold py-2.5 px-5 rounded-xl flex items-center justify-center space-x-2 transition shadow-sm">
            <i data-lucide="send" class="w-3.5 h-3.5"></i>
            <span>Open in WhatsApp</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <%- include('../partials/scripts') %>

  <!-- WhatsApp Proposal Modal Logic -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('proposalModal');
      const closeBtn = document.getElementById('propModalCloseBtn');
      const cancelBtn = document.getElementById('propModalCancelBtn');
      const copyBtn = document.getElementById('propCopyBtn');
      const copyBtnText = document.getElementById('propCopyBtnText');
      const sendWaBtn = document.getElementById('propSendWaBtn');
      const textarea = document.getElementById('propMessageText');
      const phoneInput = document.getElementById('propPhoneInput');
      const custNameEl = document.getElementById('propModalCustName');
      const refEl = document.getElementById('propModalRef');
      const charCountEl = document.getElementById('propCharCount');
      const tabBtns = document.querySelectorAll('.prop-tab-btn');

      let currentData = {};
      let currentTemplate = 'standard';

      function generateTemplate(tpl, d) {
        const name = d.name || 'Valued Guest';
        const pkg = d.package || 'Custom Kashmir Holiday';
        const dates = d.date || 'Flexible Travel Dates';
        const guests = d.travellers || '2 Guests';
        const refId = d.id || '';

        if (tpl === 'honeymoon') {
          return `Hello ${name} ji! 🌸💍✨\n\nWarm greetings from City Line Tours And Travels, Srinagar, Kashmir!\n\nThank you for reaching out regarding your Romantic Kashmir Honeymoon journey (Ref #${refId}).\n\nPackage: ${pkg}\nPreferred Travel Dates: ${dates}\nGuests: ${guests}\n\nWe have designed a special romantic package for you including:\n• Handpicked Luxury Valley-View Hotels + 1 Night Heritage Dal Lake Houseboat\n• Complimentary Romantic Candlelit Dinner & Cake\n• Special Honeymoon Flower Bed Decoration on Houseboat\n• Sunset Shikara Ride with traditional Kashmiri Kahwa\n• Dedicated private SUV/Sedan for all airport transfers & sightseeing\n• Daily breakfast & dinner included (MAP)\n\nMay I share the complete day-wise itinerary and the best seasonal price for your dates?\n\nWarm regards,\nCity Line Tours And Travels\nPalpora, Srinagar, Jammu & Kashmir\n📞 6006725007 / 9906676890`;
        }

        if (tpl === 'quick') {
          return `Hello ${name} ji! 🏔️✨\n\nThis is City Line Tours And Travels following up on your Kashmir enquiry #${refId} for "${pkg}".\n\nWe have checked hotel and vehicle availability for ${dates} (${guests}). We have exclusive seasonal rates ready for you with:\n✓ Private dedicated vehicle (all transfers & sightseeing included)\n✓ Deluxe stays + Dal Lake Houseboat\n✓ Daily Breakfast & Dinner\n✓ Complimentary Shikara Ride\n\nPlease let us know if you'd like us to send the day-by-day plan or if you have any questions!\n\nBest regards,\nCity Line Tours And Travels\nPalpora, Srinagar, Jammu & Kashmir\n📞 6006725007 / 9906676890`;
        }

        // Standard
        return `Hello ${name} ji! 🏔️✨\n\nWarm greetings from City Line Tours And Travels, Srinagar, Kashmir!\n\nThank you for inquiring about your upcoming journey to Paradise on Earth (Ref #${refId}).\n\n• Package / Destination: ${pkg}\n• Travel Date: ${dates}\n• Travellers: ${guests}\n\nWe would be honored to host you in Kashmir. Here is our recommended package overview:\n✓ Dedicated private vehicle for all airport transfers & valley tours (Gulmarg, Pahalgam, Sonamarg)\n✓ Handpicked cozy hotels + 1 Night Dal Lake Houseboat stay\n✓ Daily freshly prepared Breakfast & Dinner\n✓ Complimentary 1-Hour Sunset Shikara Ride\n✓ All toll taxes, driver allowance, parking & fuel included\n\nWould you like me to share the detailed day-by-day itinerary and official quotation for your dates?\n\nWarm regards,\nCity Line Tours And Travels\nPalpora, Srinagar, Jammu & Kashmir\n📞 6006725007 / 9906676890`;
      }

      function updateText() {
        const text = generateTemplate(currentTemplate, currentData);
        textarea.value = text;
        if (charCountEl) charCountEl.textContent = `${text.length} characters`;
      }

      // Open Modal on Button Click
      document.querySelectorAll('.open-proposal-modal-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentData = {
            id: btn.getAttribute('data-id'),
            name: btn.getAttribute('data-name'),
            phone: btn.getAttribute('data-phone'),
            package: btn.getAttribute('data-package'),
            date: btn.getAttribute('data-date'),
            travellers: btn.getAttribute('data-travellers'),
            budget: btn.getAttribute('data-budget')
          };

          custNameEl.textContent = `Proposal for ${currentData.name}`;
          refEl.textContent = `Ref #${currentData.id} • ${currentData.package}`;
          
          let ph = currentData.phone || '';
          if (ph && !ph.startsWith('91') && ph.length === 10) {
            ph = '91' + ph;
          }
          phoneInput.value = ph;

          currentTemplate = 'standard';
          tabBtns.forEach(t => {
            if (t.getAttribute('data-template') === 'standard') {
              t.className = 'prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border-2 border-brand-blue bg-brand-light text-brand-blue active';
            } else {
              t.className = 'prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border border-brand-border bg-white text-brand-navy hover:bg-brand-light';
            }
          });

          updateText();
          modal.classList.remove('hidden');
          if (window.lucide) window.lucide.createIcons();
        });
      });

      // Template Tabs Switch
      tabBtns.forEach(tab => {
        tab.addEventListener('click', () => {
          tabBtns.forEach(t => {
            t.className = 'prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border border-brand-border bg-white text-brand-navy hover:bg-brand-light';
          });
          tab.className = 'prop-tab-btn py-2 px-3 rounded-xl text-xs font-semibold border-2 border-brand-blue bg-brand-light text-brand-blue active';
          currentTemplate = tab.getAttribute('data-template');
          updateText();
        });
      });

      // Update char count on manual editing
      textarea.addEventListener('input', () => {
        if (charCountEl) charCountEl.textContent = `${textarea.value.length} characters`;
      });

      // Close modal
      function closeModal() {
        modal.classList.add('hidden');
      }
      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      // Copy text to clipboard
      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText(textarea.value).then(() => {
          copyBtnText.textContent = 'Copied to Clipboard! ✓';
          copyBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          setTimeout(() => {
            copyBtnText.textContent = 'Copy Proposal Text';
            copyBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          }, 2500);
        });
      });

      // Open in WhatsApp
      sendWaBtn?.addEventListener('click', () => {
        let ph = phoneInput.value.replace(/[^0-9]/g, '');
        const msg = encodeURIComponent(textarea.value);
        const waUrl = ph ? `https://wa.me/${ph}?text=${msg}` : `https://wa.me/?text=${msg}`;
        window.open(waUrl, '_blank');
      });

    });
  </script>

</body>
</html>

