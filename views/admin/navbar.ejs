<div class="bg-brand-navy text-white border-b border-white/10 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo / Title -->
      <div class="flex items-center space-x-3">
        <a href="/admin" class="flex items-center space-x-2.5">
          <img src="/images/LOGO.jpeg" alt="City Line Admin" class="w-8 h-8 object-contain rounded-lg bg-white p-0.5 shadow-sm">
          <div>
            <span class="font-serif font-bold text-base text-white tracking-wide">City Line Admin</span>
            <span class="hidden sm:inline-block text-[10px] text-brand-sky bg-white/10 px-2 py-0.5 rounded-full ml-2">Operations Portal</span>
          </div>
        </a>
      </div>

      <!-- Admin Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-3 text-xs sm:text-sm font-medium">
        <a href="/admin" class="px-3 py-1.5 rounded-lg transition <%= currentPath === '/admin' ? 'bg-brand-blue text-white font-semibold' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
          Overview
        </a>
        <a href="/admin/enquiries" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/enquiries') ? 'bg-brand-blue text-white font-semibold' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
          Enquiries
        </a>
        <a href="/admin/packages" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/packages') ? 'bg-brand-blue text-white font-semibold' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
          Packages
        </a>
        <a href="/admin/destinations" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/destinations') ? 'bg-brand-blue text-white font-semibold' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
          Destinations
        </a>
        <a href="/admin/emails" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/emails') ? 'bg-brand-blue text-white font-semibold' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
          Email Logs
        </a>
        <a href="/admin/settings" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/settings') ? 'bg-brand-blue text-white font-semibold' : 'text-slate-300 hover:text-white hover:bg-white/5' %>">
          Settings
        </a>
      </nav>

      <!-- Right CTAs -->
      <div class="flex items-center space-x-3">
        <a href="/" target="_blank" class="text-xs text-brand-sky hover:text-white flex items-center space-x-1 bg-white/5 hover:bg-white/10 px-2.5 py-1.5 rounded-lg transition">
          <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">View Site</span>
        </a>
        <a href="/admin/logout" class="text-xs text-rose-300 hover:text-rose-100 flex items-center space-x-1 bg-rose-500/20 hover:bg-rose-500/30 px-2.5 py-1.5 rounded-lg transition">
          <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
          <span>Logout</span>
        </a>
      </div>

    </div>
  </div>
</div>

