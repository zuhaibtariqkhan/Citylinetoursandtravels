<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-brand-offwhite text-brand-text min-h-screen">
  <%- include('navbar') %>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Greeting -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="font-serif text-3xl font-bold text-brand-navy">Operations Dashboard</h1>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">Overview of customer tour enquiries, packages, and communications.</p>
      </div>

      <div class="flex items-center space-x-3">
        <a href="/admin/enquiries/export" class="btn-outline px-4 py-2 rounded-xl text-xs font-semibold flex items-center space-x-1.5 bg-white">
          <i data-lucide="download" class="w-3.5 h-3.5"></i>
          <span>Export CSV</span>
        </a>
        <a href="/admin/packages/new" class="btn-primary px-4 py-2 rounded-xl text-xs font-semibold flex items-center space-x-1.5 shadow-sm">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>Add Package</span>
        </a>
      </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-10">
      
      <!-- Card 1: Total Enquiries -->
      <div class="bg-white p-6 rounded-2xl border border-brand-border shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-brand-muted uppercase">Total Enquiries</span>
          <div class="w-8 h-8 rounded-lg bg-brand-light text-brand-blue flex items-center justify-center">
            <i data-lucide="inbox" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="font-serif text-3xl font-bold text-brand-navy"><%= stats.totalEnquiries %></div>
        <a href="/admin/enquiries" class="text-[11px] text-brand-blue font-semibold hover:underline mt-2 inline-block">View all &rarr;</a>
      </div>

      <!-- Card 2: New Enquiries -->
      <div class="bg-white p-6 rounded-2xl border border-brand-border shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-amber-700 uppercase">New / Pending</span>
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
            <i data-lucide="bell" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="font-serif text-3xl font-bold text-amber-600"><%= stats.newEnquiries %></div>
        <span class="text-[11px] text-brand-muted mt-2 inline-block">Requires contact</span>
      </div>

      <!-- Card 3: Contacted / Confirmed -->
      <div class="bg-white p-6 rounded-2xl border border-brand-border shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-emerald-700 uppercase">Confirmed / Contacted</span>
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <i data-lucide="check-circle" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="font-serif text-3xl font-bold text-emerald-600"><%= stats.contactedEnquiries + stats.confirmedEnquiries %></div>
        <span class="text-[11px] text-brand-muted mt-2 inline-block"><%= stats.confirmedEnquiries %> Confirmed bookings</span>
      </div>

      <!-- Card 4: Packages & Emails -->
      <div class="bg-white p-6 rounded-2xl border border-brand-border shadow-sm">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-brand-muted uppercase">Active Packages</span>
          <div class="w-8 h-8 rounded-lg bg-brand-light text-brand-blue flex items-center justify-center">
            <i data-lucide="luggage" class="w-4 h-4"></i>
          </div>
        </div>
        <div class="font-serif text-3xl font-bold text-brand-navy"><%= stats.publishedPackages %></div>
        <span class="text-[11px] text-brand-muted mt-2 inline-block">Across <%= stats.totalDestinations %> destinations</span>
      </div>

    </div>

    <!-- Recent Enquiries Section -->
    <div class="bg-white rounded-2xl border border-brand-border shadow-sm overflow-hidden mb-10">
      <div class="p-6 border-b border-brand-border flex items-center justify-between">
        <div>
          <h2 class="font-serif text-xl font-bold text-brand-navy">Recent Customer Enquiries</h2>
          <p class="text-xs text-brand-muted mt-0.5">Enquiries submitted via website forms, modal buttons, and the custom planner.</p>
        </div>
        <a href="/admin/enquiries" class="text-xs font-semibold text-brand-blue hover:underline">
          View All (<%= stats.totalEnquiries %>) &rarr;
        </a>
      </div>

      <% if (recentEnquiries.length === 0) { %>
        <div class="p-12 text-center text-brand-muted">
          <i data-lucide="inbox" class="w-10 h-10 mx-auto text-slate-300 mb-3"></i>
          <p class="text-sm font-semibold">No customer enquiries received yet.</p>
          <p class="text-xs mt-1">When website visitors submit an enquiry or fill out the planner, their details and email dispatch records will show up here.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-brand-offwhite text-brand-navy uppercase text-[11px] font-semibold border-b border-brand-border">
              <tr>
                <th class="px-6 py-3.5">ID / Date</th>
                <th class="px-6 py-3.5">Customer</th>
                <th class="px-6 py-3.5">Contact</th>
                <th class="px-6 py-3.5">Package / Destination</th>
                <th class="px-6 py-3.5">Status</th>
                <th class="px-6 py-3.5 text-right">Quick Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% recentEnquiries.forEach(enq => { %>
                <tr class="hover:bg-slate-50/70 transition">
                  <td class="px-6 py-4">
                    <span class="font-mono font-bold text-brand-blue">#<%= enq.id %></span>
                    <span class="block text-[11px] text-brand-muted"><%= new Date(enq.createdAt).toLocaleDateString('en-IN') %></span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="font-semibold text-brand-navy block"><%= enq.name %></span>
                    <span class="text-[11px] text-brand-muted"><%= enq.source %></span>
                  </td>
                  <td class="px-6 py-4">
                    <a href="tel:<%= enq.phone %>" class="font-medium text-brand-blue hover:underline block"><%= enq.phone %></a>
                    <% if (enq.email) { %>
                      <a href="mailto:<%= enq.email %>" class="text-[11px] text-slate-500 hover:underline"><%= enq.email %></a>
                    <% } %>
                  </td>
                  <td class="px-6 py-4">
                    <span class="font-medium text-brand-navy block truncate max-w-xs"><%= enq.packageTitle || enq.destination || 'Custom Kashmir Plan' %></span>
                    <span class="text-[11px] text-brand-muted"><%= enq.travellers %> • <%= enq.travelDate || 'Flexible date' %></span>
                  </td>
                  <td class="px-6 py-4">
                    <form action="/admin/enquiries/<%= enq.id %>/status" method="POST" class="inline">
                      <select name="status" onchange="this.form.submit()" class="text-xs font-semibold px-2.5 py-1 rounded-full border border-slate-200 outline-none
                        <%= enq.status === 'New' ? 'bg-amber-50 text-amber-800' : '' %>
                        <%= enq.status === 'Contacted' ? 'bg-sky-50 text-sky-800' : '' %>
                        <%= enq.status === 'Quotation Sent' ? 'bg-purple-50 text-purple-800' : '' %>
                        <%= enq.status === 'Confirmed' ? 'bg-emerald-50 text-emerald-800' : '' %>
                        <%= enq.status === 'Closed' ? 'bg-slate-100 text-slate-700' : '' %>
                      ">
                        <option value="New" <%= enq.status === 'New' ? 'selected' : '' %>>New</option>
                        <option value="Contacted" <%= enq.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                        <option value="Follow-up Required" <%= enq.status === 'Follow-up Required' ? 'selected' : '' %>>Follow-up</option>
                        <option value="Quotation Sent" <%= enq.status === 'Quotation Sent' ? 'selected' : '' %>>Quote Sent</option>
                        <option value="Confirmed" <%= enq.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                        <option value="Cancelled" <%= enq.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                        <option value="Closed" <%= enq.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                      </select>
                    </form>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end space-x-2">
                      <a href="https://wa.me/<%= (enq.phone || '').replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(enq.name) %>,%20this%20is%20City%20Line%20Tours%20regarding%20your%20Kashmir%20trip%20enquiry%20%23<%= enq.id %>" 
                         target="_blank" 
                         class="p-1.5 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-100" title="WhatsApp Customer">
                        <i data-lucide="message-circle" class="w-4 h-4"></i>
                      </a>
                      <a href="tel:<%= enq.phone %>" class="p-1.5 rounded-lg bg-brand-light text-brand-blue hover:bg-brand-blue hover:text-white" title="Call Customer">
                        <i data-lucide="phone" class="w-4 h-4"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

