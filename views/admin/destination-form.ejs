<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-brand-offwhite text-brand-text min-h-screen">
  <%- include('navbar') %>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="mb-6 flex items-center justify-between">
      <div>
        <a href="/admin/destinations" class="text-xs text-brand-blue font-semibold hover:underline">&larr; Back to Destinations</a>
        <h1 class="font-serif text-3xl font-bold text-brand-navy mt-1">
          <%= destination ? 'Edit Destination: ' + destination.name : 'Add New Destination' %>
        </h1>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-brand-border shadow-sm p-8">
      <form action="<%= destination ? '/admin/destinations/' + destination.id : '/admin/destinations' %>" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Destination Name <span class="text-red-500">*</span></label>
            <input type="text" name="name" required value="<%= destination ? destination.name : '' %>" placeholder="e.g. Sonamarg" class="form-input">
          </div>
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Tagline</label>
            <input type="text" name="tagline" value="<%= destination ? destination.tagline : '' %>" placeholder="e.g. The Meadow of Gold & Glacier Gateway" class="form-input">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Best Time to Visit</label>
            <input type="text" name="bestTimeToVisit" value="<%= destination ? destination.bestTimeToVisit : 'April to October' %>" class="form-input">
          </div>
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Suggested Duration</label>
            <input type="text" name="suggestedDuration" value="<%= destination ? destination.suggestedDuration : '2 Days' %>" class="form-input">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Short Card Description</label>
          <textarea name="shortDescription" rows="2" class="form-input"><%= destination ? destination.shortDescription : '' %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Full Guide Description</label>
          <textarea name="fullDescription" rows="5" class="form-input"><%= destination ? destination.fullDescription : '' %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Hero Image URL</label>
          <input type="url" name="image" value="<%= destination ? destination.image : 'https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=1200&q=80' %>" class="form-input">
        </div>

        <div class="flex items-center space-x-6 pt-2">
          <label class="flex items-center space-x-2 text-xs font-semibold text-brand-navy cursor-pointer">
            <input type="checkbox" name="featured" <%= destination && destination.featured ? 'checked' : '' %> class="rounded text-brand-blue">
            <span>Feature on Homepage</span>
          </label>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
          <a href="/admin/destinations" class="btn-outline px-5 py-2.5 rounded-xl font-semibold text-xs">
            Cancel
          </a>
          <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm">
            <%= destination ? 'Update Destination' : 'Save Destination' %>
          </button>
        </div>

      </form>
    </div>

  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

