<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-brand-offwhite text-brand-text min-h-screen">
  <%- include('navbar') %>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <div class="mb-6 flex items-center justify-between">
      <div>
        <a href="/admin/packages" class="text-xs text-brand-blue font-semibold hover:underline">&larr; Back to Packages</a>
        <h1 class="font-serif text-3xl font-bold text-brand-navy mt-1">
          <%= pkg ? 'Edit Package: ' + pkg.title : 'Create New Tour Package' %>
        </h1>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-brand-border shadow-sm p-8">
      <form action="<%= pkg ? '/admin/packages/' + pkg.id : '/admin/packages' %>" method="POST" class="space-y-6">
        
        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Package Title <span class="text-red-500">*</span></label>
          <input type="text" name="title" required value="<%= pkg ? pkg.title : '' %>" placeholder="e.g. Magnificent Kashmir Grand Tour - 7 Days / 6 Nights" class="form-input">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Category</label>
            <select name="category" class="form-input">
              <option value="Family" <%= pkg && pkg.category === 'Family' ? 'selected' : '' %>>Family</option>
              <option value="Honeymoon" <%= pkg && pkg.category === 'Honeymoon' ? 'selected' : '' %>>Honeymoon</option>
              <option value="Couple" <%= pkg && pkg.category === 'Couple' ? 'selected' : '' %>>Couple</option>
              <option value="Budget" <%= pkg && pkg.category === 'Budget' ? 'selected' : '' %>>Budget</option>
              <option value="Luxury" <%= pkg && pkg.category === 'Luxury' ? 'selected' : '' %>>Luxury</option>
              <option value="Group" <%= pkg && pkg.category === 'Group' ? 'selected' : '' %>>Group / Ski</option>
              <option value="Customised" <%= pkg && pkg.category === 'Customised' ? 'selected' : '' %>>Customised</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Duration</label>
            <input type="text" name="duration" value="<%= pkg ? pkg.duration : '5 Days / 4 Nights' %>" placeholder="e.g. 6 Days / 5 Nights" class="form-input">
          </div>

          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Starting Price (INR)</label>
            <input type="number" name="price" value="<%= pkg && pkg.price ? pkg.price : '' %>" placeholder="e.g. 24999 (Leave blank for On Request)" class="form-input">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Covered Destinations (Comma Separated)</label>
          <input type="text" name="destinationCoverage" value="<%= pkg && pkg.destinationCoverage ? pkg.destinationCoverage.join(', ') : 'Srinagar, Gulmarg, Pahalgam' %>" placeholder="Srinagar, Gulmarg, Pahalgam, Sonamarg" class="form-input">
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Short Card Description</label>
          <textarea name="shortDescription" rows="2" class="form-input" placeholder="Brief 1-2 sentence overview for package cards..."><%= pkg ? pkg.shortDescription : '' %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Full Detailed Description</label>
          <textarea name="fullDescription" rows="5" class="form-input" placeholder="Comprehensive tour introduction..."><%= pkg ? pkg.fullDescription : '' %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-brand-navy mb-1.5">Featured Image URL</label>
          <input type="url" name="featuredImage" value="<%= pkg ? pkg.featuredImage : 'https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=1000&q=80' %>" class="form-input">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Accommodation Notes</label>
            <input type="text" name="accommodation" value="<%= pkg ? pkg.accommodation : '1 Night Houseboat + 3 Nights 4-Star Hotel' %>" class="form-input">
          </div>
          <div>
            <label class="block text-xs font-semibold text-brand-navy mb-1.5">Transportation Notes</label>
            <input type="text" name="transportation" value="<%= pkg ? pkg.transportation : 'Private dedicated Sedan / SUV' %>" class="form-input">
          </div>
        </div>

        <div class="flex items-center space-x-6 pt-2">
          <label class="flex items-center space-x-2 text-xs font-semibold text-brand-navy cursor-pointer">
            <input type="checkbox" name="featured" <%= pkg && pkg.featured ? 'checked' : '' %> class="rounded text-brand-blue">
            <span>Mark as Featured on Homepage</span>
          </label>
          <label class="flex items-center space-x-2 text-xs font-semibold text-brand-navy cursor-pointer">
            <input type="checkbox" name="published" <%= !pkg || pkg.published !== false ? 'checked' : '' %> class="rounded text-brand-blue">
            <span>Published (Visible to Visitors)</span>
          </label>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
          <a href="/admin/packages" class="btn-outline px-5 py-2.5 rounded-xl font-semibold text-xs">
            Cancel
          </a>
          <button type="submit" class="btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm">
            <%= pkg ? 'Update Package' : 'Create Package' %>
          </button>
        </div>

      </form>
    </div>

  </div>

  <%- include('../partials/scripts') %>
</body>
</html>

