<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1566837945700-30057527ade0?auto=format&fit=crop&w=1800&q=80" 
           alt="Kashmir Houseboats" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-4 py-1.5 rounded-full inline-block mb-3">
        COMFORT & HOSPITALITY
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-4">
        Hotels, Resorts & Heritage Houseboats
      </h1>
      <p class="text-base sm:text-lg text-slate-200 max-w-2xl mx-auto leading-relaxed">
        We partner with verified, hygienic, and warm accommodations across Kashmir to ensure every night of your journey is comfortable and restful.
      </p>
    </div>
  </section>

  <!-- Accommodation Categories -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- 1. Heritage Houseboats -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full">
            SIGNATURE STAY
          </span>
          <h2 class="font-serif text-3xl font-bold text-brand-navy mt-4 mb-4">
            Heritage Houseboats on Dal & Nigeen Lake
          </h2>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-4">
            An overnight stay in an intricately hand-carved cedar houseboat is the pinnacle of the Kashmir holiday experience. Adorned with Kashmiri walnut-wood furnishings, hand-knotted carpets, and private verandas facing the placid waters.
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-brand-navy mb-6">
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Handcrafted fragrant Deodar wood interiors</span></li>
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Shikara crossings included to and from the boulevard</span></li>
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Freshly prepared home-cooked Kashmiri & Indian meals</span></li>
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Heating and hot water arrangements</span></li>
          </ul>
          <button class="enquire-now-btn btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm" data-package="Houseboat Stay Experience">
            Book Houseboat Stay
          </button>
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1566837945700-30057527ade0?auto=format&fit=crop&w=1000&q=80" alt="Houseboat on Dal Lake" class="rounded-2xl shadow-xl w-full h-80 sm:h-96 object-cover">
        </div>
      </div>

      <!-- 2. Mountain Resorts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="lg:order-2">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full">
            SCENIC HAVENS
          </span>
          <h2 class="font-serif text-3xl font-bold text-brand-navy mt-4 mb-4">
            Mountain & Riverside Resorts (Gulmarg & Pahalgam)
          </h2>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-4">
            Wake up to panoramic views of snow-clad Apharwat peak in Gulmarg or the soothing melody of the tumbling Lidder River in Pahalgam. Handpicked resorts with central heating, cozy fireplaces, and pine-clad architecture.
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-brand-navy mb-6">
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Spectacular alpine views right from your bedroom window</span></li>
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Winter central heating and electric blankets</span></li>
            <li class="flex items-center space-x-2"><i data-lucide="check" class="w-4 h-4 text-brand-blue"></i><span>Multi-cuisine dining restaurants</span></li>
          </ul>
          <button class="enquire-now-btn btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm" data-package="Mountain Resort Booking">
            Inquire Resort Stays
          </button>
        </div>
        <div class="lg:order-1">
          <img src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=1000&q=80" alt="Gulmarg Resort" class="rounded-2xl shadow-xl w-full h-80 sm:h-96 object-cover">
        </div>
      </div>

      <!-- 3. Deluxe City Hotels -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full">
            CITY CONVENIENCE
          </span>
          <h2 class="font-serif text-3xl font-bold text-brand-navy mt-4 mb-4">
            Deluxe & Boutique Hotels in Srinagar
          </h2>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-4">
            Conveniently situated near Dal Lake, Boulevard Road, and the city center. Featuring 3-star, 4-star, and luxury accommodations equipped with modern amenities, round-the-clock room service, and secure parking.
          </p>
          <button class="enquire-now-btn btn-primary px-6 py-2.5 rounded-xl font-semibold text-xs sm:text-sm" data-package="Srinagar Hotel Accommodation">
            Enquire Hotel Accommodation
          </button>
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1598091383021-15ddea10925d?auto=format&fit=crop&w=1000&q=80" alt="Srinagar Hotel Stay" class="rounded-2xl shadow-xl w-full h-80 sm:h-96 object-cover">
        </div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>
</body>
</html>

