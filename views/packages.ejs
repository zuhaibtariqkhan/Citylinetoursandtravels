<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-white text-brand-text">
  <%- include('partials/header') %>

  <!-- Page Hero -->
  <section class="relative py-12 sm:py-20 bg-brand-navy text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/Pages/TOUR PACKAGES.jpeg" 
           alt="City Line Tours - Kashmir Tour Packages" 
           class="w-full h-full object-cover brightness-[0.4]">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-3.5 py-1.5 rounded-full inline-block mb-3">
        KASHMIR HOLIDAYS
      </span>
      <h1 class="font-serif text-2xl sm:text-4xl md:text-5xl font-bold text-white mb-3 sm:mb-4">
        Tour Packages & Handcrafted Itineraries
      </h1>
      <p class="text-xs sm:text-base text-slate-200 max-w-2xl mx-auto leading-relaxed">
        Discover thoughtfully designed holiday packages covering Srinagar, Gulmarg, Pahalgam, Sonamarg, and offbeat valleys.
      </p>
    </div>
  </section>

  <!-- Filter & Packages Section -->
  <section class="py-10 sm:py-16 bg-brand-offwhite">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Category Filter Pills -->
      <div class="flex items-center justify-center flex-wrap gap-1.5 sm:gap-2 mb-8 sm:mb-12">
        <a href="/packages" class="px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition <%= selectedCategory === 'all' ? 'bg-brand-blue text-white shadow' : 'bg-white text-brand-navy hover:bg-brand-light border border-brand-border' %>">
          All Packages
        </a>
        <a href="/packages?category=Honeymoon" class="px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition <%= selectedCategory.toLowerCase() === 'honeymoon' ? 'bg-brand-blue text-white shadow' : 'bg-white text-brand-navy hover:bg-brand-light border border-brand-border' %>">
          Honeymoon & Couples
        </a>
        <a href="/packages?category=Seasonal" class="px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition <%= selectedCategory.toLowerCase() === 'seasonal' ? 'bg-brand-blue text-white shadow' : 'bg-white text-brand-navy hover:bg-brand-light border border-brand-border' %>">
          Seasonal & Festivals
        </a>
        <a href="/packages?category=Family" class="px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition <%= selectedCategory.toLowerCase() === 'family' ? 'bg-brand-blue text-white shadow' : 'bg-white text-brand-navy hover:bg-brand-light border border-brand-border' %>">
          Family & Winter
        </a>
        <a href="/packages?category=Group" class="px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition <%= selectedCategory.toLowerCase() === 'group' ? 'bg-brand-blue text-white shadow' : 'bg-white text-brand-navy hover:bg-brand-light border border-brand-border' %>">
          Group & Ladakh
        </a>
        <a href="/packages?category=Pilgrimage" class="px-3.5 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold transition <%= selectedCategory.toLowerCase() === 'pilgrimage' ? 'bg-brand-blue text-white shadow' : 'bg-white text-brand-navy hover:bg-brand-light border border-brand-border' %>">
          Amarnath Pilgrimage
        </a>
      </div>

      <!-- ========================================================
           PACKAGE BUDGET CALCULATOR SECTION (Requirement 9A)
           ======================================================== -->
      <div id="calculator" class="mb-10 sm:mb-16 bg-white rounded-2xl sm:rounded-3xl border border-brand-border shadow-xl p-4 sm:p-10 scroll-mt-28">
        <div class="max-w-3xl mb-6 sm:mb-8 text-center sm:text-left">
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-brand-blue bg-brand-light px-3.5 py-1 rounded-full mx-auto sm:mx-0">
            INSTANT ESTIMATE
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-navy mt-3 mb-2 text-center sm:text-left">
            Calculate Your Kashmir Trip Budget
          </h2>
          <p class="text-sm text-brand-muted text-center sm:text-left">
            Choose your package and the number of travellers to get an estimated travel budget.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
          
          <!-- Left 7 Cols: Package & Travellers Selector -->
          <div class="lg:col-span-7 space-y-4 sm:space-y-6">
            
            <!-- Package Selector -->
            <div>
              <label class="block text-xs uppercase font-bold text-brand-navy tracking-wider mb-2">
                1. Select Tour Package
              </label>
              <select id="pkgCalcSelect" class="form-input text-sm py-2.5 font-medium">
                <% packages.forEach((p, idx) => { %>
                  <option value="<%= p.id %>" 
                          data-price="<%= p.price || 0 %>" 
                          data-formatted="<%= p.startingPriceFormatted %>"
                          data-model="<%= p.pricingModel || (p.price ? 'per_person' : 'on_request') %>"
                          data-type="<%= p.pricingType || 'person' %>"
                          data-duration="<%= p.duration %>"
                          data-title="<%= p.title %>"
                          data-slug="<%= p.slug %>"
                          data-min-pax="<%= p.minTravellers || (p.pricingModel === 'himalayan_escape' ? 12 : (p.pricingModel === 'tulip_festival' || p.pricingModel === 'amarnath_yatra' || p.pricingModel === 'autumn_chinar' ? 2 : 1)) %>"
                          data-max-pax="<%= p.maxTravellers || 20 %>"
                          data-base-pax="<%= p.baseOccupancy || (p.pricingModel === 'winter_wonderland' ? 5 : (p.pricingModel === 'himalayan_escape' ? 12 : 2)) %>"
                          <%= idx === 0 ? 'selected' : '' %>>
                    <%= p.title %> (<%= p.duration %>) • <%= p.startingPriceFormatted %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- Travellers Counter (+ / -) -->
            <div>
              <label class="block text-xs uppercase font-bold text-brand-navy tracking-wider mb-2">
                2. Number of Travellers
              </label>
              <div class="bg-brand-offwhite p-4 rounded-2xl border border-brand-border flex items-center justify-between">
                <div>
                  <span class="text-sm font-bold text-brand-navy block" id="calcPaxLabel">Number of People</span>
                  <span class="text-xs text-brand-muted" id="calcPaxNote">Includes private vehicle & hotel accommodation</span>
                </div>
                <div class="flex items-center space-x-3">
                  <button type="button" id="pkgCalcMinus" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                    -
                  </button>
                  <span id="pkgCalcCount" class="font-serif font-bold text-xl text-brand-navy w-8 text-center">
                    2
                  </span>
                  <button type="button" id="pkgCalcPlus" class="w-10 h-10 rounded-xl bg-white border border-brand-border text-brand-navy font-bold hover:bg-slate-100 flex items-center justify-center transition shadow-sm select-none text-base">
                    +
                  </button>
                </div>
              </div>
            </div>

            <!-- Package Details Summary Strip -->
            <div class="grid grid-cols-2 gap-3 text-xs bg-slate-50 p-3.5 rounded-xl border border-slate-200">
              <div>
                <span class="text-brand-muted block text-[10px] uppercase">Selected Package</span>
                <strong class="text-brand-navy line-clamp-1" id="calcSelectedPkgTitle"><%= packages[0] ? packages[0].title : 'KASHMIR HONEYMOON SPECIAL PACKAGE' %></strong>
              </div>
              <div>
                <span class="text-brand-muted block text-[10px] uppercase">Duration</span>
                <strong class="text-brand-navy" id="calcSelectedDuration"><%= packages[0] ? packages[0].duration : '5 Nights / 6 Days' %></strong>
              </div>
            </div>

          </div>

          <!-- Right 5 Cols: Estimated Total & Actions -->
          <div class="lg:col-span-5 bg-brand-navy text-white p-6 sm:p-7 rounded-2xl shadow-lg flex flex-col justify-between space-y-6">
            
            <div class="space-y-4">
              <span class="text-[10px] uppercase font-bold tracking-widest text-brand-sky block">ESTIMATED BUDGET</span>
              
              <!-- Total Budget -->
              <div class="bg-white/10 backdrop-blur rounded-xl p-4 border border-white/10">
                <span class="text-xs text-slate-300 block mb-1">Estimated Total Budget</span>
                <div class="font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight" id="calcTotalDisplay">
                  <%= packages[0] ? packages[0].startingPriceFormatted : '₹40,000' %>
                </div>
                <div class="text-xs text-brand-sky font-semibold mt-1" id="calcPerPersonDisplay">
                  <%= packages[0] && packages[0].pricingModel === 'fixed_couple' ? 'Fixed Couple Price' : '' %>
                </div>
              </div>

              <!-- Breakdown Note -->
              <p class="text-xs text-slate-300 leading-relaxed" id="calcBreakdownNote">
                ✓ Includes hotel/houseboat accommodation, daily breakfast & dinner, dedicated private vehicle, and toll taxes.
              </p>
            </div>

            <!-- Action Buttons -->
            <div class="space-y-2.5 pt-2 border-t border-white/10">
              <button type="button" id="calcEnquireBtn" class="w-full btn-primary py-3 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-md min-h-[44px]">
                <i data-lucide="mail" class="w-4 h-4"></i>
                <span>Enquire via Email</span>
              </button>

              <a id="calcWhatsAppBtn" href="https://wa.me/916006725007" target="_blank" class="w-full bg-[#25D366] hover:bg-[#20ba59] text-white py-3 rounded-xl font-semibold text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow min-h-[44px]">
                <i data-lucide="message-circle" class="w-4 h-4"></i>
                <span>Discuss on WhatsApp (6006725007)</span>
              </a>
            </div>

          </div>

        </div>
      </div>

      <!-- Packages Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
        <% packages.forEach(pkg => { %>
          <div class="bg-white rounded-2xl border border-brand-border overflow-hidden card-hover flex flex-col shadow-sm">
            
            <!-- Image & Duration Badge -->
            <div class="relative h-48 sm:h-60 img-zoom-container">
              <img src="<%= pkg.featuredImage %>" alt="<%= pkg.title %>" loading="lazy" decoding="async" class="w-full h-full object-cover">
              <div class="absolute top-3 left-3 sm:top-4 sm:left-4">
                <span class="bg-white/95 backdrop-blur text-brand-navy text-[11px] sm:text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                  <%= pkg.category %>
                </span>
              </div>
              <div class="absolute bottom-2.5 right-2.5 sm:bottom-3 sm:right-3 bg-brand-navy/90 text-white text-[11px] sm:text-xs px-2.5 py-1 rounded-md flex items-center space-x-1.5 backdrop-blur-sm">
                <i data-lucide="calendar" class="w-3.5 h-3.5 text-brand-sky"></i>
                <span><%= pkg.duration %></span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-4 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-serif text-xl font-bold text-brand-navy mb-2 line-clamp-1 hover:text-brand-blue transition">
                  <a href="/packages/<%= pkg.slug %>"><%= pkg.title %></a>
                </h3>

                <!-- Destination Tags -->
                <div class="flex items-center text-xs text-brand-muted mb-3 space-x-1.5">
                  <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-blue shrink-0"></i>
                  <span class="truncate"><%= (pkg.destinationCoverage || []).join(' • ') %></span>
                </div>

                <p class="text-xs text-brand-muted leading-relaxed line-clamp-2 mb-4">
                  <%= pkg.shortDescription %>
                </p>

                <!-- Information Badges -->
                <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600 bg-brand-offwhite p-3 rounded-xl mb-4">
                  <div class="flex items-center space-x-1.5">
                    <i data-lucide="bed-double" class="w-3.5 h-3.5 text-brand-blue"></i>
                    <span class="truncate"><%= pkg.accommodation ? pkg.accommodation.split('+')[0] : 'Deluxe Stay' %></span>
                  </div>
                  <div class="flex items-center space-x-1.5">
                    <i data-lucide="car" class="w-3.5 h-3.5 text-brand-blue"></i>
                    <span class="truncate">Private Car</span>
                  </div>
                </div>
              </div>

              <!-- Price & CTAs -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span class="text-[10px] text-brand-muted uppercase block font-semibold">
                    <%= (pkg.pricingModel === 'winter_wonderland' || pkg.pricingModel === 'fixed_couple' || pkg.pricingModel === 'himalayan_escape' || pkg.pricingModel === 'tulip_festival' || pkg.pricingModel === 'amarnath_yatra' || pkg.pricingModel === 'autumn_chinar') ? 'Total Package' : 'Starting From' %>
                  </span>
                  <span class="font-serif text-lg font-bold text-brand-blue">
                    <%= pkg.startingPriceFormatted %>
                  </span>
                  <% if (pkg.price && pkg.pricingModel !== 'fixed_couple' && pkg.pricingModel !== 'winter_wonderland' && pkg.pricingModel !== 'himalayan_escape' && pkg.pricingModel !== 'tulip_festival' && pkg.pricingModel !== 'amarnath_yatra' && pkg.pricingModel !== 'autumn_chinar') { %>
                    <span class="text-[10px] text-brand-muted">/ person</span>
                  <% } else if (pkg.pricingModel === 'himalayan_escape') { %>
                    <span class="text-[10px] text-brand-muted">(12 Travellers Base)</span>
                  <% } else if (pkg.pricingModel === 'winter_wonderland') { %>
                    <span class="text-[10px] text-brand-muted">(5 Persons Base)</span>
                  <% } else if (pkg.pricingModel === 'fixed_couple') { %>
                    <span class="text-[10px] text-brand-muted">(Couple)</span>
                  <% } else if (pkg.pricingModel === 'tulip_festival') { %>
                    <span class="text-[10px] text-brand-muted">(2 Travellers Base)</span>
                  <% } else if (pkg.pricingModel === 'amarnath_yatra') { %>
                    <span class="text-[10px] text-brand-muted">(2 Yatris Base)</span>
                  <% } else if (pkg.pricingModel === 'autumn_chinar') { %>
                    <span class="text-[10px] text-brand-muted">(2 Persons Base)</span>
                  <% } %>
                </div>

                <div class="flex items-center space-x-2">
                  <a href="/packages/<%= pkg.slug %>" class="btn-outline px-3.5 py-1.5 rounded-lg text-xs font-semibold">
                    View Details
                  </a>
                  <button class="enquire-now-btn btn-primary px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1" data-package="<%= pkg.title %>">
                    <i data-lucide="mail" class="w-3.5 h-3.5"></i>
                    <span>Enquire</span>
                  </button>
                </div>
              </div>

            </div>

          </div>
        <% }) %>
      </div>

      <!-- Need Customised package card -->
      <div class="mt-10 sm:mt-16 bg-brand-navy rounded-2xl sm:rounded-3xl p-5 sm:p-12 text-white relative overflow-hidden text-center sm:text-left">
        <div class="relative z-10 max-w-2xl">
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-brand-sky bg-white/10 px-3.5 py-1 rounded-full inline-block mb-3">
            NOT FINDING YOUR EXACT ROUTE?
          </span>
          <h3 class="font-serif text-xl sm:text-3xl font-bold mb-2.5 sm:mb-3">
            We Design 100% Custom Kashmir Itineraries
          </h3>
          <p class="text-xs sm:text-sm text-slate-200 mb-5 sm:mb-6 leading-relaxed">
            Tell us how many days you have, the places you wish to visit, your budget, and whether you want romantic privacy or family convenience. We will curate a proposal within hours.
          </p>
          <button class="w-full sm:w-auto enquire-now-btn btn-primary px-6 py-3 rounded-xl font-semibold text-sm inline-flex items-center justify-center space-x-2 min-h-[44px]" data-package="Custom Kashmir Route">
            <i data-lucide="mail" class="w-4 h-4"></i>
            <span>Enquire Custom Itinerary</span>
          </button>
        </div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/whatsapp') %>
  <%- include('partials/enquiry-modal') %>
  <%- include('partials/scripts') %>

  <!-- Packages Listing Budget Calculator Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const select = document.getElementById('pkgCalcSelect');
      const countEl = document.getElementById('pkgCalcCount');
      const minusBtn = document.getElementById('pkgCalcMinus');
      const plusBtn = document.getElementById('pkgCalcPlus');
      const titleEl = document.getElementById('calcSelectedPkgTitle');
      const durEl = document.getElementById('calcSelectedDuration');
      const totalEl = document.getElementById('calcTotalDisplay');
      const perPersonEl = document.getElementById('calcPerPersonDisplay');
      const breakdownEl = document.getElementById('calcBreakdownNote');
      const enquireBtn = document.getElementById('calcEnquireBtn');
      const waBtn = document.getElementById('calcWhatsAppBtn');
      const paxLabel = document.getElementById('calcPaxLabel');
      const paxNote = document.getElementById('calcPaxNote');

      if (!select || !countEl) return;

      let travellers = 2;
      let lastModel = '';

      // Modular Pricing Logic for Winter Wonderland Package
      function calculateWinterWonderlandPrice(persons) {
        if (persons < 5 || persons > 10) {
          return null;
        }
        if (persons === 5) {
          return 59000;
        }
        if (persons === 6) {
          return 70800;
        }
        return 70800 + (persons - 6) * 14800;
      }

      function calculate() {
        const opt = select.options[select.selectedIndex];
        if (!opt) return;

        const price = parseFloat(opt.getAttribute('data-price')) || 0;
        const model = opt.getAttribute('data-model') || 'per_person';
        const type = opt.getAttribute('data-type') || 'person';
        const duration = opt.getAttribute('data-duration') || '';
        const title = opt.getAttribute('data-title') || '';
        const minPax = parseInt(opt.getAttribute('data-min-pax')) || 1;
        const maxPax = parseInt(opt.getAttribute('data-max-pax')) || 20;
        const basePax = parseInt(opt.getAttribute('data-base-pax')) || 2;

        if (titleEl) titleEl.textContent = title;
        if (durEl) durEl.textContent = duration;

        // Reset/clamp travellers when switching pricing models
        if (model !== lastModel) {
          if (model === 'winter_wonderland') {
            travellers = 5;
          } else if (model === 'fixed_couple') {
            travellers = 2;
          } else if (model === 'himalayan_escape') {
            travellers = 12;
          } else if (model === 'tulip_festival' || model === 'amarnath_yatra' || model === 'autumn_chinar') {
            travellers = 2;
          } else if (lastModel === 'winter_wonderland' || lastModel === 'himalayan_escape' || lastModel === 'tulip_festival' || lastModel === 'amarnath_yatra' || lastModel === 'autumn_chinar') {
            travellers = basePax || 2;
          }
          lastModel = model;
        }

        // Clamp travellers to bounds
        if (travellers < minPax) travellers = minPax;
        if (travellers > maxPax) travellers = maxPax;
        countEl.textContent = travellers;

        // Visual button state feedback
        if (minusBtn) {
          const atMin = (travellers <= minPax);
          minusBtn.style.opacity = atMin ? '0.4' : '1';
          minusBtn.style.cursor = atMin ? 'not-allowed' : 'pointer';
        }
        if (plusBtn) {
          const atMax = (travellers >= maxPax);
          plusBtn.style.opacity = atMax ? '0.4' : '1';
          plusBtn.style.cursor = atMax ? 'not-allowed' : 'pointer';
        }

        // 0. Fixed Couple Package Pricing (₹40,000 for 2 Persons)
        if (model === 'fixed_couple') {
          travellers = 2;
          countEl.textContent = '2';
          paxLabel.textContent = 'Occupancy (Fixed Couple Package)';
          paxNote.textContent = 'Fixed package price for 2 Persons (Couple) • Dedicated private vehicle & Deluxe stays';

          if (minusBtn) {
            minusBtn.style.opacity = '0.4';
            minusBtn.style.cursor = 'not-allowed';
          }
          if (plusBtn) {
            plusBtn.style.opacity = '0.4';
            plusBtn.style.cursor = 'not-allowed';
          }

          totalEl.className = 'font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight';
          totalEl.textContent = '₹' + price.toLocaleString('en-IN');
          perPersonEl.textContent = `₹${Math.round(price / 2).toLocaleString('en-IN')} / person equivalent • Total Couple Price: ₹${price.toLocaleString('en-IN')} (Fixed)`;
          breakdownEl.textContent = `✓ Complete fixed package price for 2 persons together. Includes 5 Nights / 6 Days Deluxe hotel & Dal Lake houseboat stays, daily breakfast & dinner, dedicated private vehicle, romantic Shikara ride, airport transfers, toll taxes & driver allowances.`;

          if (waBtn) {
            const msg = `Hello City Line Tours And Travels,\nI am inquiring about the "${title}" (${duration}):\n• Occupancy: 2 Persons (Couple)\n• Total Package Price: ₹${price.toLocaleString('en-IN')} (Fixed)\n• Inclusions: Deluxe Hotels, Dal Lake Houseboat, Shikara Ride, Breakfast & Dinner\n\nPlease share booking availability and confirmation details!`;
            waBtn.href = `https://wa.me/916006725007?text=${encodeURIComponent(msg)}`;
          }
          return;
        }

        // 1. Winter Wonderland Family Package Pricing (5-10 Persons)
        if (model === 'winter_wonderland') {
          paxLabel.textContent = 'Group Occupancy (5 to 10 Persons)';
          paxNote.textContent = 'Family Package includes dedicated Deluxe Toyota Innova & Deluxe Room stays';

          const total = calculateWinterWonderlandPrice(travellers);
          if (total) {
            totalEl.className = 'font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight';
            totalEl.textContent = '₹' + total.toLocaleString('en-IN');
            perPersonEl.textContent = `₹${Math.round(total / travellers).toLocaleString('en-IN')} / person equivalent • Total Group Price: ₹${total.toLocaleString('en-IN')}`;
            breakdownEl.textContent = `✓ Total package price for all ${travellers} persons. Includes 4 Nights / 5 Days Deluxe stays, daily breakfast & dinner, dedicated Deluxe Toyota Innova for all transfers & sightseeing, airport pickup & drop, toll taxes & driver allowances.`;

            if (waBtn) {
              const msg = `Hello City Line Tours And Travels,\nI calculated an estimated package budget on your website:\n• Package: ${title}\n• Duration: ${duration}\n• Number of Persons: ${travellers} Persons\n• Dedicated Vehicle: Deluxe Toyota Innova\n• Total Package Price: ₹${total.toLocaleString('en-IN')}\n\nPlease share the detailed day-wise itinerary and booking availability!`;
              waBtn.href = `https://wa.me/916006725007?text=${encodeURIComponent(msg)}`;
            }
          }
          return;
        }

        // 1B. Himalayan Grand Escape Group Package Pricing (12+ Travellers)
        if (model === 'himalayan_escape') {
          paxLabel.textContent = 'Group Travellers (12+ Persons)';
          paxNote.textContent = 'Starting group size: 12 travellers • Kashmir to Ladakh Overland Expedition';

          if (travellers < 12) travellers = 12;
          countEl.textContent = travellers;

          const additional = travellers - 12;
          const additionalCharges = Math.round(additional * (325000 / 12));
          const total = 325000 + additionalCharges;
          const perPerson = Math.round(total / travellers);

          totalEl.className = 'font-serif text-2xl sm:text-3xl font-bold text-white tracking-tight';
          totalEl.textContent = '₹' + total.toLocaleString('en-IN');
          perPersonEl.textContent = `₹${perPerson.toLocaleString('en-IN')} / person • Starting Price: ₹3,25,000 (12 pax) + ₹${additionalCharges.toLocaleString('en-IN')} additional`;
